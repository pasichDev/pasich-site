---
export interface Props {
  icon: string;
  value: string;
  label: string;
}

const { icon, value, label } = Astro.props;
---

<div class="stat-card">
  <iconify-icon icon={icon} class="text-dim" style="font-size: 1.5rem; margin-bottom: 0.5rem;"></iconify-icon>
  <span class="text-xl font-medium text-accent">{value}</span>
  <span class="text-xs text-dim uppercase tracking-wide">{label}</span>
</div>

<style>
  .stat-card {
    background: var(--color-bg);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.25rem;
    transition: background 0.3s;
  }
  
  .stat-card:hover {
    background: var(--color-surface);
  }
</style>
