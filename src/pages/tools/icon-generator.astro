<script>
  declare global {
    interface CanvasRenderingContext2D {
      roundRect(x: number, y: number, w: number, h: number, r: number): void;
    }
    interface Window {
      JSZip: new () => {
        file(name: string, data: Blob | string): void;
        generateAsync(opts: { type: 'blob' }): Promise<Blob>;
      };
    }
  }

  type PlatformId = 'android' | 'ios' | 'macos' | 'windows' | 'linux' | 'web';
  interface FileEntry { path: string; size: number; }

  // ── Static data (module level) ─────────────────────────────────────────────
  const PLATFORM_FILES: Record<PlatformId, FileEntry[]> = {
    android: [
      { path: 'android/mipmap-mdpi/ic_launcher.png',    size: 48  },
      { path: 'android/mipmap-hdpi/ic_launcher.png',    size: 72  },
