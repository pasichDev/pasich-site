    ],
  };

  const IOS_CONTENTS = JSON.stringify({
    images: [
      { size:'20x20',     idiom:'iphone', filename:'Icon-App-20x20@2x.png',     scale:'2x' },
      { size:'20x20',     idiom:'iphone', filename:'Icon-App-20x20@3x.png',     scale:'3x' },
      { size:'29x29',     idiom:'iphone', filename:'Icon-App-29x29@1x.png',     scale:'1x' },
      { size:'29x29',     idiom:'iphone', filename:'Icon-App-29x29@2x.png',     scale:'2x' },
      { size:'29x29',     idiom:'iphone', filename:'Icon-App-29x29@3x.png',     scale:'3x' },
      { size:'40x40',     idiom:'iphone', filename:'Icon-App-40x40@2x.png',     scale:'2x' },
      { size:'40x40',     idiom:'iphone', filename:'Icon-App-40x40@3x.png',     scale:'3x' },
      { size:'60x60',     idiom:'iphone', filename:'Icon-App-60x60@2x.png',     scale:'2x' },
      { size:'60x60',     idiom:'iphone', filename:'Icon-App-60x60@3x.png',     scale:'3x' },
      { size:'20x20',     idiom:'ipad',   filename:'Icon-App-20x20@1x.png',     scale:'1x' },
      { size:'20x20',     idiom:'ipad',   filename:'Icon-App-20x20@2x.png',     scale:'2x' },
      { size:'29x29',     idiom:'ipad',   filename:'Icon-App-29x29@1x.png',     scale:'1x' },
      { size:'29x29',     idiom:'ipad',   filename:'Icon-App-29x29@2x.png',     scale:'2x' },
      { size:'40x40',     idiom:'ipad',   filename:'Icon-App-40x40@1x.png',     scale:'1x' },
      { size:'40x40',     idiom:'ipad',   filename:'Icon-App-40x40@2x.png',     scale:'2x' },
      { size:'76x76',     idiom:'ipad',   filename:'Icon-App-76x76@1x.png',     scale:'1x' },
      { size:'76x76',     idiom:'ipad',   filename:'Icon-App-76x76@2x.png',     scale:'2x' },
      { size:'83.5x83.5', idiom:'ipad',   filename:'Icon-App-83.5x83.5@2x.png', scale:'2x' },
      { size:'1024x1024', idiom:'ios-marketing', filename:'Icon-App-1024x1024@1x.png', scale:'1x' },
    ],
    info: { version: 1, author: 'pasichdev.xyz/tools/icon-generator' },
  }, null, 2);

  const MACOS_CONTENTS = JSON.stringify({
    images: [
      { size:'16x16',   idiom:'mac', filename:'app_icon_16.png',   scale:'1x' },
      { size:'16x16',   idiom:'mac', filename:'app_icon_32.png',   scale:'2x' },
      { size:'32x32',   idiom:'mac', filename:'app_icon_32.png',   scale:'1x' },
      { size:'32x32',   idiom:'mac', filename:'app_icon_64.png',   scale:'2x' },
      { size:'64x64',   idiom:'mac', filename:'app_icon_64.png',   scale:'1x' },
      { size:'128x128', idiom:'mac', filename:'app_icon_128.png',  scale:'1x' },
      { size:'128x128', idiom:'mac', filename:'app_icon_256.png',  scale:'2x' },
      { size:'256x256', idiom:'mac', filename:'app_icon_256.png',  scale:'1x' },
      { size:'256x256', idiom:'mac', filename:'app_icon_512.png',  scale:'2x' },
      { size:'512x512', idiom:'mac', filename:'app_icon_512.png',  scale:'1x' },
      { size:'512x512', idiom:'mac', filename:'app_icon_1024.png', scale:'2x' },
    ],
    info: { version: 1, author: 'pasichdev.xyz/tools/icon-generator' },
  }, null, 2);

  // ── Mutable state (module level, reset in init) ───────────────────────────
  let sourceImg: HTMLImageElement | null = null;
  let editorCanvas: HTMLCanvasElement;
  let editorCtx: CanvasRenderingContext2D;
  const activePlatforms = new Set<PlatformId>();
  const editorParams = { bgColor: 'transparent', padding: 0, scale: 100, offsetX: 0, offsetY: 0 };

  // ── Rendering (uses module-level state) ───────────────────────────────────
  function renderWithParams(ctx: CanvasRenderingContext2D, w: number) {
    ctx.clearRect(0, 0, w, w);
    if (editorParams.bgColor !== 'transparent') {
      ctx.fillStyle = editorParams.bgColor;
      ctx.fillRect(0, 0, w, w);
    }
    if (!sourceImg) return;
    const eff = w * (editorParams.scale / 100) * (1 - (editorParams.padding * 2) / 100);
    const cx  = w / 2 + (editorParams.offsetX / 100) * w;
    const cy  = w / 2 + (editorParams.offsetY / 100) * w;
    ctx.drawImage(sourceImg, cx - eff / 2, cy - eff / 2, eff, eff);
  }

  function resizeToBlob(size: number): Promise<Blob> {
    return new Promise(resolve => {
      const c = document.createElement('canvas');
      c.width = size; c.height = size;
      renderWithParams(c.getContext('2d')!, size);
      c.toBlob(b => resolve(b!), 'image/png');
    });
  }

  async function buildIcoBlob(): Promise<Blob> {
    const sizes = [16, 32, 48, 256];
    const blobs = await Promise.all(sizes.map(s => resizeToBlob(s)));
    const bufs  = await Promise.all(blobs.map(b => b.arrayBuffer()));
    const count = sizes.length;
    const hdrSize = 6 + 16 * count;
    const total = hdrSize + bufs.reduce((a, b) => a + b.byteLength, 0);
    const ab = new ArrayBuffer(total);
    const dv = new DataView(ab);
    const u8 = new Uint8Array(ab);
    dv.setUint16(0, 0, true); dv.setUint16(2, 1, true); dv.setUint16(4, count, true);
    let imgOff = hdrSize;
    for (let i = 0; i < count; i++) {
      const b = 6 + i * 16; const s = sizes[i] >= 256 ? 0 : sizes[i];
      dv.setUint8(b, s); dv.setUint8(b+1, s); dv.setUint8(b+2, 0); dv.setUint8(b+3, 0);
      dv.setUint16(b+4, 0, true); dv.setUint16(b+6, 32, true);
      dv.setUint32(b+8, bufs[i].byteLength, true); dv.setUint32(b+12, imgOff, true);
      imgOff += bufs[i].byteLength;
    }
    let pos = hdrSize;
    for (const buf of bufs) { u8.set(new Uint8Array(buf), pos); pos += buf.byteLength; }
    return new Blob([ab], { type: 'image/vnd.microsoft.icon' });
  }

  function updateEditorCanvas() { if (editorCtx) renderWithParams(editorCtx, 256); }

  function drawPreviewCanvas(canvas: HTMLCanvasElement) {
    if (!sourceImg) return;
    const radiusPct = parseFloat(canvas.dataset.radius || '0');
    const display   = parseInt(canvas.dataset.display || String(canvas.width));
    canvas.style.width  = display + 'px';
    canvas.style.height = display + 'px';
    const w = canvas.width;
    const ctx = canvas.getContext('2d')!;
    ctx.clearRect(0, 0, w, w);
    ctx.save();
    if (radiusPct > 0) {
      const r = (radiusPct / 100) * w;
      ctx.beginPath();
      ctx.roundRect(0, 0, w, w, r);
      ctx.clip();
    }
    renderWithParams(ctx, w);
    ctx.restore();
  }

  function updateAllPreviews() {
    updateEditorCanvas();
    document.querySelectorAll<HTMLCanvasElement>('.icon-preview').forEach(c => drawPreviewCanvas(c));
  }

  // ── Init (called on every page load / ViewTransition) ─────────────────────
  let abortCtrl: AbortController | null = null;

  function init() {
    const canvas = document.getElementById('editor-canvas') as HTMLCanvasElement | null;
    if (!canvas) return; // not on this page

    // Clean up previous listeners (ViewTransitions re-runs init on nav back)
    abortCtrl?.abort();
    abortCtrl = new AbortController();
    const sig = abortCtrl.signal;

    // Bind canvas refs
    editorCanvas = canvas;
    editorCtx = canvas.getContext('2d')!;

    // Reset state
    sourceImg = null;
    Object.assign(editorParams, { bgColor: 'transparent', padding: 0, scale: 100, offsetX: 0, offsetY: 0 });
    activePlatforms.clear();
    (['android','ios','macos','windows','linux','web'] as PlatformId[]).forEach(p => activePlatforms.add(p));

    // ── Drag to reposition ──────────────────────────────────────────────────
    let dragging = false;
    let dragStartClient = { x: 0, y: 0 };
    let dragStartOffset = { x: 0, y: 0 };

    function startDrag(cx: number, cy: number) {
      dragging = true;
      dragStartClient = { x: cx, y: cy };
      dragStartOffset = { x: editorParams.offsetX, y: editorParams.offsetY };
      editorCanvas.style.cursor = 'grabbing';
    }
    function moveDrag(cx: number, cy: number) {
      if (!dragging) return;
      const rect = editorCanvas.getBoundingClientRect();
      const dx = ((cx - dragStartClient.x) / rect.width)  * 100;
      const dy = ((cy - dragStartClient.y) / rect.height) * 100;
      editorParams.offsetX = Math.max(-30, Math.min(30, dragStartOffset.x + dx));
      editorParams.offsetY = Math.max(-30, Math.min(30, dragStartOffset.y + dy));
      (document.getElementById('ctrl-offsetx') as HTMLInputElement).value = String(editorParams.offsetX);
      (document.getElementById('ctrl-offsety') as HTMLInputElement).value = String(editorParams.offsetY);
      document.getElementById('offsetx-val')!.textContent = Math.round(editorParams.offsetX) + '%';
      document.getElementById('offsety-val')!.textContent = Math.round(editorParams.offsetY) + '%';
      updateAllPreviews();
    }
    function stopDrag() { dragging = false; editorCanvas.style.cursor = 'grab'; }

    editorCanvas.addEventListener('mousedown', e => { e.preventDefault(); startDrag(e.clientX, e.clientY); }, { signal: sig });
    window.addEventListener('mousemove', e => moveDrag(e.clientX, e.clientY), { signal: sig });
    window.addEventListener('mouseup', stopDrag, { signal: sig });
    editorCanvas.addEventListener('touchstart', e => { e.preventDefault(); startDrag(e.touches[0].clientX, e.touches[0].clientY); }, { passive: false, signal: sig } as any);
    window.addEventListener('touchmove', e => { if (dragging) { e.preventDefault(); moveDrag(e.touches[0].clientX, e.touches[0].clientY); } }, { passive: false, signal: sig } as any);
    window.addEventListener('touchend', stopDrag, { signal: sig });

    editorCanvas.addEventListener('wheel', e => {
      e.preventDefault();
      editorParams.scale = Math.max(40, Math.min(100, editorParams.scale - e.deltaY * 0.05));
      (document.getElementById('ctrl-scale') as HTMLInputElement).value = String(editorParams.scale);
      document.getElementById('scale-val')!.textContent = Math.round(editorParams.scale) + '%';
      updateAllPreviews();
    }, { passive: false, signal: sig } as any);

    // ── Sliders ─────────────────────────────────────────────────────────────
    function bindSlider(id: string, key: keyof typeof editorParams, valId: string, fmt: (v: number) => string) {
      const el = document.getElementById(id) as HTMLInputElement;
      if (!el) return;
      el.addEventListener('input', () => {
        (editorParams as any)[key] = parseFloat(el.value);
        document.getElementById(valId)!.textContent = fmt(parseFloat(el.value));
        updateAllPreviews();
      }, { signal: sig });
    }
    bindSlider('ctrl-padding', 'padding', 'padding-val', v => Math.round(v) + '%');
    bindSlider('ctrl-scale',   'scale',   'scale-val',   v => Math.round(v) + '%');
    bindSlider('ctrl-offsetx', 'offsetX', 'offsetx-val', v => Math.round(v) + '%');
    bindSlider('ctrl-offsety', 'offsetY', 'offsety-val', v => Math.round(v) + '%');

    // ── Background ──────────────────────────────────────────────────────────
    const allBgOpts  = document.querySelectorAll<HTMLElement>('.bg-opt');
    const colorInput = document.getElementById('bg-color-input') as HTMLInputElement;
    const customSwatch = document.getElementById('bg-custom-swatch')!;
    const customBtn    = document.getElementById('bg-custom-btn')!;

    allBgOpts.forEach(btn => {
      if (btn.id === 'bg-custom-btn') return;
      btn.addEventListener('click', () => {
        allBgOpts.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        editorParams.bgColor = (btn as HTMLButtonElement).dataset.bg!;
        updateAllPreviews();
      }, { signal: sig });
    });

    customBtn.addEventListener('click', () => { colorInput.click(); }, { signal: sig });
    colorInput.addEventListener('input', () => {
      customSwatch.style.background = colorInput.value;
      allBgOpts.forEach(b => b.classList.remove('active'));
      customBtn.classList.add('active');
      editorParams.bgColor = colorInput.value;
      updateAllPreviews();
    }, { signal: sig });

    // ── Reset editor ────────────────────────────────────────────────────────
    document.getElementById('btn-reset-params')!.addEventListener('click', () => {
      Object.assign(editorParams, { bgColor: 'transparent', padding: 0, scale: 100, offsetX: 0, offsetY: 0 });
      (document.getElementById('ctrl-padding') as HTMLInputElement).value = '0';
      (document.getElementById('ctrl-scale')   as HTMLInputElement).value = '100';
      (document.getElementById('ctrl-offsetx') as HTMLInputElement).value = '0';
      (document.getElementById('ctrl-offsety') as HTMLInputElement).value = '0';
      document.getElementById('padding-val')!.textContent = '0%';
      document.getElementById('scale-val')!.textContent   = '100%';
      document.getElementById('offsetx-val')!.textContent = '0%';
      document.getElementById('offsety-val')!.textContent = '0%';
      allBgOpts.forEach(b => b.classList.remove('active'));
      document.querySelector<HTMLElement>('.bg-opt[data-bg="transparent"]')!.classList.add('active');
      updateAllPreviews();
    }, { signal: sig });

    // ── File handling ────────────────────────────────────────────────────────
    function handleFile(file: File) {
      const reader = new FileReader();
      reader.onload = e => {
        const img = new Image();
        img.onload = () => {
          sourceImg = img;
          (document.getElementById('preview-img') as HTMLImageElement).src = e.target!.result as string;
          document.getElementById('preview-name')!.textContent = file.name;
          document.getElementById('preview-dims')!.textContent = `${img.width} × ${img.height} px`;
          (document.getElementById('drop-zone') as HTMLElement).style.display = 'none';
          (document.getElementById('preview-section') as HTMLElement).style.display = 'block';
          requestAnimationFrame(updateAllPreviews);
        };
        img.src = e.target!.result as string;
      };
      reader.readAsDataURL(file);
    }

    const dropZone  = document.getElementById('drop-zone')!;
    const fileInput = document.getElementById('file-input') as HTMLInputElement;
    dropZone.addEventListener('dragover',  e => { e.preventDefault(); dropZone.classList.add('drag-over'); }, { signal: sig });
    dropZone.addEventListener('dragleave', () => dropZone.classList.remove('drag-over'), { signal: sig });
    dropZone.addEventListener('drop', e => {
      e.preventDefault(); dropZone.classList.remove('drag-over');
      const f = e.dataTransfer?.files[0]; if (f) handleFile(f);
    }, { signal: sig });
    dropZone.addEventListener('click', () => fileInput.click(), { signal: sig });
    fileInput.addEventListener('change', () => { if (fileInput.files?.[0]) handleFile(fileInput.files[0]); }, { signal: sig });

    document.getElementById('btn-reset')!.addEventListener('click', () => {
      sourceImg = null;
      (document.getElementById('drop-zone') as HTMLElement).style.display = 'flex';
      (document.getElementById('preview-section') as HTMLElement).style.display = 'none';
      fileInput.value = '';
    }, { signal: sig });

    // ── Platform toggles ─────────────────────────────────────────────────────
    document.querySelectorAll<HTMLButtonElement>('.ptoggle').forEach(btn => {
      btn.addEventListener('click', () => {
        const p = btn.dataset.platform as PlatformId;
        if (activePlatforms.has(p)) {
          if (activePlatforms.size === 1) return;
          activePlatforms.delete(p);
          btn.classList.remove('active');
        } else {
          activePlatforms.add(p);
          btn.classList.add('active');
        }
        document.querySelectorAll<HTMLElement>('.platform-card').forEach(card => {
          const cp = card.dataset.platform as PlatformId;
          card.style.opacity       = activePlatforms.has(cp) ? '1' : '0.3';
          card.style.pointerEvents = activePlatforms.has(cp) ? '' : 'none';
        });
      }, { signal: sig });
    });

    // ── Generate ZIP ─────────────────────────────────────────────────────────
    document.getElementById('btn-generate')!.addEventListener('click', async () => {
      if (!sourceImg) return;
      const status = document.getElementById('gen-status')!;
      const btn    = document.getElementById('btn-generate')!;
      btn.setAttribute('disabled', '');
      status.textContent = 'Generating…';

      await new Promise<void>(resolve => {
        if (window.JSZip) { resolve(); return; }
        const s = document.createElement('script');
        s.src = 'https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js';
        s.onload = () => resolve();
        document.head.appendChild(s);
      });

      const zip = new window.JSZip();
      for (const pid of activePlatforms) {
        if (pid === 'windows') {
          status.textContent = 'Building ICO…';
          zip.file('windows/runner/resources/app_icon.ico', await buildIcoBlob());
        } else {
          for (const { path, size } of PLATFORM_FILES[pid]) {
            zip.file(path, await resizeToBlob(size));
          }
          if (pid === 'ios')   zip.file('ios/AppIcon.appiconset/Contents.json',   IOS_CONTENTS);
          if (pid === 'macos') zip.file('macos/AppIcon.appiconset/Contents.json', MACOS_CONTENTS);
        }
      }

      status.textContent = 'Compressing…';
      const content = await zip.generateAsync({ type: 'blob' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(content);
      a.download = 'flutter-icons.zip';
      a.click();
      URL.revokeObjectURL(a.href);

      btn.removeAttribute('disabled');
      status.textContent = '✓ Downloaded!';
      setTimeout(() => { status.textContent = ''; }, 3000);
    }, { signal: sig });
  }

  document.addEventListener('astro:page-load', init);
</script>

