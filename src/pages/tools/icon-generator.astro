---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';

const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Flutter Icon Generator — All Platforms",
  "url": "https://pasichdev.xyz/tools/icon-generator",
  "description": "Upload one PNG, edit background & layout, download icons for Android, iOS, macOS, Windows, Linux and Web. Flutter-ready ZIP. Free, client-side.",
  "applicationCategory": "DeveloperApplication",
  "operatingSystem": "Any",
  "featureList": "Android mipmap icons, iOS AppIcon, macOS AppIcon, Windows ICO, Linux XDG icons, Web favicon, Background editor, Padding control, Logo overlay, ZIP download",
  "offers": { "@type": "Offer", "price": "0" }
};
---

<BaseLayout
  title="Flutter Icon Generator — Android, iOS, macOS, Windows, Linux, Web | pasichDev"
  description="Free Flutter icon generator: upload one PNG, get icons for Android, iOS, macOS, Windows, Linux and Web in a ZIP. Edit background, padding, logo. Runs in browser, nothing uploaded."
  canonical="https://pasichdev.xyz/tools/icon-generator"
  structuredData={structuredData}
>
  <div class="container animate-fade-in" style="max-width:800px">

    <header style="margin-top:3rem;margin-bottom:2rem">
      <a href="/tools" class="back-link">← Tools</a>
      <h1 style="font-size:clamp(1.25rem,3vw,1.75rem);letter-spacing:-0.02em;margin-bottom:.5rem">Flutter Icon Generator</h1>
      <p class="text-dim text-sm">Upload one PNG — edit background & layout, download icons for all platforms as ZIP.</p>
    </header>

    <!-- Drop zone -->
    <div id="drop-zone" class="drop-zone">
      <Icon name="solar:upload-linear" width="32" height="32" style="color:var(--color-txt-dim);margin-bottom:1rem" />
      <p class="text-dim text-sm">Drop PNG here or <label for="file-input" class="file-label">browse</label></p>
      <p class="text-xs text-dim" style="margin-top:.5rem;opacity:.5">1024×1024 px recommended</p>
      <input type="file" id="file-input" accept="image/png,image/jpeg,image/webp" style="display:none" />
    </div>

    <!-- Main section -->
    <div id="preview-section" style="display:none;margin-bottom:4rem">

      <!-- Source info -->
      <div class="source-header">
        <div class="source-thumb-wrap">
          <img id="preview-img" src="" alt="Preview" class="source-thumb" />
        </div>
        <div class="source-meta">
          <p id="preview-name" class="text-sm font-medium" style="color:var(--color-accent)"></p>
          <p id="preview-dims" class="text-xs text-dim" style="margin-top:.2rem"></p>
          <button id="btn-reset" class="btn btn-outline" style="font-size:.75rem;padding:.35rem .75rem;margin-top:.75rem">Change image</button>
        </div>
      </div>

      <!-- Editor panel -->
      <div class="section-label">Icon Editor</div>
      <div class="editor-panel">

        <div class="editor-left">
          <canvas id="editor-canvas" width="256" height="256" class="editor-canvas"></canvas>
          <p class="editor-hint">Drag to reposition · scroll to scale</p>
        </div>

        <div class="editor-right">

          <div class="ctrl-group">
            <div class="ctrl-label">Background</div>
            <div class="bg-options">
              <button class="bg-opt active" data-bg="transparent">
                <i class="bg-checker-icon"></i>None
              </button>
              <button class="bg-opt" data-bg="#FFFFFF">
                <i class="bg-swatch" style="background:#fff"></i>White
              </button>
              <button class="bg-opt" data-bg="#000000">
                <i class="bg-swatch" style="background:#111;border-color:#444"></i>Black
