      { path: 'ios/AppIcon.appiconset/Icon-App-29x29@2x.png',     size: 58   },
      { path: 'ios/AppIcon.appiconset/Icon-App-29x29@3x.png',     size: 87   },
      { path: 'ios/AppIcon.appiconset/Icon-App-40x40@1x.png',     size: 40   },
      { path: 'ios/AppIcon.appiconset/Icon-App-40x40@2x.png',     size: 80   },
      { path: 'ios/AppIcon.appiconset/Icon-App-40x40@3x.png',     size: 120  },
      { path: 'ios/AppIcon.appiconset/Icon-App-60x60@2x.png',     size: 120  },
      { path: 'ios/AppIcon.appiconset/Icon-App-60x60@3x.png',     size: 180  },
      { path: 'ios/AppIcon.appiconset/Icon-App-76x76@1x.png',     size: 76   },
      { path: 'ios/AppIcon.appiconset/Icon-App-76x76@2x.png',     size: 152  },
      { path: 'ios/AppIcon.appiconset/Icon-App-83.5x83.5@2x.png', size: 167  },
      { path: 'ios/AppIcon.appiconset/Icon-App-1024x1024@1x.png', size: 1024 },
    ],
    macos: [
      { path: 'macos/AppIcon.appiconset/app_icon_16.png',   size: 16   },
      { path: 'macos/AppIcon.appiconset/app_icon_32.png',   size: 32   },
      { path: 'macos/AppIcon.appiconset/app_icon_64.png',   size: 64   },
      { path: 'macos/AppIcon.appiconset/app_icon_128.png',  size: 128  },
      { path: 'macos/AppIcon.appiconset/app_icon_256.png',  size: 256  },
      { path: 'macos/AppIcon.appiconset/app_icon_512.png',  size: 512  },
      { path: 'macos/AppIcon.appiconset/app_icon_1024.png', size: 1024 },
    ],
    windows: [], // ICO built separately
    linux: [
      { path: 'linux/data/icons/hicolor/16x16/apps/app_icon.png',   size: 16  },
      { path: 'linux/data/icons/hicolor/32x32/apps/app_icon.png',   size: 32  },
      { path: 'linux/data/icons/hicolor/48x48/apps/app_icon.png',   size: 48  },
      { path: 'linux/data/icons/hicolor/64x64/apps/app_icon.png',   size: 64  },
      { path: 'linux/data/icons/hicolor/128x128/apps/app_icon.png', size: 128 },
      { path: 'linux/data/icons/hicolor/256x256/apps/app_icon.png', size: 256 },
    ],
    web: [
