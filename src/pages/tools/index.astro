---
import BaseLayout from '../../layouts/BaseLayout.astro';

const devTools = [
  {
    title: 'Privacy Policy Generator',
    description: 'Generate a Privacy Policy for your mobile app in minutes. Ready for Google Play and App Store.',
    href: '/tools/privacy-policy',
    badge: 'Mobile devs',
  },
  {
    title: 'Flutter Icon Generator',
    description: 'Upload one PNG, edit background & layout, download icons for all Flutter platforms as ZIP.',
    href: '/tools/icon-generator',
    badge: 'Flutter',
  },
];

const nicheTools = [
  {
    title: 'QR Code Generator',
    description: 'Create custom QR codes with your colors, dot style, and logo. Download as PNG or SVG.',
    href: '/tools/qr-generator',
    badge: 'Everyone',
  },
];

// Rows are numbered straight through both groups: 01, 02, 03…
let counter = 0;
const number = (list: typeof devTools) => list.map((t) => ({ ...t, n: String(++counter).padStart(2, '0') }));
const groups = [
  { label: 'Developer tools', note: 'For people shipping apps', tools: number(devTools) },
  { label: 'Niche tools', note: 'For everyone', tools: number(nicheTools) },
];

const structuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Developer Tools by pasichDev",
  "description": "Free online tools by pasichDev: Privacy Policy Generator, Flutter Icon Generator, QR Code Generator. No tracking, no sign-up.",
  "url": "https://pasichdev.xyz/tools",
  "author": { "@type": "Person", "name": "Andrii Pasichnyk" }
};
---

<BaseLayout
  title="Developer Tools — Free Online Tools | pasichDev"
  description="Free tools by pasichDev: Privacy Policy Generator, Flutter Icon Generator, QR Code Generator. No tracking, no sign-up, runs in your browser."
  canonical="https://pasichdev.xyz/tools"
  structuredData={structuredData}
  bleed
>
  <header class="page-hero">
    <nav class="page-hero__crumbs mono up" aria-label="Breadcrumb"><a href="/">pasichdev</a><span>tools</span></nav>
    <h1 class="wide" data-scramble>Tools</h1>
    <p class="page-hero__lede">Small things built with care. No tracking, no sign-up, no ads — everything runs in your browser.</p>
    <div class="page-hero__meta mono up"><span>{devTools.length + nicheTools.length} tools</span><span>Free, forever</span></div>
  </header>

  {groups.map((g, gi) => (
    <section class="group" aria-labelledby={`group-${gi}`}>
      <div class="group__head shell">
        <h2 id={`group-${gi}`} class="wide">{g.label}</h2>
        <span class="mono up dim">{g.note}</span>
      </div>
      {g.tools.map((t) => (
        <a class="row reveal" href={t.href}>
          <span class="row__n mono amber">{t.n}</span>
          <h3 class="row__title">{t.title}</h3>
          <p class="row__desc">{t.description}</p>
          <span class="row__meta mono up"><span class="row__badge">{t.badge}</span><span class="row__url">{t.href}</span></span>
          <span class="row__go" aria-hidden="true">→</span>
        </a>
      ))}
    </section>
  ))}
</BaseLayout>

<style>
  .group { padding-top: clamp(70px, 9vw, 130px); }
  .group__head { display: flex; align-items: end; justify-content: space-between; gap: 20px; margin-bottom: 26px; }
  .group__head h2 { font-size: clamp(26px, 3vw, 44px); font-weight: 800; }

  .row {
    position: relative; isolation: isolate; overflow: hidden;
    display: grid; grid-template-columns: 60px minmax(0, 1.1fr) minmax(0, 1.2fr) auto 50px; align-items: center; gap: 24px;
    padding: 34px var(--pad); border-top: 1px solid var(--color-border);
  }
  .group .row:last-child { border-bottom: 1px solid var(--color-border); }
  .row::before { content: ''; position: absolute; inset: 0; z-index: -1; background: var(--color-accent); transform: scaleY(0); transform-origin: bottom; transition: transform .55s var(--ease); }
  .row:hover { color: var(--color-accent-ink); }
  .row:hover::before { transform: none; transform-origin: top; }
  .row__title { font-size: clamp(26px, 3vw, 46px); font-weight: 700; line-height: 1; font-stretch: 115%; font-variation-settings: 'wdth' 115; transition: transform .5s var(--ease); }
  .row:hover .row__title { transform: translateX(10px); }
  .row__desc { max-width: 44ch; transition: color .3s; }
  .row__meta { display: grid; gap: 8px; justify-items: end; color: var(--color-txt-dim); transition: color .3s; }
  .row__badge { padding: 5px 10px; border: 1px solid currentColor; border-radius: 99px; white-space: nowrap; }
  .row__go { justify-self: end; font-size: 30px; transition: transform .5s var(--ease); }
  .row:hover .row__n, .row:hover .row__desc, .row:hover .row__meta { color: rgba(18,15,10,.72); }
  .row:hover .row__go { transform: rotate(-45deg); }

  @media (max-width: 960px) {
    .row { grid-template-columns: 40px 1fr 40px; gap: 10px 16px; }
    .row__title { grid-column: 2; }
    .row__desc { grid-column: 2; }
    .row__meta { grid-column: 2; justify-items: start; grid-auto-flow: column; justify-content: start; align-items: center; }
    .row__go { grid-column: 3; grid-row: 1; }
    .row__url { display: none; }
  }
</style>
