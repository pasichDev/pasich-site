---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolCard from '../../components/ui/ToolCard.astro';

const devTools = [
  {
    icon: 'solar:shield-check-linear',
    title: 'Privacy Policy Generator',
    description: 'Generate a Privacy Policy for your mobile app in minutes. Ready for Google Play and App Store.',
    href: '/tools/privacy-policy',
    badge: 'Mobile devs',
  },
  {
    icon: 'solar:smartphone-linear',
    title: 'Flutter Icon Generator',
    description: 'Upload one PNG, edit background & layout, download icons for all Flutter platforms as ZIP.',
    href: '/tools/icon-generator',
    badge: 'Flutter',
  },
];

const nicheTools = [
  {
    icon: 'solar:qr-code-linear',
    title: 'QR Code Generator',
    description: 'Create custom QR codes with your colors, dot style, and logo. Download as PNG or SVG.',
    href: '/tools/qr-generator',
    badge: 'Everyone',
  },
];

const structuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Developer Tools by pasichDev",
  "description": "Free online tools by pasichDev: Privacy Policy Generator, Flutter Icon Generator, QR Code Generator. No tracking, no sign-up.",
  "url": "https://pasichdev.xyz/tools",
  "author": { "@type": "Person", "name": "Andrii Pasichnyk" }
};
---

<BaseLayout
  title="Developer Tools — Free Online Tools | pasichDev"
  description="Free tools by pasichDev: Privacy Policy Generator, Flutter Icon Generator, QR Code Generator. No tracking, no sign-up, runs in your browser."
  canonical="https://pasichdev.xyz/tools"
  structuredData={structuredData}
>
  <div class="container animate-fade-in">
    <header class="page-header">
      <p class="breadcrumb">
        <a href="/">pasichDev</a>
        <span> / tools</span>
      </p>
      <h1 class="page-title">Tools</h1>
      <p class="page-desc">Free tools built with care. No tracking, no sign-up, no ads.</p>
    </header>

    <section class="tools-section">
      <div class="section-label">Developer Tools</div>
      <div class="tools-grid">
        {devTools.map((tool) => (
          <ToolCard {...tool} />
        ))}
      </div>
    </section>

    <section class="tools-section">
      <div class="section-label">Niche Tools</div>
      <div class="tools-grid">
        {nicheTools.map((tool) => (
          <ToolCard {...tool} />
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .page-header {
    margin-top: 3rem;
    margin-bottom: 3rem;
  }

  .breadcrumb {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-txt-dim);
    margin-bottom: 1.25rem;
  }
  .breadcrumb a {
    color: var(--color-txt-dim);
    text-decoration: none;
    transition: color 0.15s;
  }
  .breadcrumb a:hover { color: var(--color-accent); }

  .page-title {
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    margin-bottom: 0.625rem;
  }

  .page-desc {
    font-size: 0.875rem;
    color: var(--color-txt-dim);
    max-width: 28rem;
  }

  .tools-section {
    margin-bottom: 3rem;
  }

  .section-label {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-txt-dim);
    margin-bottom: 1rem;
    padding-bottom: 0.625rem;
    border-bottom: 1px solid var(--color-border);
  }

  .tools-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 1rem;
  }
  @media (min-width: 640px) {
    .tools-grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>
