---
import BaseLayout from '../layouts/BaseLayout.astro';

const experience = [
  {
    title: 'Software Engineer',
    period: '02/2026 - Present',
    company: 'InTallyCon',
    achievements: [
      'The open-source Flutter plugin for <strong>WireGuard</strong> we started from was abandoned in 2024 and ran on each platform\'s stock backend. Those backends drop the tunnel whenever peers change, which ruled out direct P2P connections. I forked it and turned it into our own plugin for Android, iOS, macOS and Windows.',
      'Wrote one data plane on top of <strong>wireguard-go</strong> that owns the tunnel and the UDP socket itself, and reused it on every platform (gomobile, cgo). Peers now change without a reconnect, and a fix lands on all platforms at once.',
      'On top of it built a <strong>P2P core in Go</strong>, so devices can connect to each other directly instead of going through a relay.',
      'Added split DNS and LAN bypass. Before that, turning on a full tunnel cut users off from their own router and NAS.',
      'On Windows the old plugin needed admin rights to start the tunnel. I replaced that with a <strong>C++</strong> SYSTEM service on WireGuard-NT: one install, after that the app talks to it over a named pipe, and the private key never leaves the service.',
      'Besides the VPN, I built several Flutter apps and Go backend services, take part in architecture decisions and review code on the Flutter and Go projects.',
      'Also work on embedded Linux built with <strong>Yocto</strong> (BitBake recipes, layers, cross-compilation, systemd).'
    ],
    tags: ['Flutter', 'Dart', 'Go', 'C++', 'Swift', 'Kotlin', 'WireGuard', 'Windows Services', 'Yocto', 'Embedded Linux']
  },
  {
    title: 'Open Source: Linux Kernel / WireGuard',
    period: '2026',
    company: 'github.com/pasichDev/rtl8196e-wireguard',
    achievements: [
      'Got WireGuard on a cheap single-core router chip (Realtek RTL8196E, 400 MHz) running twice as fast: TCP went from 9.4 to 18.8 Mbit/s, and ping through a busy tunnel dropped from 108 to 31 ms.',
      'The cipher wasn\'t the bottleneck. Profiling showed a context switch on almost every packet, because WireGuard hands packets to worker queues built for multi-core machines. My patch skips those queues when there is only one CPU.',
      'Found a memory leak in WireGuard that had been in the kernel since 2019, and sent the fix to the netdev mailing list.'
    ],
    tags: ['Linux Kernel', 'C', 'WireGuard', 'Networking', 'Profiling']
  },
  {
    title: 'Flutter Developer',
    period: '2023 - 2024',
    company: 'NosoCoin (freelance, open source)',
    achievements: [
      'Wrote <strong>SovaWallet</strong>, a Flutter crypto wallet for phones and desktop.',
      'The coin\'s reference code was in Pascal, so I ported its hashing, signatures and network protocol to Dart.',
      'Where Dart was too slow, called C++ libraries through FFI.',
      'The wallet picks a node on its own, switches when one goes down and syncs in the background.'
    ],
    tags: ['Flutter', 'Dart', 'Dart FFI', 'C++']
  },
  {
    title: 'Android Developer',
    period: '2021 - Present',
    company: 'Own apps (side projects)',
    achievements: [
      '<strong>My Notes</strong> has 10k+ downloads. Its block-based editor is my own, written without third-party editor libraries.',
      '<strong>Encly</strong> is on Google Play and F-Droid: encrypted notes and tasks with no account, no cloud and no internet permission at all.',
      'Both are built with Clean Architecture, MVVM, Hilt and Room, with database migrations between versions.',
      'In other projects used the Google Maps API for tracking, geocoding and routes.'
    ],
    tags: ['Kotlin', 'Jetpack Compose', 'Room', 'Hilt']
  },
  {
    title: 'Web Developer',
    period: '2015 - 2020',
    company: 'Freelance',
    achievements: [
      'Built REST APIs, admin panels and small SaaS tools in PHP, JavaScript and SQL.'
    ],
    tags: []
  }
];

const structuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Andrii Pasichnyk",
  "alternateName": "pasichDev",
  "jobTitle": "Software Engineer",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Rivne",
    "addressCountry": "Ukraine"
  },
  "email": "apasichnik9@gmail.com",
  "telephone": "+380961814800",
  "url": "https://pasichdev.xyz/cv",
  "sameAs": ["https://github.com/pasichDev"]
};
---

<BaseLayout 
  title="CV — Andrii Pasichnyk"
  description="Resume of Andrii Pasichnyk, Software Engineer. Flutter, Go and C++: a cross-platform WireGuard VPN, Go backends, Yocto-based embedded Linux, Linux kernel patches."
  canonical="https://pasichdev.xyz/cv"
  structuredData={structuredData}
  bleed
>
  <header class="page-hero cv-hero">
    <nav class="page-hero__crumbs mono up no-print" aria-label="Breadcrumbs"><a href="/">Index</a><span>CV</span></nav>
    <div class="cv-hero__grid">
      <div class="cv-id">
        <!-- Cryptographic fingerprint — regenerated on every print -->
        <div class="fp-tile" title="Document fingerprint">
          <svg class="fp-glyph" id="fp-glyph" viewBox="0 0 40 40" aria-hidden="true"></svg>
        </div>
        <div>
          <h1 class="cv-name wide" aria-label="Andrii Pasichnyk"><span data-scramble aria-hidden="true">Andrii</span><span class="outline" data-scramble aria-hidden="true">Pasichnyk</span></h1>
          <p class="cv-role">Software Engineer</p>
          <p class="cv-loc mono up"><span>Rivne, Ukraine</span><span class="amber">UTC+2</span></p>
          <div class="fp-meta mono">
            <span class="fp-label up">Fingerprint</span>
            <span class="fp-hash" id="fp-hash">—</span>
            <span class="fp-date" id="fp-date"></span>
          </div>
        </div>
      </div>
      <div class="contact-info mono">
        <button id="cv-print" class="btn btn-primary no-print" type="button">Download PDF ↓</button>
        <a href="mailto:apasichnik9@gmail.com">apasichnik9@gmail.com</a>
        <a href="https://www.linkedin.com/in/pasichdev">linkedin.com/in/pasichdev</a>
      </div>
    </div>
  </header>

  <section class="cv-sec cv-profile">
    <h2 class="cv-label mono up">Profile</h2>
    <p class="cv-profile__text reveal">
      I'm a software engineer at InTallyCon, where I work on our
      <strong>WireGuard VPN</strong>: the Flutter plugin and apps on top, Go and C++ underneath,
      on Android, iOS, macOS and Windows. I also write
      <strong>Go backends</strong> and work on
      <strong>Yocto-based embedded Linux</strong>.
      Outside work I dig into the Linux kernel (my WireGuard patch doubled throughput on a single-core router)
      and keep a couple of Android apps going.
    </p>
  </section>

  <section class="cv-sec">
    <h2 class="cv-label mono up">Experience</h2>
    <div class="jobs">
      {experience.map((job) => (
        <article class="job reveal">
          <div class="job__when mono up">{job.period}</div>
          <div class="job__body">
            <h3 class="job__title">{job.title}</h3>
            <div class="job__company mono">{job.company}</div>
            <ul class="job__list">
              {job.achievements.map((item) => (
                <li set:html={item} />
              ))}
            </ul>
            {job.tags.length > 0 && (
              <div class="job__tags">
                {job.tags.map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="cv-sec">
    <h2 class="cv-label mono up">Technical Skills</h2>
    <div class="skills-grid">
      <div class="reveal">
        <h4>Programming Languages</h4>
        <p>Go, Dart, C++, C, Kotlin, Swift, Java, SQL.</p>
      </div>
      <div class="reveal">
        <h4>Networking & VPN</h4>
        <p>WireGuard (wireguard-go, WireGuard-NT, Linux kernel), TCP/IP, UDP, DNS, NAT, iptables, P2P, REST, WebSocket, gRPC, Protocol Buffers.</p>
      </div>
      <div class="reveal">
        <h4>Mobile & Desktop</h4>
        <p>Flutter (platform plugins, Dart FFI, Bloc, Riverpod), Android (VpnService, Jetpack Compose, Room, Hilt, WorkManager), iOS/macOS (Network Extension, Keychain), Windows (Win32, services, named pipes, DPAPI, CNG).</p>
      </div>
      <div class="reveal">
        <h4>Embedded Linux</h4>
        <p>Yocto Project, OpenEmbedded, BitBake, cross-compilation, systemd, Linux kernel patches, kernel profiling.</p>
      </div>
      <div class="reveal">
        <h4>Backend & Data</h4>
        <p>Go services (REST, encryption at rest, SQLite without cgo), PostgreSQL, SQLite, Firebase.</p>
      </div>
      <div class="reveal">
        <h4>Practices</h4>
        <p>Software architecture, Clean Architecture, MVVM, code review, Git, GitLab CI, GitHub Actions, unit testing.</p>
      </div>
    </div>
  </section>

  <section class="cv-sec cv-langs">
    <h2 class="cv-label mono up">Languages</h2>
    <div class="langs">
      <div><span class="mono up">Ukrainian</span><b>Native</b></div>
      <div><span class="mono up">English</span><b>A1 (Beginner)</b></div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ── Hero ─────────────────────────────────────── */
  .cv-hero__grid { display: grid; grid-template-columns: 1fr auto; gap: 40px; align-items: end; }
  .cv-id { display: flex; align-items: flex-start; gap: clamp(16px, 2.4vw, 34px); min-width: 0; }
  .cv-name { display: grid; font-size: clamp(40px, 8.4vw, 140px); font-weight: 800; line-height: .84; letter-spacing: -.02em; }
  .cv-role { margin-top: 22px; color: var(--color-txt-main); font-size: clamp(18px, 1.6vw, 24px); font-weight: 500; }
  .cv-loc { display: flex; flex-wrap: wrap; gap: 6px 20px; margin-top: 10px; color: var(--color-txt-dim); }
  .fp-tile { flex-shrink: 0; width: clamp(64px, 7vw, 96px); height: clamp(64px, 7vw, 96px); margin-top: .4em; padding: 14px; border: 1px solid var(--color-border-strong); border-radius: 10px; background: var(--color-surface); color: var(--color-accent); }
  .fp-glyph { display: block; width: 100%; height: 100%; fill: currentColor; }
  .fp-meta { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 12px; margin-top: 14px; color: var(--color-txt-dim); min-width: 0; }
  .fp-label { font-size: 11px; }
  .fp-hash { color: var(--color-accent); word-break: break-all; }
  .fp-date { font-size: 11px; opacity: .7; }
  .contact-info { display: grid; justify-items: end; gap: 10px; color: var(--color-txt-dim); }
  .contact-info .btn { margin-bottom: 8px; }
  .contact-info a:hover { color: var(--color-accent); }

  /* ── Sections ─────────────────────────────────── */
  .cv-sec { display: grid; grid-template-columns: minmax(140px, 220px) 1fr; gap: clamp(20px, 4vw, 70px); padding: clamp(60px, 8vw, 120px) var(--pad); border-bottom: 1px solid var(--color-border); }
  .cv-label { position: sticky; top: calc(var(--nav-height) + 20px); align-self: start; color: var(--color-accent); font-size: 12px; font-weight: 500; }
  .cv-profile__text { max-width: 30ch; color: var(--color-txt-main); font-size: clamp(26px, 3.2vw, 50px); font-weight: 500; line-height: 1.12; letter-spacing: -.01em; font-stretch: 108%; font-variation-settings: 'wdth' 108; }
  .cv-profile__text strong { color: var(--color-accent); font-weight: 600; }

  .jobs { display: grid; }
  .job { display: grid; grid-template-columns: 170px 1fr; gap: 24px; padding: 34px 0; border-top: 1px dashed var(--color-border); }
  .job:first-child { padding-top: 0; border-top: 0; }
  .job__when { color: var(--color-accent); padding-top: .55em; }
  .job__title { font-size: clamp(24px, 2.6vw, 40px); font-weight: 700; line-height: 1.05; font-stretch: 112%; font-variation-settings: 'wdth' 112; }
  .job__company { margin-top: 8px; color: var(--color-txt-dim); }
  .job__list { margin-top: 20px; padding-left: 1.1em; display: grid; gap: 10px; max-width: 70ch; }
  .job__list li { color: #c9c5bc; font-size: 16px; line-height: 1.6; }
  .job__list li::marker { content: '→  '; color: var(--color-accent); font-family: var(--font-mono); font-size: 13px; }
  .job__list :global(strong) { color: var(--color-txt-main); font-weight: 600; }
  .job__tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 22px; }

  .skills-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 40px 40px; }
  .skills-grid h4 { padding-bottom: 10px; margin-bottom: 12px; border-bottom: 1px solid var(--color-border); color: var(--color-txt-main); font-size: 19px; font-weight: 600; }
  .skills-grid p { font-size: 15.5px; line-height: 1.65; }

  .langs { display: flex; flex-wrap: wrap; gap: 30px 70px; }
  .langs span { display: block; color: var(--color-txt-dim); }
  .langs b { display: block; margin-top: 6px; font-size: clamp(26px, 2.8vw, 40px); font-weight: 700; font-stretch: 115%; font-variation-settings: 'wdth' 115; }

  @media (max-width: 860px) {
    .cv-hero__grid { grid-template-columns: 1fr; }
    .contact-info { justify-items: start; }
    .cv-sec { grid-template-columns: 1fr; }
    .cv-label { position: static; }
    .job { grid-template-columns: 1fr; gap: 8px; }
    .job__when { padding-top: 0; }
    .skills-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 520px) {
    .cv-id { flex-direction: column; }
    /* «PASICHNYK» at width 125 ≈ 0.95em per letter: 10vw fits the phone width */
    .cv-name { font-size: 10.2vw; }
    .fp-tile { width: 54px; height: 54px; margin-top: 0; padding: 9px; }
  }

  /* ── Print: force readable black-on-white ──────── */
  @media print {
    :global(*), :global(*::before), :global(*::after) {
      box-shadow: none !important;
      filter: none !important;
      -webkit-filter: none !important;
      text-shadow: none !important;
      mask-image: none !important;
      -webkit-mask-image: none !important;
      animation: none !important;
      transition: none !important;
    }
    :global(html), :global(body) { background: #fff !important; }
    /* Slightly denser type on paper so the CV fits three pages. */
    :global(html) { font-size: 14.5px; }
    :global(body) { font-size: 14.5px; }
    :global(#claude-agent-glow-border),
    :global(#claude-phantom-cursor) { display: none !important; }
    :global(main) { padding: 0 !important; min-height: 0 !important; }

    /* every bit of text dark on white — kills white-on-white */
    :global(main), :global(main *) {
      color: #1a1a1a !important;
      background: transparent !important;
      -webkit-text-fill-color: #1a1a1a !important;
    }
    .outline { -webkit-text-stroke: 0 !important; }
    .job__company, .contact-info, .fp-label, .fp-date, .cv-loc, .skills-grid p, .langs span { color: #555 !important; -webkit-text-fill-color: #555 !important; }
    a { text-decoration: none !important; }

    .page-hero { padding: 0 0 1rem !important; border-bottom: 1px solid #ccc !important; }
    .cv-hero__grid { grid-template-columns: 1fr auto; align-items: end; gap: 1rem; }
    .cv-name { display: block; font-size: 30px !important; line-height: 1.05; font-stretch: 100%; font-variation-settings: 'wdth' 100; }
    .cv-name span + span::before { content: ' '; }
    .cv-role { margin-top: .4rem; font-size: 16px; }
    .contact-info { justify-items: end; text-align: right; }
    .fp-tile { width: 60px; height: 60px; padding: 10px; border: 1px solid #ccc !important; }
    .fp-glyph { fill: #111 !important; }

    .cv-sec { display: block; padding: 1.1rem 0 !important; border-bottom: 0 !important; }
    .cv-label { position: static; margin-bottom: .7rem; color: #555 !important; -webkit-text-fill-color: #555 !important; }
    .cv-profile__text { max-width: none; font-size: 15px; font-weight: 400; line-height: 1.55; font-stretch: 100%; font-variation-settings: 'wdth' 100; }
    .job { grid-template-columns: 150px 1fr; gap: 1rem; padding: .9rem 0; border-top: 1px solid #ddd !important; }
    .job:first-child { border-top: 0 !important; }
    .job__when { padding-top: .25em; font-size: 10.5px; white-space: nowrap; }
    .job__title { font-size: 17px; font-stretch: 100%; font-variation-settings: 'wdth' 100; }
    .job__list { margin-top: .5rem; gap: .3rem; }
    .job__list li { font-size: 13.5px; }
    .job__list li::marker { color: #999 !important; }
    .job__tags { margin-top: .6rem; }
    .tag { color: #111 !important; background: #fff !important; border: 1px solid #bbb !important; }
    .skills-grid { grid-template-columns: repeat(2, 1fr); gap: 1.1rem 2rem; }
    .skills-grid h4 { font-size: 14px; border-bottom: 1px solid #ddd !important; }
    .skills-grid p { font-size: 13px; }
    .langs b { font-size: 16px; font-stretch: 100%; font-variation-settings: 'wdth' 100; }

    /* Keep single entries whole, but let long sections flow across pages. */
    .page-hero, .skills-grid > div, .job__list li { break-inside: avoid; }
    h2, h4, .job__title, .job__company { break-after: avoid; }
    @page { margin: 15mm 12mm; }
  }
</style>

<script>
  // Compact synchronous SHA-256 (so it also works inside beforeprint).
  function sha256Bytes(ascii) {
    const rrot = (x, n) => (x >>> n) | (x << (32 - n));
    const K = [
      0x428a2f98,0x71374491,0xb5c0fbcf,0xe9b5dba5,0x3956c25b,0x59f111f1,0x923f82a4,0xab1c5ed5,
      0xd807aa98,0x12835b01,0x243185be,0x550c7dc3,0x72be5d74,0x80deb1fe,0x9bdc06a7,0xc19bf174,
      0xe49b69c1,0xefbe4786,0x0fc19dc6,0x240ca1cc,0x2de92c6f,0x4a7484aa,0x5cb0a9dc,0x76f988da,
      0x983e5152,0xa831c66d,0xb00327c8,0xbf597fc7,0xc6e00bf3,0xd5a79147,0x06ca6351,0x14292967,
      0x27b70a85,0x2e1b2138,0x4d2c6dfc,0x53380d13,0x650a7354,0x766a0abb,0x81c2c92e,0x92722c85,
      0xa2bfe8a1,0xa81a664b,0xc24b8b70,0xc76c51a3,0xd192e819,0xd6990624,0xf40e3585,0x106aa070,
      0x19a4c116,0x1e376c08,0x2748774c,0x34b0bcb5,0x391c0cb3,0x4ed8aa4a,0x5b9cca4f,0x682e6ff3,
      0x748f82ee,0x78a5636f,0x84c87814,0x8cc70208,0x90befffa,0xa4506ceb,0xbef9a3f7,0xc67178f2
    ];
    let H = [0x6a09e667,0xbb67ae85,0x3c6ef372,0xa54ff53a,0x510e527f,0x9b05688c,0x1f83d9ab,0x5be0cd19];
    const bytes = [];
    for (let i = 0; i < ascii.length; i++) {
      let c = ascii.charCodeAt(i);
      if (c < 128) bytes.push(c);
      else if (c < 2048) bytes.push(192 | (c >> 6), 128 | (c & 63));
      else bytes.push(224 | (c >> 12), 128 | ((c >> 6) & 63), 128 | (c & 63));
    }
    const bitLen = bytes.length * 8;
    bytes.push(0x80);
    while (bytes.length % 64 !== 56) bytes.push(0);
    for (let i = 7; i >= 0; i--) bytes.push(Math.floor(bitLen / Math.pow(2, i * 8)) & 0xff);
    const w = new Uint32Array(64);
    for (let off = 0; off < bytes.length; off += 64) {
      for (let i = 0; i < 16; i++)
        w[i] = (bytes[off+i*4] << 24) | (bytes[off+i*4+1] << 16) | (bytes[off+i*4+2] << 8) | bytes[off+i*4+3];
      for (let i = 16; i < 64; i++) {
        const s0 = rrot(w[i-15],7) ^ rrot(w[i-15],18) ^ (w[i-15] >>> 3);
        const s1 = rrot(w[i-2],17) ^ rrot(w[i-2],19) ^ (w[i-2] >>> 10);
        w[i] = (w[i-16] + s0 + w[i-7] + s1) | 0;
      }
      let [a,b,c,d,e,f,g,h] = H;
      for (let i = 0; i < 64; i++) {
        const S1 = rrot(e,6) ^ rrot(e,11) ^ rrot(e,25);
        const ch = (e & f) ^ (~e & g);
        const t1 = (h + S1 + ch + K[i] + w[i]) | 0;
        const S0 = rrot(a,2) ^ rrot(a,13) ^ rrot(a,22);
        const maj = (a & b) ^ (a & c) ^ (b & c);
        const t2 = (S0 + maj) | 0;
        h = g; g = f; f = e; e = (d + t1) | 0; d = c; c = b; b = a; a = (t1 + t2) | 0;
      }
      H = [(H[0]+a)|0,(H[1]+b)|0,(H[2]+c)|0,(H[3]+d)|0,(H[4]+e)|0,(H[5]+f)|0,(H[6]+g)|0,(H[7]+h)|0];
    }
    const out = new Uint8Array(32);
    for (let i = 0; i < 8; i++) {
      out[i*4] = (H[i] >>> 24) & 255; out[i*4+1] = (H[i] >>> 16) & 255;
      out[i*4+2] = (H[i] >>> 8) & 255; out[i*4+3] = H[i] & 255;
    }
    return out;
  }

  function initFingerprint() {
    const glyph  = document.getElementById('fp-glyph');
    const hashEl = document.getElementById('fp-hash');
    const dateEl = document.getElementById('fp-date');
    const btn    = document.getElementById('cv-print');
    if (!glyph) return;

    const toHex = (b, n) => Array.from(b.slice(0, n)).map((x) => x.toString(16).padStart(2, '0')).join('');

    // 5×5 symmetric identicon (left 3 columns mirrored), seeded from the hash
    function renderGlyph(bytes) {
      const s = 8;
      let cells = '';
      for (let col = 0; col < 3; col++) {
        for (let row = 0; row < 5; row++) {
          if (!(bytes[col * 5 + row] & 1)) continue;
          const xs = col === 2 ? [2] : [col, 4 - col];
          for (const c of xs) cells += `<rect x="${c*s}" y="${row*s}" width="${s}" height="${s}"/>`;
        }
      }
      glyph.innerHTML = cells;
    }

    function generate() {
      const rnd = (crypto.getRandomValues(new Uint8Array(6))).join('');
      const seed = `Andrii Pasichnyk|CV|${new Date().toISOString()}|${rnd}`;
      const bytes = sha256Bytes(seed);
      renderGlyph(bytes);
      hashEl.textContent = 'sha256:' + toHex(bytes, 10);
      dateEl.textContent = new Date().toISOString().slice(0, 16).replace('T', ' ') + ' UTC';
    }

    generate();
    if (btn) btn.onclick = () => { generate(); window.print(); };
    window.addEventListener('beforeprint', generate);
    stopFingerprint = () => window.removeEventListener('beforeprint', generate);
  }

  let stopFingerprint = () => {};
  document.addEventListener('astro:page-load', initFingerprint);
  document.addEventListener('astro:before-swap', () => { stopFingerprint(); stopFingerprint = () => {}; });
</script>
