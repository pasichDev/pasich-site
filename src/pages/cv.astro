---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';

const experience = [
  {
    title: 'Software Engineer',
    period: '02/2026 - Present',
    company: 'InTallyCon',
    achievements: [
      'The open-source Flutter plugin for <strong>WireGuard</strong> we started from was abandoned in 2024 and ran on each platform\'s stock backend. Those backends drop the tunnel whenever peers change, which ruled out direct P2P connections. I forked it and turned it into our own plugin for Android, iOS, macOS and Windows.',
      'Wrote one data plane on top of <strong>wireguard-go</strong> that owns the tunnel and the UDP socket itself, and reused it on every platform (gomobile, cgo). Peers now change without a reconnect, and a fix lands on all platforms at once.',
      'On top of it built a <strong>P2P core in Go</strong>, so devices can connect to each other directly instead of going through a relay.',
      'Added split DNS and LAN bypass. Before that, turning on a full tunnel cut users off from their own router and NAS.',
      'On Windows the old plugin needed admin rights to start the tunnel. I replaced that with a <strong>C++</strong> SYSTEM service on WireGuard-NT: one install, after that the app talks to it over a named pipe, and the private key never leaves the service.',
      'Besides the VPN, I built several Flutter apps and Go backend services, take part in architecture decisions and review code on the Flutter and Go projects.',
      'Also work on embedded Linux built with <strong>Yocto</strong> (BitBake recipes, layers, cross-compilation, systemd).'
    ],
    tags: ['Flutter', 'Dart', 'Go', 'C++', 'Swift', 'Kotlin', 'WireGuard', 'Windows Services', 'Yocto', 'Embedded Linux']
  },
  {
    title: 'Open Source: Linux Kernel / WireGuard',
    period: '2026',
    company: 'github.com/pasichDev/rtl8196e-wireguard',
    achievements: [
      'Got WireGuard on a cheap single-core router chip (Realtek RTL8196E, 400 MHz) running twice as fast: TCP went from 9.4 to 18.8 Mbit/s, and ping through a busy tunnel dropped from 108 to 31 ms.',
      'The cipher wasn\'t the bottleneck. Profiling showed a context switch on almost every packet, because WireGuard hands packets to worker queues built for multi-core machines. My patch skips those queues when there is only one CPU.',
      'Found a memory leak in WireGuard that had been in the kernel since 2019, and sent the fix to the netdev mailing list.'
    ],
    tags: ['Linux Kernel', 'C', 'WireGuard', 'Networking', 'Profiling']
  },
  {
    title: 'Flutter Developer',
    period: '2023 - 2024',
    company: 'NosoCoin (freelance, open source)',
    achievements: [
      'Wrote <strong>SovaWallet</strong>, a Flutter crypto wallet for phones and desktop.',
      'The coin\'s reference code was in Pascal, so I ported its hashing, signatures and network protocol to Dart.',
      'Where Dart was too slow, called C++ libraries through FFI.',
      'The wallet picks a node on its own, switches when one goes down and syncs in the background.'
    ],
    tags: ['Flutter', 'Dart', 'Dart FFI', 'C++']
  },
  {
    title: 'Android Developer',
    period: '2021 - Present',
    company: 'Own apps (side projects)',
    achievements: [
      '<strong>My Notes</strong> has 10k+ downloads. Its block-based editor is my own, written without third-party editor libraries.',
      '<strong>Encly</strong> is on Google Play and F-Droid: encrypted notes and tasks with no account, no cloud and no internet permission at all.',
      'Both are built with Clean Architecture, MVVM, Hilt and Room, with database migrations between versions.',
      'In other projects used the Google Maps API for tracking, geocoding and routes.'
    ],
    tags: ['Kotlin', 'Jetpack Compose', 'Room', 'Hilt']
  },
  {
    title: 'Web Developer',
    period: '2015 - 2020',
    company: 'Freelance',
    achievements: [
      'Built REST APIs, admin panels and small SaaS tools in PHP, JavaScript and SQL.'
    ],
    tags: []
  }
];

const structuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Andrii Pasichnyk",
  "alternateName": "pasichDev",
  "jobTitle": "Software Engineer",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Rivne",
    "addressCountry": "Ukraine"
  },
  "email": "apasichnik9@gmail.com",
  "telephone": "+380961814800",
  "url": "https://pasichdev.xyz/cv",
  "sameAs": ["https://github.com/pasichDev"]
};
---

<BaseLayout 
  title="CV — Andrii Pasichnyk"
  description="Resume of Andrii Pasichnyk, Software Engineer. Flutter, Go and C++: a cross-platform WireGuard VPN, Go backends, Yocto-based embedded Linux, Linux kernel patches."
  canonical="https://pasichdev.xyz/cv"
  structuredData={structuredData}
>
  <div class="container animate-fade-in">
    
    <!-- CV Header -->
    <header class="cv-header">
      <div>
        <h1 class="text-accent" style="font-size: 1.875rem; margin-bottom: 0.5rem;">Andrii Pasichnyk</h1>
        <p class="text-lg text-dim" style="font-weight: 300;">Software Engineer</p>
        <div class="flex items-center gap-4 mt-4 text-sm text-dim flex-wrap">
          <span class="flex items-center gap-1">
            <Icon name="solar:map-point-linear" /> Rivne, Ukraine
          </span>
          <span class="flex items-center gap-1" style="color: var(--color-green);">
            <Icon name="solar:clock-circle-linear" /> UTC+2
          </span>
        </div>
      </div>
      <div class="contact-info">
        <a href="mailto:apasichnik9@gmail.com">apasichnik9@gmail.com</a>
        <a href="https://www.linkedin.com/in/pasichdev">linkedin.com/in/pasichdev</a>
        <a href="https://github.com/pasichDev">github.com/pasichDev</a>
      </div>
    </header>
    
    <!-- Summary -->
    <section class="section" style="margin-bottom: 3rem;">
      <h2 class="text-sm font-mono uppercase text-dim tracking-wide mb-6">Profile</h2>
      <p class="text-accent leading-relaxed" style="font-weight: 300; opacity: 0.9;">
        I'm a software engineer at InTallyCon, where I work on our
        <strong class="font-medium">WireGuard VPN</strong>: the Flutter plugin and apps on top, Go and C++ underneath,
        on Android, iOS, macOS and Windows. I also write
        <strong class="font-medium">Go backends</strong> and work on
        <strong class="font-medium">Yocto-based embedded Linux</strong>.
        Outside work I dig into the Linux kernel (my WireGuard patch doubled throughput on a single-core router)
        and keep a couple of Android apps going.
      </p>
    </section>
    
    <!-- Experience -->
    <section class="section" style="margin-bottom: 3rem;">
      <h2 class="text-sm font-mono uppercase text-dim tracking-wide mb-8">Experience</h2>
      
      <div class="timeline">
        {experience.map((job) => (
          <div class="timeline-item">
            <div class="timeline-header">
              <h3 class="timeline-title">{job.title}</h3>
              <span class="timeline-date">{job.period}</span>
            </div>
            <div class="timeline-subtitle">{job.company}</div>
            <div class="timeline-content">
              <ul>
                {job.achievements.map((item) => (
                  <li set:html={item} />
                ))}
              </ul>
            </div>
            {job.tags.length > 0 && (
              <div class="flex flex-wrap gap-2 mt-4">
                {job.tags.map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
            )}
          </div>
        ))}
      </div>
    </section>
    
    <!-- Skills Grid -->
    <section class="section" style="margin-bottom: 3rem;">
      <h2 class="text-sm font-mono uppercase text-dim tracking-wide mb-6">Technical Skills</h2>
      
      <div class="skills-grid">
        <div>
          <h4 class="text-accent text-sm font-medium mb-4">Programming Languages</h4>
          <p class="text-sm text-dim leading-relaxed">
            Go, Dart, C++, C, Kotlin, Swift, Java, SQL.
          </p>
        </div>

        <div>
          <h4 class="text-accent text-sm font-medium mb-4">Networking & VPN</h4>
          <p class="text-sm text-dim leading-relaxed">
            WireGuard (wireguard-go, WireGuard-NT, Linux kernel), TCP/IP, UDP, DNS, NAT, iptables, P2P, REST, WebSocket, gRPC, Protocol Buffers.
          </p>
        </div>

        <div>
          <h4 class="text-accent text-sm font-medium mb-4">Mobile & Desktop</h4>
          <p class="text-sm text-dim leading-relaxed">
            Flutter (platform plugins, Dart FFI, Bloc, Riverpod), Android (VpnService, Jetpack Compose, Room, Hilt, WorkManager), iOS/macOS (Network Extension, Keychain), Windows (Win32, services, named pipes, DPAPI, CNG).
          </p>
        </div>

        <div>
          <h4 class="text-accent text-sm font-medium mb-4">Embedded Linux</h4>
          <p class="text-sm text-dim leading-relaxed">
            Yocto Project, OpenEmbedded, BitBake, cross-compilation, systemd, Linux kernel patches, kernel profiling.
          </p>
        </div>

        <div>
          <h4 class="text-accent text-sm font-medium mb-4">Backend & Data</h4>
          <p class="text-sm text-dim leading-relaxed">
            Go services (REST, encryption at rest, SQLite without cgo), PostgreSQL, SQLite, Firebase.
          </p>
        </div>

        <div>
          <h4 class="text-accent text-sm font-medium mb-4">Practices</h4>
          <p class="text-sm text-dim leading-relaxed">
            Software architecture, Clean Architecture, MVVM, code review, Git, GitLab CI, GitHub Actions, unit testing.
          </p>
        </div>
      </div>
    </section>
    
    <!-- Languages -->
    <section class="section" style="border-top: 1px solid var(--color-border); padding-top: 2rem; margin-bottom: 3rem;">
      <h2 class="text-sm font-mono uppercase text-dim tracking-wide mb-6">Languages</h2>
      <div class="flex gap-8 text-sm flex-wrap">
        <div>
          <span class="block text-dim text-xs uppercase mb-1">Ukrainian</span>
          <span class="text-accent">Native</span>
        </div>
        <div>
          <span class="block text-dim text-xs uppercase mb-1">English</span>
          <span class="text-accent">A1 (Beginner)</span>
        </div>
      </div>
    </section>
    
    <!-- Cryptographic fingerprint — regenerated on every print -->
    <div class="cv-fingerprint">
      <svg class="fp-glyph" id="fp-glyph" viewBox="0 0 40 40" aria-hidden="true"></svg>
      <div class="fp-meta">
        <span class="fp-label">Document fingerprint</span>
        <span class="fp-hash" id="fp-hash">—</span>
        <span class="fp-date" id="fp-date"></span>
      </div>
    </div>

    <!-- Print Button -->
    <div class="text-center no-print" style="padding-bottom: 5rem;">
      <button id="cv-print" class="print-btn">
        [ PRINT / SAVE AS PDF ]
      </button>
    </div>

  </div>
</BaseLayout>

<style>
  .cv-header {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 2rem;
    margin-bottom: 3rem;
  }
  
  @media (min-width: 768px) {
    .cv-header {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-end;
    }
  }
  
  .contact-info {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--color-txt-dim);
  }
  
  @media (min-width: 768px) {
    .contact-info {
      text-align: right;
    }
  }
  
  .contact-info a:hover {
    color: var(--color-accent);
  }
  
  .skills-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  
  @media (min-width: 768px) {
    .skills-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 3rem 2rem;
    }
  }
  
  .skill-tag {
    padding: 0.375rem 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 2px;
    font-size: 0.75rem;
    color: var(--color-accent);
    background: var(--color-surface);
  }
  
  .print-btn {
    background: none;
    border: none;
    color: var(--color-txt-dim);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    cursor: pointer;
    padding: 0.25rem;
    border-bottom: 1px solid transparent;
    transition: all 0.15s;
  }
  
  .print-btn:hover {
    color: var(--color-accent);
    border-bottom-color: var(--color-accent);
  }

  /* ── Cryptographic fingerprint ─────────────────── */
  .cv-fingerprint {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    border-top: 1px solid var(--color-border);
    padding-top: 1.5rem;
    margin-bottom: 2.5rem;
    color: var(--color-txt-dim);
  }
  .fp-glyph {
    width: 40px;
    height: 40px;
    fill: currentColor;
    flex-shrink: 0;
    opacity: 0.85;
  }
  .fp-meta {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    font-family: var(--font-mono);
    min-width: 0;
  }
  .fp-label {
    font-size: 0.55rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    opacity: 0.7;
  }
  .fp-hash {
    font-size: 0.72rem;
    color: var(--color-accent);
    letter-spacing: 0.02em;
    word-break: break-all;
  }
  .fp-date {
    font-size: 0.58rem;
    opacity: 0.6;
  }

  /* ── Print: force readable black-on-white ──────── */
  @media print {
    /* kill every stray glow/shadow/filter (incl. injected overlays) */
    :global(*), :global(*::before), :global(*::after) {
      box-shadow: none !important;
      filter: none !important;
      -webkit-filter: none !important;
      text-shadow: none !important;
      mask-image: none !important;
      -webkit-mask-image: none !important;
    }
    :global(html), :global(body) { background: #fff !important; }
    :global(.bg-grid) { display: none !important; }
    :global(#claude-agent-glow-border),
    :global(#claude-phantom-cursor) { display: none !important; }
    :global(main) { padding: 0 !important; min-height: 0 !important; }
    :global(.container), :global(.container-sm) {
      max-width: 100% !important;
      width: auto !important;
      margin: 0 !important;
      padding: 0 4mm !important;
    }

    /* every bit of text dark on white — kills white-on-white */
    :global(main), :global(main *) {
      color: #1a1a1a !important;
      background: transparent !important;
      box-shadow: none !important;
      -webkit-text-fill-color: #1a1a1a !important;
    }
    :global(.text-dim),
    .timeline-subtitle, .timeline-date, .contact-info,
    .fp-label, .fp-date { color: #555 !important; -webkit-text-fill-color: #555 !important; }
    a { text-decoration: none !important; }

    .cv-header {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-end;
      border-bottom: 1px solid #ccc;
      padding-bottom: 1rem;
      margin-bottom: 1.5rem;
    }
    .contact-info { text-align: right; }
    .skills-grid { grid-template-columns: repeat(2, 1fr); gap: 1.3rem 2rem; }

    .timeline { border-left: 1px solid #ccc; }
    .timeline-item::before { background: #fff !important; border: 1px solid #999 !important; }
    .timeline-content :global(li)::marker { color: #999 !important; }
    .timeline-date { white-space: nowrap; }
    .timeline-header { gap: 1rem; }

    .tag, .skill-tag {
      color: #111 !important;
      background: #fff !important;
      border: 1px solid #bbb !important;
    }

    .cv-fingerprint { border-top: 1px solid #ccc; margin-top: 1.5rem; }
    .fp-glyph { fill: #111 !important; opacity: 1; }

    section, .timeline-item { break-inside: avoid; }
    @page { margin: 15mm 12mm; }
  }
</style>

<script>
  // Compact synchronous SHA-256 (so it also works inside beforeprint).
  function sha256Bytes(ascii) {
    const rrot = (x, n) => (x >>> n) | (x << (32 - n));
    const K = [
      0x428a2f98,0x71374491,0xb5c0fbcf,0xe9b5dba5,0x3956c25b,0x59f111f1,0x923f82a4,0xab1c5ed5,
      0xd807aa98,0x12835b01,0x243185be,0x550c7dc3,0x72be5d74,0x80deb1fe,0x9bdc06a7,0xc19bf174,
      0xe49b69c1,0xefbe4786,0x0fc19dc6,0x240ca1cc,0x2de92c6f,0x4a7484aa,0x5cb0a9dc,0x76f988da,
      0x983e5152,0xa831c66d,0xb00327c8,0xbf597fc7,0xc6e00bf3,0xd5a79147,0x06ca6351,0x14292967,
      0x27b70a85,0x2e1b2138,0x4d2c6dfc,0x53380d13,0x650a7354,0x766a0abb,0x81c2c92e,0x92722c85,
      0xa2bfe8a1,0xa81a664b,0xc24b8b70,0xc76c51a3,0xd192e819,0xd6990624,0xf40e3585,0x106aa070,
      0x19a4c116,0x1e376c08,0x2748774c,0x34b0bcb5,0x391c0cb3,0x4ed8aa4a,0x5b9cca4f,0x682e6ff3,
      0x748f82ee,0x78a5636f,0x84c87814,0x8cc70208,0x90befffa,0xa4506ceb,0xbef9a3f7,0xc67178f2
    ];
    let H = [0x6a09e667,0xbb67ae85,0x3c6ef372,0xa54ff53a,0x510e527f,0x9b05688c,0x1f83d9ab,0x5be0cd19];
    const bytes = [];
    for (let i = 0; i < ascii.length; i++) {
      let c = ascii.charCodeAt(i);
      if (c < 128) bytes.push(c);
      else if (c < 2048) bytes.push(192 | (c >> 6), 128 | (c & 63));
      else bytes.push(224 | (c >> 12), 128 | ((c >> 6) & 63), 128 | (c & 63));
    }
    const bitLen = bytes.length * 8;
    bytes.push(0x80);
    while (bytes.length % 64 !== 56) bytes.push(0);
    for (let i = 7; i >= 0; i--) bytes.push(Math.floor(bitLen / Math.pow(2, i * 8)) & 0xff);
    const w = new Uint32Array(64);
    for (let off = 0; off < bytes.length; off += 64) {
      for (let i = 0; i < 16; i++)
        w[i] = (bytes[off+i*4] << 24) | (bytes[off+i*4+1] << 16) | (bytes[off+i*4+2] << 8) | bytes[off+i*4+3];
      for (let i = 16; i < 64; i++) {
        const s0 = rrot(w[i-15],7) ^ rrot(w[i-15],18) ^ (w[i-15] >>> 3);
        const s1 = rrot(w[i-2],17) ^ rrot(w[i-2],19) ^ (w[i-2] >>> 10);
        w[i] = (w[i-16] + s0 + w[i-7] + s1) | 0;
      }
      let [a,b,c,d,e,f,g,h] = H;
      for (let i = 0; i < 64; i++) {
        const S1 = rrot(e,6) ^ rrot(e,11) ^ rrot(e,25);
        const ch = (e & f) ^ (~e & g);
        const t1 = (h + S1 + ch + K[i] + w[i]) | 0;
        const S0 = rrot(a,2) ^ rrot(a,13) ^ rrot(a,22);
        const maj = (a & b) ^ (a & c) ^ (b & c);
        const t2 = (S0 + maj) | 0;
        h = g; g = f; f = e; e = (d + t1) | 0; d = c; c = b; b = a; a = (t1 + t2) | 0;
      }
      H = [(H[0]+a)|0,(H[1]+b)|0,(H[2]+c)|0,(H[3]+d)|0,(H[4]+e)|0,(H[5]+f)|0,(H[6]+g)|0,(H[7]+h)|0];
    }
    const out = new Uint8Array(32);
    for (let i = 0; i < 8; i++) {
      out[i*4] = (H[i] >>> 24) & 255; out[i*4+1] = (H[i] >>> 16) & 255;
      out[i*4+2] = (H[i] >>> 8) & 255; out[i*4+3] = H[i] & 255;
    }
    return out;
  }

  function initFingerprint() {
    const glyph  = document.getElementById('fp-glyph');
    const hashEl = document.getElementById('fp-hash');
    const dateEl = document.getElementById('fp-date');
    const btn    = document.getElementById('cv-print');
    if (!glyph) return;

    const toHex = (b, n) => Array.from(b.slice(0, n)).map((x) => x.toString(16).padStart(2, '0')).join('');

    // 5×5 symmetric identicon (left 3 columns mirrored), seeded from the hash
    function renderGlyph(bytes) {
      const s = 8;
      let cells = '';
      for (let col = 0; col < 3; col++) {
        for (let row = 0; row < 5; row++) {
          if (!(bytes[col * 5 + row] & 1)) continue;
          const xs = col === 2 ? [2] : [col, 4 - col];
          for (const c of xs) cells += `<rect x="${c*s}" y="${row*s}" width="${s}" height="${s}"/>`;
        }
      }
      glyph.innerHTML = cells;
    }

    function generate() {
      const rnd = (crypto.getRandomValues(new Uint8Array(6))).join('');
      const seed = `Andrii Pasichnyk|CV|${new Date().toISOString()}|${rnd}`;
      const bytes = sha256Bytes(seed);
      renderGlyph(bytes);
      hashEl.textContent = 'sha256:' + toHex(bytes, 10);
      dateEl.textContent = new Date().toISOString().slice(0, 16).replace('T', ' ') + ' UTC';
    }

    generate();
    if (btn) btn.onclick = () => { generate(); window.print(); };
    window.addEventListener('beforeprint', generate);
  }

  document.addEventListener('astro:page-load', initFingerprint);
</script>
