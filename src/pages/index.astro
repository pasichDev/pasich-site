  .ttt-line { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; opacity: 0; }
  .ttt-line.show { opacity: 1; }
  .ttt-line line { stroke-width: 2; stroke-linecap: round; vector-effect: non-scaling-stroke; }

  @media (max-width: 860px) {
    .hero__br { display: none; }
    /* «PASICHNYK» at width 125 takes ~0.95em per letter, so 10vw fits a phone */
