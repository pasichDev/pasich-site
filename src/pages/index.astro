---
import BaseLayout from '../layouts/BaseLayout.astro';
import GitHubHeatmap from '../components/ui/GitHubHeatmap.astro';
import { Icon } from 'astro-icon/components';

const skillGroups = [
  {
    label: 'Systems',
    skills: [
      { name: 'C++',               level: 'expert',   tooltip: 'Systems code — memory, concurrency, low-level control' },
      { name: 'Windows Services',  level: 'expert',   tooltip: 'Long-running background services — lifecycle and IPC' },
      { name: 'WireGuard-NT',      level: 'advanced', tooltip: 'VPN tunnel management from native code' },
      { name: 'Memory Safety',     level: 'advanced', tooltip: 'Chasing down use-after-free and data races' },
      { name: 'BCrypt / CNG',      level: 'advanced', tooltip: 'Windows crypto APIs and certificate validation' },
      { name: 'Win32 API',         level: 'advanced', tooltip: 'Native Windows APIs — services, IPC, sockets' },
    ],
  },
  {
    label: 'Backend',
    skills: [
      { name: 'Go',                 level: 'expert',   tooltip: 'Go services — goroutines, clean layering, production APIs' },
      { name: 'Encryption at rest', level: 'advanced', tooltip: 'Authenticated encryption of sensitive fields (AEAD)' },
      { name: 'SQLite (no cgo)',    level: 'advanced', tooltip: 'Pure-Go SQLite — portable static binaries' },
      { name: 'Reproducible Builds',level: 'advanced', tooltip: 'Deterministic, verifiable release builds' },
      { name: 'WebSocket',          level: 'advanced', tooltip: 'Real-time transport — media control and file sync in Linqora' },
      { name: 'REST API',           level: 'expert',   tooltip: 'API design, versioning, auth' },
    ],
  },
  {
    label: 'Mobile',
    skills: [
      { name: 'Kotlin',          level: 'expert',   tooltip: 'Main Android language — Coroutines, Flow, Jetpack, Hilt, Room' },
      { name: 'Swift',           level: 'advanced', tooltip: 'Native iOS across the Apple platform' },
      { name: 'Java',            level: 'expert',   tooltip: 'Android and JVM — legacy code, Kotlin interop, JNI' },
      { name: 'Jetpack Compose', level: 'advanced', tooltip: 'Declarative UI — layouts, theming, state, animations' },
      { name: 'BLE / NFC',       level: 'advanced', tooltip: 'BLE scanning and GATT, NFC read/write in shipped apps' },
      { name: 'Offline-first',   level: 'expert',   tooltip: 'Room with migrations, SQLCipher, local-only data' },
    ],
  },
  {
    label: 'Cross-platform',
    skills: [
      { name: 'Flutter',   level: 'expert',   tooltip: 'Apps for Android, iOS and Desktop — Bloc, Riverpod, platform channels' },
      { name: 'Dart',      level: 'expert',   tooltip: 'Async, isolates, FFI — C++ bindings in SovaWallet' },
      { name: 'C++ / NDK', level: 'expert',   tooltip: 'Android NDK and JNI — native libs bridged into Flutter via FFI' },
    ],
  },
  {
    label: 'Realtime & Infra',
    skills: [
      { name: 'Firebase FCM',   level: 'advanced', tooltip: 'Push notifications' },
      { name: 'SSE',            level: 'advanced', tooltip: 'Server-Sent Events — one-way live streams' },
      { name: 'Event Pipelines',level: 'advanced', tooltip: 'Event-driven flows between services' },
      { name: 'GitLab CI/CD',   level: 'advanced', tooltip: 'Pipelines and release builds' },
    ],
  },
  {
    label: 'Web',
    skills: [
      { name: 'React',      level: 'advanced', tooltip: 'Components, hooks, context, routing' },
      { name: 'Next.js',    level: 'advanced', tooltip: 'SSR and SSG — App Router, API routes' },
      { name: 'TypeScript', level: 'advanced', tooltip: 'Typed frontend and backend' },
      { name: 'HTML & CSS', level: 'advanced', tooltip: 'Grid/Flexbox, animations, custom styling' },
    ],
  },
];

const services = [
  { icon: 'solar:cpu-bolt-linear',        title: 'System Services',    desc: 'Background services in C++ on Windows — lifecycle, IPC, native APIs' },
  { icon: 'solar:server-linear',          title: 'Backends',           desc: 'Go — REST APIs, encryption at rest, reproducible builds' },
  { icon: 'solar:diagram-up-linear',      title: 'Architecture',       desc: 'Keeping services, data and boundaries clean as things grow' },
  { icon: 'solar:smartphone-linear',      title: 'Mobile Apps',        desc: 'Kotlin, Swift and Flutter — from first build to store release' },
  { icon: 'solar:global-linear',          title: 'Web Apps',           desc: 'React / Next.js — fast, accessible, SEO-friendly' },
  { icon: 'solar:refresh-circle-linear',  title: 'Realtime & Infra',   desc: 'Push, live updates and CI/CD — FCM, SSE, GitLab' },
];

const projects = [
  {
    icon: 'solar:broom-linear',
    emoji: '◇',
    title: 'Chystik',
    description: 'Safety-first disk cleanup for developers. ~200 rules explain what each finding is and what losing it costs — protected paths are refused, and cleanup goes to the trash, never straight to unlink. Linux supported; macOS and Windows in preview.',
    tags: ['Rust', 'egui', 'Cross-platform'],
    href: 'https://github.com/pasichDev/chystik',
    siteHref: 'https://pasichdev.github.io/chystik/',
  },
  {
    icon: 'solar:devices-linear',
    emoji: '⬡',
    title: 'Linqora',
    description: 'Seamless PC-Mobile integration. Control media, monitor resources, and transfer files via WebSocket/mDNS.',
    tags: ['Go', 'Flutter', 'WebSocket'],
    href: 'https://github.com/pasichDev/linqora',
  },
  {
    icon: 'solar:wallet-linear',
    emoji: '◎',
    title: 'SovaWallet',
    description: 'NosoCoin ecosystem wallet. Complex cryptographic implementation, node balancing, and custom binary protocols.',
    tags: ['C++', 'Dart FFI', 'Flutter'],
    href: 'https://github.com/Noso-Project/NosoSova',
  },
  {
    icon: 'solar:notebook-linear',
    emoji: '📓',
    title: 'My Notes',
    description: 'Offline-first Android notebook. Custom rich-text editor, local encryption, Room database, and zero tracking.',
    tags: ['Kotlin', 'Room', 'MVVM'],
    href: '/apps/mynotes',
    playStoreHref: 'https://play.google.com/store/apps/details?id=com.pasich.mynotes',
    downloads: '30k+',
  },
  {
    icon: 'solar:heart-linear',
    emoji: '♥',
    title: 'Felisca',
    description: 'Personal mental companion. Deep mood tracking with privacy-first architecture. Offline-only, encrypted locally, complete control.',
    tags: ['Flutter', 'Dart', 'Privacy-First'],
    href: '/apps/felisca',
    playStoreHref: 'https://play.google.com/store/apps/details?id=com.pasichdev.felisca',
  },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Andrii Pasichnyk',
  alternateName: 'pasichDev',
  url: 'https://pasichdev.xyz',
  jobTitle: 'Software Architect',
  knowsAbout: ['Software Architecture', 'C++', 'Rust', 'Windows Services', 'WireGuard', 'Systems Security', 'Go', 'AEAD', 'Android', 'Kotlin', 'Swift', 'Flutter', 'Offline-first'],
  sameAs: ['https://github.com/pasichDev', 'https://t.me/pasichdev'],
};
---

<BaseLayout
  title="pasichDev — Software Architect"
  description="Software engineer and architect. C++ system services on Windows, Go backends, and mobile apps in Kotlin, Swift and Flutter."
  structuredData={structuredData}
>
  <div class="container animate-fade-in">

    <!-- ── HERO ──────────────────────────────────── -->
    <header class="hero">
      <p class="eyebrow">
        <span class="eyebrow-line"></span>
        pasichDev / index
      </p>

      <h1 class="hero-name">Andrii Pasichnyk</h1>

      <p class="hero-role">
        Software Architect<span class="cursor" aria-hidden="true"></span>
      </p>

      <p class="hero-tagline">
        Full-stack, leaning to systems. I write <span class="hl">C++</span> services on Windows,
        <span class="hl">Go</span> on the backend, and mobile apps in
        <span class="hl">Kotlin, Swift &amp; Flutter</span>.
      </p>

      <div class="hero-meta">
        <span class="location">Rivne, 🇺🇦 · UTC+2</span>
        <span class="badge-avail">
          <span class="badge-dot" aria-hidden="true"></span>
          Available
        </span>
      </div>

      <div class="hero-cta">
        <a href="/cv" class="btn btn-primary">View CV ↗</a>
        <a href="/tools" class="btn btn-outline">Tools</a>
        <a href="#contact" class="btn btn-outline">Contact</a>
      </div>

      <GitHubHeatmap />
    </header>

    <!-- ── STATS ─────────────────────────────────── -->
    <div class="stats-strip reveal">
      <div class="stat-item">
        <span class="stat-val">5+</span>
        <span class="stat-lbl">Years Exp</span>
      </div>
      <div class="stat-item">
        <span class="stat-val">10+</span>
        <span class="stat-lbl">Projects</span>
      </div>
      <div class="stat-item">
        <span class="stat-val">30k+</span>
        <span class="stat-lbl">Downloads</span>
      </div>
      <div class="stat-item">
        <span class="stat-val">6</span>
        <span class="stat-lbl">Languages</span>
      </div>
    </div>

    <!-- ── PROJECTS ──────────────────────────────── -->
    <section class="section reveal" id="projects">
      <div class="section-head">
        <h2 class="section-title">Selected Work</h2>
        <span class="section-num">01 — 05</span>
      </div>

      <div class="proj-grid">
        {projects.map((p) => (
          <div class="proj-card">
            <div class="proj-body">
              <div class="proj-top">
                <div class="proj-icon">
                  <Icon name={p.icon} width="18" height="18" />
                </div>
                {p.downloads && (
                  <span class="proj-dl">
                    <Icon name="solar:download-linear" width="10" height="10" />
                    {p.downloads}
                  </span>
                )}
              </div>
              <h3 class="proj-name">{p.title}</h3>
              <p class="proj-desc">{p.description}</p>
              <div class="proj-tags">
                {p.tags.map((t) => <span class="tag">{t}</span>)}
              </div>
            </div>
            <div class="proj-actions">
              <a
                href={p.href}
                target={p.href.startsWith('http') ? '_blank' : '_self'}
                rel={p.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                class="btn-sm"
              >
                {p.href.startsWith('https://github.com') ? 'GitHub ↗' : 'Details →'}
              </a>
              {p.siteHref && (
                <a
                  href={p.siteHref}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-sm"
                >
                  <Icon name="solar:global-linear" width="12" height="12" />
                  Website
                </a>
              )}
              {p.playStoreHref && (
                <a
                  href={p.playStoreHref}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-sm"
                >
                  <Icon name="solar:smartphone-linear" width="12" height="12" />
                  Play Store
                </a>
              )}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ── SKILLS ────────────────────────────────── -->
    <section class="section reveal">
      <div class="section-head">
        <h2 class="section-title">Skills</h2>
      </div>

      <div class="skill-categories">
        {skillGroups.map((group) => (
          <div class="skill-cat">
            <div class="cat-label">{group.label}</div>
            <div class="cat-tags">
              {group.skills.map((s) => (
                <span
                  class={`skill-tag level-${s.level}`}
                  title={s.tooltip}
                >
                  <span class="skill-meter" aria-hidden="true">
                    <i></i><i></i><i></i>
                  </span>
                  {s.name}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ── WHAT I BUILD ───────────────────────────── -->
    <section class="section reveal" id="services">
      <div class="section-head">
        <h2 class="section-title">What I Build</h2>
      </div>

      <div class="svc-grid">
        {services.map((s) => (
          <div class="svc-card">
            <Icon name={s.icon} width="20" height="20" class="svc-icon" />
            <div class="svc-title">{s.title}</div>
            <p class="svc-desc">{s.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- ── TIC-TAC-TOE ───────────────────────────── -->
    <section class="section reveal" id="play">
      <div class="section-head">
        <h2 class="section-title">Tic-Tac-Toe</h2>
        <span class="section-num">vs. AI</span>
      </div>

      <div class="ttt">
        <div class="ttt-status" id="ttt-status">Your move — you're X</div>
        <div class="ttt-board-wrap">
          <div class="ttt-board" id="ttt-board">
            <button class="ttt-cell" data-i="0" aria-label="cell 1"></button>
            <button class="ttt-cell" data-i="1" aria-label="cell 2"></button>
            <button class="ttt-cell" data-i="2" aria-label="cell 3"></button>
            <button class="ttt-cell" data-i="3" aria-label="cell 4"></button>
            <button class="ttt-cell" data-i="4" aria-label="cell 5"></button>
            <button class="ttt-cell" data-i="5" aria-label="cell 6"></button>
            <button class="ttt-cell" data-i="6" aria-label="cell 7"></button>
            <button class="ttt-cell" data-i="7" aria-label="cell 8"></button>
            <button class="ttt-cell" data-i="8" aria-label="cell 9"></button>
          </div>
          <svg class="ttt-line" id="ttt-line" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
            <line x1="0" y1="0" x2="0" y2="0"></line>
          </svg>
        </div>
        <button class="ttt-reset" id="ttt-reset">↺ New game</button>
      </div>
    </section>

  </div>
</BaseLayout>

<script>
  function initReveal() {
    document.querySelectorAll('.reveal').forEach((el) => el.classList.remove('in'));

    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          e.target.classList.add('in');
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0, rootMargin: '0px 0px -32px 0px' });

    document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

    setTimeout(() => {
      document.querySelectorAll('.reveal:not(.in)').forEach((el) => el.classList.add('in'));
    }, 1500);
  }

  function initCounts() {
    const els = document.querySelectorAll('.stat-val');
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        const el = e.target;
        io.unobserve(el);
        const raw = el.dataset.raw || el.textContent.trim();
        el.dataset.raw = raw;
        const m = raw.match(/^(\d+)(.*)$/);
        if (!m) return;
        const target = parseInt(m[1], 10);
        const suffix = m[2];
        const dur = 900;
        const start = performance.now();
        function tick(now) {
          const p = Math.min(1, (now - start) / dur);
          const eased = 1 - Math.pow(1 - p, 3);
          el.textContent = Math.round(target * eased) + suffix;
          if (p < 1) requestAnimationFrame(tick);
        }
        requestAnimationFrame(tick);
      });
    }, { threshold: 0.5 });
    els.forEach((el) => io.observe(el));
  }

  function initTTT() {
    const boardEl  = document.getElementById('ttt-board');
    const statusEl = document.getElementById('ttt-status');
    const resetEl  = document.getElementById('ttt-reset');
    if (!boardEl || !statusEl || !resetEl) return;

    const HU = 'X', AI = 'O';
    const LINES = [[0,1,2],[3,4,5],[6,7,8],[0,3,6],[1,4,7],[2,5,8],[0,4,8],[2,4,6]];
    const cells = Array.from(boardEl.querySelectorAll('.ttt-cell'));
    const lineSvg = document.getElementById('ttt-line');
    const lineEl = lineSvg ? lineSvg.querySelector('line') : null;
    let board, over;

    const COORDS = {
      '0,1,2': [8,16.7,92,16.7], '3,4,5': [8,50,92,50], '6,7,8': [8,83.3,92,83.3],
      '0,3,6': [16.7,8,16.7,92], '1,4,7': [50,8,50,92], '2,5,8': [83.3,8,83.3,92],
      '0,4,8': [12,12,88,88], '2,4,6': [88,12,12,88],
    };

    const winInfo = (b) => {
      for (const L of LINES) { const [a,c,d] = L; if (b[a] && b[a] === b[c] && b[a] === b[d]) return { mark: b[a], line: L }; }
      return null;
    };
    const winner = (b) => { const w = winInfo(b); return w ? w.mark : null; };
    const full = (b) => b.every(Boolean);

    function drawLine(combo, mark) {
      if (!lineEl) return;
      const [x1,y1,x2,y2] = COORDS[combo.join(',')];
      lineEl.setAttribute('x1', x1); lineEl.setAttribute('y1', y1);
      lineEl.setAttribute('x2', x2); lineEl.setAttribute('y2', y2);
      const len = Math.hypot(x2 - x1, y2 - y1);
      lineEl.style.stroke = mark === HU ? '#ffffff' : 'var(--color-green)';
      lineEl.style.transition = 'none';
      lineEl.style.strokeDasharray = len;
      lineEl.style.strokeDashoffset = len;
      lineSvg.classList.add('show');
      void lineEl.getBoundingClientRect();
      lineEl.style.transition = 'stroke-dashoffset 0.5s cubic-bezier(0.4,0,0.2,1)';
      lineEl.style.strokeDashoffset = '0';
    }
    function clearLine() {
      if (!lineSvg) return;
      lineSvg.classList.remove('show');
      if (lineEl) { lineEl.style.transition = 'none'; lineEl.style.strokeDashoffset = ''; lineEl.style.strokeDasharray = ''; }
    }

    // minimax with depth so it prefers faster wins / slower losses
    function minimax(b, player, depth) {
      const w = winner(b);
      if (w === AI) return { score: 10 - depth };
      if (w === HU) return { score: depth - 10 };
      if (full(b))  return { score: 0 };
      let best = null;
      for (let i = 0; i < 9; i++) {
        if (!b[i]) {
          b[i] = player;
          const score = minimax(b, player === AI ? HU : AI, depth + 1).score;
          b[i] = '';
          if (best === null ||
             (player === AI && score > best.score) ||
             (player === HU && score < best.score)) best = { i, score };
        }
      }
      return best;
    }

    const render = () => cells.forEach((c, i) => {
      c.textContent = board[i] || '';
      c.classList.toggle('x', board[i] === HU);
      c.classList.toggle('o', board[i] === AI);
      c.disabled = over || !!board[i];
    });

    function finish() {
      const info = winInfo(board);
      if (info) {
        over = true;
        drawLine(info.line, info.mark);
        statusEl.textContent = info.mark === HU ? 'You win — how?! 🎉' : 'AI wins';
      } else if (full(board)) {
        over = true;
        statusEl.textContent = 'Draw — well played';
      }
      if (over) render();
      return over;
    }

    function aiMove() {
      statusEl.textContent = 'AI thinking…';
      cells.forEach((c) => c.disabled = true);
      setTimeout(() => {
        const { i } = minimax(board.slice(), AI, 0);
        board[i] = AI;
        if (!finish()) { statusEl.textContent = "Your move — you're X"; render(); }
      }, 260);
    }

    function reset() {
      board = Array(9).fill('');
      over = false;
      clearLine();
      statusEl.textContent = "Your move — you're X";
      render();
    }

    boardEl.onclick = (e) => {
      const cell = e.target.closest('.ttt-cell');
      if (!cell || over) return;
      const i = Number(cell.dataset.i);
      if (board[i]) return;
      board[i] = HU;
      render();
      if (!finish()) aiMove();
    };
    resetEl.onclick = reset;
    reset();
  }

  document.addEventListener('astro:page-load', () => {
    initReveal();
    initCounts();
    initTTT();
  });
</script>

<style>
  /* ── HERO ──────────────────────────────────────── */
  .hero {
    padding-top: clamp(2.5rem, 6vw, 4rem);
    padding-bottom: clamp(2rem, 5vw, 3rem);
    margin-bottom: 0;
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-txt-dim);
    margin-bottom: 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .eyebrow-line {
    display: inline-block;
    width: 16px;
    height: 1px;
    background: var(--color-txt-dim);
    flex-shrink: 0;
  }

  .hero-name {
    font-size: clamp(2rem, 6vw, 3.5rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.0;
    margin-bottom: 0.5rem;
    background: linear-gradient(100deg, #fff 20%, rgba(255,255,255,0.4) 45%, #fff 70%);
    background-size: 220% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  @keyframes shimmer {
    from { background-position: 180% center; }
    to   { background-position: -80% center; }
  }

  .hero-role {
    font-family: var(--font-mono);
    font-size: clamp(0.8rem, 2vw, 1rem);
    color: var(--color-txt-dim);
    margin-bottom: 1.5rem;
    display: flex;
    align-items: center;
  }

  .cursor {
    display: inline-block;
    width: 8px;
    height: 2px;
    background: var(--color-accent);
    margin-left: 5px;
    align-self: flex-end;
    margin-bottom: 0.28em;
    animation: blink 1.1s step-end infinite;
  }
  @keyframes blink { 0%,100%{opacity:1} 50%{opacity:0} }

  .hero-tagline {
    max-width: 46ch;
    font-size: clamp(0.82rem, 1.9vw, 0.95rem);
    line-height: 1.65;
    color: var(--color-txt-dim);
    margin-bottom: 1.75rem;
  }
  .hero-tagline .hl {
    color: var(--color-txt-main);
    font-weight: 500;
  }

  .hero-meta {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    margin-bottom: 1.75rem;
    flex-wrap: wrap;
  }

  .location {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-txt-dim);
  }

  .badge-avail {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #22c55e;
    border: 1px solid rgba(34,197,94,0.28);
    padding: 0.2rem 0.625rem;
    border-radius: 999px;
  }

  .badge-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #22c55e;
    animation: pdot 2s ease-in-out infinite;
  }
  @keyframes pdot {
    0%,100% { box-shadow: 0 0 0 0 rgba(34,197,94,0.4); }
    50%      { box-shadow: 0 0 0 4px rgba(34,197,94,0); }
  }

  .hero-cta {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 2rem;
  }

  /* ── STATS ─────────────────────────────────────── */
  .stats-strip {
