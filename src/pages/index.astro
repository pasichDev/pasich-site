  /* ── Play ─────────────────────────────────────── */
  .play { display: grid; grid-template-columns: 1fr auto; gap: 40px; align-items: center; }
  .play__copy h2 { margin-top: 16px; font-size: clamp(34px, 4.4vw, 72px); font-weight: 800; }
