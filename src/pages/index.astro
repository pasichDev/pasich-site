---
import BaseLayout from '../layouts/BaseLayout.astro';
import StatCard from '../components/ui/StatCard.astro';
import ProjectCard from '../components/ui/ProjectCard.astro';

const stats = [
  { icon: 'solar:code-circle-linear', value: '5+', label: 'Years Exp' },
  { icon: 'solar:folder-with-files-linear', value: '10+', label: 'Projects' },
  { icon: 'solar:smartphone-linear', value: 'Android', label: 'Native' },
  { icon: 'solar:layers-minimalistic-linear', value: 'Flutter', label: 'Cross-Plat' }
];

const projects = [
  {
    icon: 'solar:chart-square-linear',
    title: 'Skinlytics',
    description: 'Master your CS2 inventory with professional analytics and Steam Market tracking. Get real-time profit insights.',
    tags: ['React', 'Next.js', 'Express', 'Tailwind'],
    href: 'https://skinlytics.pro/'
  },
  {
    icon: 'solar:notebook-linear',
    title: 'My Notes',
    description: 'Offline-first Android notebook. Custom rich-text editor, local encryption, Room database, and zero tracking.',
    tags: ['Kotlin', 'Room', 'MVVM'],
    href: '/apps/mynotes'
  },
  {
    icon: 'solar:wallet-linear',
    title: 'SovaWallet',
    description: 'NosoCoin ecosystem wallet. Complex cryptographic implementation, unstable node balancing, and custom binary protocols.',
    tags: ['Flutter', 'Dart FFI', 'Crypto'],
    href: 'https://github.com/Noso-Project/NosoSova'
  },
  {
    icon: 'solar:devices-linear',
    title: 'Linqora',
    description: 'Seamless PC-Mobile integration. Control media, monitor resources, and transfer files via WebSocket/mDNS.',
    tags: ['Go', 'Flutter', 'WebSocket'],
    href: 'https://github.com/pasichDev/linqora'
  }
];

const techStack = {
  mobile: [
    'Android SDK',
    'Kotlin (primary)',
    'Jetpack Compose',
    'Java (legacy)',
    'Flutter / Dart '
  ],
  backend: [
    'Go (basic REST APIs)',
    'Node.js (Express)',
    'Firebase'
  ],
  web: [
    'TypeScript',
    'React / Next.js',
    'Tailwind CSS'
  ],
  tools: [
    'Git (GitHub)',
    'Docker (basic)',
    'CI/CD (GitHub Actions – basic)'
  ]
}


const structuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Andrii Pasichnyk",
  "alternateName": "pasichDev",
  "url": "https://pasichdev.xyz",
  "jobTitle": "Mobile Developer",
  "knowsAbout": ["Android", "Flutter", "Kotlin", "Dart", "Go"],
  "sameAs": [
    "https://github.com/pasichDev",
    "https://t.me/pasichdev"
  ]
};
---

<BaseLayout 
  title="pasichDev — Android & Flutter Engineer"
  description="Mobile Developer focused on clean architecture and performance. Building Android and Flutter apps with precision."
  structuredData={structuredData}
>
  <div class="container animate-fade-in">
    
    <!-- Hero -->
    <header class="section" style="margin-top: 3rem; margin-bottom: 6rem;">
      <div class="badge badge-pulse mb-6">
        Open to work
      </div>
      
      <h1 class="tracking-tight mb-6" style="background: linear-gradient(to bottom, #fff, rgba(255,255,255,0.5)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; line-height: 1.1;">
        Building mobile experiences<br>
        with precision & code.
      </h1>
      
      <p class="text-lg text-dim leading-relaxed" style="max-width: 36rem;">
       I’m Andrii Pasichnyk. I build Android & Flutter apps with clean architecture, native performance, and a strong focus on real user experience.</p>
      
      <div class="flex gap-4 mt-8 flex-wrap">
        <a href="/cv" class="btn btn-primary">
          View Resume
          <iconify-icon icon="solar:user-id-linear"></iconify-icon>
        </a>
        <a href="#contact" class="btn btn-outline">Contact Me</a>
      </div>
    </header>
    
    <!-- Stats Grid -->
    <section class="section grid-4" style="margin-bottom: 6rem;">
      {stats.map((stat) => (
        <StatCard {...stat} />
      ))}
    </section>
    
    
    <!-- Projects -->
    <section class="section" id="projects">
      <div class="section-header">
        <h2 class="font-medium tracking-tight">Selected Work</h2>
        <span class="section-counter">01 — 04</span>
      </div>
      
      <div class="grid-2">
        {projects.map((project) => (
          <ProjectCard {...project} />
        ))}
      </div>
    </section>
    
    <!-- Tech Stack -->
    <section class="section">
      <div class="section-header" style="border-bottom: 1px solid var(--color-border); padding-bottom: 1rem; margin-bottom: 2rem;">
        <h2 class="font-medium tracking-tight">Technology</h2>
      </div>
      
      <div class="tech-grid">
        <div>
          <h4 class="text-xs font-mono text-dim uppercase tracking-wide mb-4">Mobile</h4>
          <ul class="list-check">
            {techStack.mobile.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        
        <div>
          <h4 class="text-xs font-mono text-dim uppercase tracking-wide mb-4">Backend / CLI</h4>
          <ul class="list-check">
            {techStack.backend.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        
        <div>
          <h4 class="text-xs font-mono text-dim uppercase tracking-wide mb-4">Web</h4>
          <ul class="list-check">
            {techStack.web.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        
        <div>
          <h4 class="text-xs font-mono text-dim uppercase tracking-wide mb-4">Tools</h4>
          <ul class="list-check">
            {techStack.tools.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>
    </section>
    
  </div>
</BaseLayout>

<style>
  .tech-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }
  
  @media (min-width: 768px) {
    .tech-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
