  .manifesto { padding-block: clamp(120px, 16vw, 240px); }
  .manifesto__text { max-width: 22ch; color: var(--color-txt-main); font-weight: 600; font-size: clamp(34px, 5.4vw, 92px); line-height: 1; letter-spacing: -.01em; font-stretch: 112%; font-variation-settings: 'wdth' 112; }
  .manifesto__stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-top: clamp(70px, 9vw, 140px); border-top: 1px solid var(--color-border); color: var(--color-txt-dim); }
  .manifesto__stats div { padding-top: 16px; }
  .manifesto__stats b { display: block; margin-top: 8px; color: var(--color-txt-main); font: 700 clamp(40px, 4.6vw, 76px)/1 var(--font-sans); letter-spacing: 0; }

  /* ── Work: vertical scroll drives a horizontal track ─ */
  .work { position: relative; height: 640vh; }
  .work__pin { position: sticky; top: 0; height: 100svh; overflow: hidden; overflow: clip; display: grid; grid-template-rows: auto 1fr auto; }
  .work__head { display: flex; justify-content: space-between; align-items: end; padding-top: calc(var(--nav-height) + 12px); padding-bottom: 22px; }
  .work__head h2 { font-size: clamp(28px, 3vw, 46px); font-weight: 800; }
  .work__track { display: flex; gap: 22px; padding: 0 var(--pad); will-change: transform; }
  .panel { position: relative; flex: none; display: grid; grid-template-columns: 1fr 1.1fr; width: min(78vw, 1180px); height: 100%; overflow: hidden; border-radius: 6px; }
  .panel__copy { position: relative; z-index: 2; display: grid; align-content: space-between; padding: clamp(22px, 3vw, 44px); }
  .panel__name { margin-top: 14px; font-size: clamp(50px, 7vw, 128px); font-weight: 800; line-height: .82; letter-spacing: -.02em; }
  .panel__copy p { max-width: 34ch; margin-top: 18px; font-size: 17px; color: inherit; opacity: .8; }
  .panel__meta { display: flex; justify-content: space-between; align-items: end; gap: 16px; }
  .panel__go { display: inline-flex; align-items: center; height: 42px; padding: 0 18px; border: 1px solid currentColor; border-radius: 99px; white-space: nowrap; transition: background .3s, color .3s; }
  .panel__go:hover { background: currentColor; }
  .panel__go:hover, .panel a.panel__go:hover { color: var(--pbg); }
  .panel__visual { position: relative; }
  .shot { position: absolute; width: 42%; height: auto; border-radius: 18px; box-shadow: 0 30px 70px rgba(0,0,0,.45); transition: transform .9s var(--ease); }
  .panel:hover .shot:nth-child(1) { transform: translateY(-14px) rotate(-3deg); }
  .panel:hover .shot:nth-child(2) { transform: translateY(10px) rotate(2deg); }
  .work__bar { display: flex; align-items: center; gap: 18px; padding-block: 22px; color: var(--color-txt-dim); }
  .work__bar .rail { position: relative; flex: 1; height: 1px; background: var(--color-border); }
  .work__bar .rail i { position: absolute; inset: 0; background: var(--color-accent); transform: scaleX(0); transform-origin: left; will-change: transform; }

  .panel { background: var(--pbg); }
  .panel--encly { --pbg: #9a4524; color: #f4e8da; }
  .panel--felisca { --pbg: #11131b; color: #e6e8f1; box-shadow: inset 0 0 0 1px rgba(255,255,255,.06); }
