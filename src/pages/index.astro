    .manifesto__stats { grid-template-columns: 1fr 1fr; }
    .work { height: auto; }
    .work__pin { position: static; height: auto; display: block; }
    .work__track { flex-direction: column; transform: none !important; }
    .panel { width: 100%; height: auto; grid-template-columns: 1fr; }
    .panel__visual { height: 380px; }
    .panel__meta { flex-wrap: wrap; margin-top: 26px; }
    .work__bar { display: none; }
    .kernel__grid, .kernel__notes { grid-template-columns: 1fr; }
    .log { grid-template-columns: 1fr; gap: 4px; }
    .stack { grid-template-columns: 1fr 1fr; }
    .tool-row { grid-template-columns: 1fr; gap: 8px; }
    .play { grid-template-columns: 1fr; }
    .ttt-board { grid-template-columns: repeat(3, 84px); grid-template-rows: repeat(3, 84px); }
  }
  @media (max-width: 520px) { .stack { grid-template-columns: 1fr; } }
