---
import BaseLayout from '../layouts/BaseLayout.astro';
import GitHubHeatmap from '../components/ui/GitHubHeatmap.astro';

const skillGroups = [
  {
    label: 'Networking & VPN',
    skills: [
      { name: 'WireGuard',       level: 'expert',   tooltip: 'wireguard-go, WireGuard-NT and the Linux kernel module — tunnels on Android, iOS, macOS, Windows and routers' },
      { name: 'P2P & NAT',       level: 'advanced', tooltip: 'Direct device-to-device connections instead of a relay' },
      { name: 'Split DNS',       level: 'advanced', tooltip: 'Split DNS and LAN bypass, so a full tunnel keeps the home router and NAS reachable' },
      { name: 'TCP/IP & UDP',    level: 'advanced', tooltip: 'Sockets, MTU, routing and packet paths' },
      { name: 'iptables',        level: 'advanced', tooltip: 'Firewall and NAT rules on Linux' },
      { name: 'gRPC / Protobuf', level: 'advanced', tooltip: 'Typed APIs between services and clients' },
    ],
  },
  {
    label: 'Systems & Embedded',
    skills: [
      { name: 'C++',              level: 'expert',   tooltip: 'Native services and libraries — memory, concurrency, low-level control' },
      { name: 'C',                level: 'advanced', tooltip: 'Kernel code and native libraries' },
      { name: 'Linux Kernel',     level: 'advanced', tooltip: 'WireGuard patch that doubled throughput on a single-core router, plus a leak fix sent to netdev' },
      { name: 'Yocto / BitBake',  level: 'advanced', tooltip: 'Recipes, layers, cross-compilation and systemd for embedded Linux images' },
      { name: 'Windows Services', level: 'expert',   tooltip: 'SYSTEM service on WireGuard-NT — named pipes, DPAPI, no admin prompts for the app' },
      { name: 'Win32 / CNG',      level: 'advanced', tooltip: 'Native Windows APIs and crypto' },
      { name: 'Profiling',        level: 'advanced', tooltip: 'Finding where the time actually goes — down to context switches per packet' },
    ],
  },
  {
    label: 'Backend & Data',
    skills: [
      { name: 'Go',                 level: 'expert',   tooltip: 'Backend services, a P2P core and a shared VPN data plane' },
      { name: 'cgo / gomobile',     level: 'advanced', tooltip: 'One Go core shared with C++, Flutter and mobile apps' },
      { name: 'REST API',           level: 'expert',   tooltip: 'API design, versioning, auth' },
      { name: 'WebSocket',          level: 'advanced', tooltip: 'Real-time transport between devices and services' },
      { name: 'PostgreSQL',         level: 'advanced', tooltip: 'Schemas, queries and migrations for backend services' },
      { name: 'SQLite',             level: 'advanced', tooltip: 'Embedded storage from Go — pure-Go driver for static binaries, or via cgo' },
      { name: 'Encryption at rest', level: 'advanced', tooltip: 'Authenticated encryption of sensitive fields (AEAD)' },
    ],
  },
  {
    label: 'Mobile & Desktop',
    skills: [
      { name: 'Flutter',          level: 'expert',   tooltip: 'Apps and platform plugins for Android, iOS, macOS and Windows — Bloc, Riverpod' },
      { name: 'Dart',             level: 'expert',   tooltip: 'Async, isolates, FFI into C++ libraries' },
      { name: 'Kotlin',           level: 'expert',   tooltip: 'Android — VpnService, Coroutines, Hilt, Room, WorkManager' },
      { name: 'Swift',            level: 'advanced', tooltip: 'iOS and macOS — Network Extension, Keychain' },
      { name: 'Java',             level: 'expert',   tooltip: 'Android and JVM — legacy code, Kotlin interop, JNI' },
      { name: 'Jetpack Compose',  level: 'advanced', tooltip: 'Declarative UI — layouts, theming, state, animations' },
      { name: 'Offline-first',    level: 'expert',   tooltip: 'Room with migrations, SQLCipher, local-only data' },
    ],
  },
  {
    label: 'Infra & Practices',
    skills: [
      { name: 'AWS',             level: 'advanced', tooltip: 'Deploying and running backend services on AWS' },
      { name: 'GitLab CI',       level: 'advanced', tooltip: 'Pipelines and release builds' },
      { name: 'GitHub Actions',  level: 'advanced', tooltip: 'Build, test and deploy workflows' },
      { name: 'Firebase',        level: 'advanced', tooltip: 'Push notifications, auth and analytics' },
      { name: 'Architecture',    level: 'advanced', tooltip: 'Clean Architecture, MVVM, decisions on how services and apps fit together' },
      { name: 'Code Review',     level: 'advanced', tooltip: 'Reviewing Flutter and Go projects' },
    ],
  },
  {
    label: 'Web',
    skills: [
      { name: 'React',      level: 'advanced', tooltip: 'Components, hooks, context, routing' },
      { name: 'Next.js',    level: 'advanced', tooltip: 'SSR and SSG — App Router, API routes' },
      { name: 'TypeScript', level: 'advanced', tooltip: 'Typed frontend and backend' },
      { name: 'HTML & CSS', level: 'advanced', tooltip: 'Grid/Flexbox, animations, custom styling' },
    ],
  },
];

type Visual = 'shots' | 'notes' | 'hash' | 'disk' | 'link';
const work: Array<{ n: string; kind: string; name: string; text: string; stack: string; href: string; cta: string; external?: boolean; theme: string; visual: Visual; shots?: string[] }> = [
  { n: '01', kind: 'Android', name: 'Encly', theme: 'encly', visual: 'shots',
    text: 'Encrypted notes and tasks. SQLCipher at rest, a PIN with optional biometrics, a 12-word recovery phrase. No internet permission at all.',
    stack: 'Kotlin · Compose · SQLCipher', href: '/apps/encly/', cta: 'Open case',
    shots: ['/assets/apps/encly/screen-1.webp', '/assets/apps/encly/screen-6.webp'] },
  { n: '02', kind: 'Flutter', name: 'Felisca', theme: 'felisca', visual: 'shots',
    text: 'A 30-second check-in for focus, energy and anxiety. Trends and achievements — nothing leaves the phone.',
    stack: 'Flutter · Offline · Biometrics', href: '/apps/felisca/', cta: 'Open case',
    shots: ['/assets/apps/felisca/screen-1.webp', '/assets/apps/felisca/screen-2.webp'] },
  { n: '03', kind: 'Android', name: 'My Notes', theme: 'notes', visual: 'notes',
    text: 'Offline-first notebook. The block-based editor is my own — no third-party editor libraries.',
    stack: 'Kotlin · Room · 30k+ installs', href: '/apps/mynotes/', cta: 'Open case' },
  { n: '04', kind: '2023 – 2024', name: 'Sova', theme: 'sova', visual: 'hash',
    text: 'NosoCoin wallet. Hashing, signatures and the network protocol ported from Pascal to Dart; C++ through FFI where Dart was too slow.',
    stack: 'Flutter · Dart FFI · C++', href: 'https://github.com/Noso-Project/NosoSova', cta: 'GitHub', external: true },
  { n: '05', kind: 'Desktop', name: 'Chystik', theme: 'chystik', visual: 'disk',
    text: 'Safety-first disk cleanup for developers. Finds build caches and stale dependencies, asks before it deletes.',
    stack: 'Rust · egui', href: 'https://pasichdev.github.io/chystik/', cta: 'Website', external: true },
  { n: '06', kind: 'Archived', name: 'Linqora', theme: 'linq', visual: 'link',
    text: 'PC ↔ phone bridge: media control, resource monitoring and file transfer over WebSocket with mDNS discovery.',
    stack: 'Go · Flutter · WebSocket', href: 'https://github.com/pasichDev/linqora', cta: 'GitHub', external: true },
];

const path = [
  { when: '2026.02 → now', who: 'InTallyCon', what: 'WireGuard plugin for Android, iOS, macOS and Windows. One Go data plane on wireguard-go, a P2P core, split DNS and LAN bypass, a C++ SYSTEM service on WireGuard-NT.' },
  { when: '2026', who: 'Linux kernel', what: 'Single-core fast path for WireGuard on a 400 MHz router. A memory-leak fix sent to netdev.' },
  { when: '2023 → 2024', who: 'NosoCoin', what: 'SovaWallet in Flutter. Pascal protocol ported to Dart, C++ through FFI.' },
  { when: '2021 → now', who: 'Own apps', what: 'My Notes, Encly, Felisca. Offline-first, no accounts, no tracking.' },
];

const tools = [
  { href: '/tools/privacy-policy', name: 'Privacy Policy Generator', text: 'A store-ready policy for your mobile app in minutes.' },
  { href: '/tools/icon-generator', name: 'Flutter Icon Generator', text: 'One PNG in, every platform icon out as a ZIP.' },
  { href: '/tools/qr-generator', name: 'QR Code Generator', text: 'Your colours, dot style and logo. PNG or SVG.' },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Andrii Pasichnyk',
  alternateName: 'pasichDev',
  url: 'https://pasichdev.xyz',
  jobTitle: 'Software Engineer',
  knowsAbout: ['Software Architecture', 'C++', 'Rust', 'Windows Services', 'WireGuard', 'Systems Security', 'Go', 'AEAD', 'Android', 'Kotlin', 'Swift', 'Flutter', 'Offline-first'],
  sameAs: ['https://github.com/pasichDev', 'https://t.me/pasichdev'],
};
---

<BaseLayout
  title="pasichDev — Software Engineer"
  description="Software engineer. C++ system services on Windows, Go backends, and mobile apps in Kotlin, Swift and Flutter."
  structuredData={structuredData}
  bleed
>
  <section class="hero" aria-label="Intro">
    <canvas class="hero__flow" data-flow aria-hidden="true"></canvas>
    <p class="hero__tl mono up dim">Rivne · 50.62°N 26.25°E · UTC+2</p>
    <h1 class="hero__name" aria-label="Andrii Pasichnyk">
      <span class="hero__l1 wide" data-scramble aria-hidden="true">Andrii</span>
      <span class="hero__l2 wide outline" data-scramble aria-hidden="true">Pasichnyk</span>
    </h1>
    <p class="hero__term mono dim" aria-hidden="true"><span data-type>$ wg show · peer rivne.ua · handshake ok · rtt 31 ms</span><span class="caret"></span></p>
    <p class="hero__br mono dim">Software engineer. <strong>VPN tunnels, system services, encrypted storage</strong> — and the apps people actually touch on top.</p>
  </section>

  <section class="manifesto shell">
    <p class="manifesto__text"><span data-scramble="view">I build the part</span> <span class="faint" data-scramble="view">you don't see.</span> <span data-scramble="view">Tunnels, services, storage that</span> <span class="amber" data-scramble="view">stays encrypted.</span> <span data-scramble="view">Then</span> <span class="faint" data-scramble="view">an app on top</span> <span data-scramble="view">a person can use.</span></p>
    <div class="manifesto__stats mono up">
      <div class="reveal">Years<b class="wide" data-num="5" data-suffix="+">5+</b></div>
      <div class="reveal">Platforms<b class="wide" data-num="4">4</b></div>
      <div class="reveal">Installs<b class="wide" data-num="30" data-suffix="k+">30k+</b></div>
      <div class="reveal">Languages<b class="wide" data-num="6">6</b></div>
    </div>
  </section>

  <section class="work" id="work" data-hscroll aria-label="Selected work">
    <div class="work__pin">
      <div class="work__head shell"><h2 class="wide">Selected work</h2><span class="mono up dim">Scroll →</span></div>
      <div class="work__track" data-track>
        {work.map((w) => (
          <article class={`panel panel--${w.theme}`}>
            <div class="panel__copy">
              <div>
                <span class="mono up">{w.n} / 06 · {w.kind}</span>
                <h3 class="panel__name wide">{w.name}</h3>
                <p>{w.text}</p>
              </div>
              <div class="panel__meta">
                <span class="mono up">{w.stack}</span>
                <a class="panel__go mono up" href={w.href} {...(w.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>{w.cta} {w.external ? '↗' : '→'}</a>
              </div>
            </div>
            <div class="panel__visual" aria-hidden="true">
              {w.visual === 'shots' && w.shots?.map((src, i) => (
                <img class="shot" src={src} alt="" width="540" height="960" loading="lazy" decoding="async" style={i === 0 ? 'left:8%;top:10%' : 'left:48%;top:22%'} />
              ))}
              {w.visual === 'notes' && (
                <div class="gen-notes">
                  <div><b>Groceries</b><span style="width:70%"></span><span style="width:45%"></span></div>
                  <div><b>Ideas for the weekend</b><span style="width:85%"></span><span style="width:60%"></span><span style="width:30%"></span></div>
                  <div><b>Router notes</b><span style="width:55%"></span></div>
                </div>
              )}
              {w.visual === 'hash' && <div class="gen-hash" data-hash></div>}
              {w.visual === 'disk' && (
                <div class="gen-disk">
                  <div class="cut"><span>node_modules</span><i style="--v:.92"></i><span>14.2 GB</span></div>
                  <div class="cut"><span>target/</span><i style="--v:.71"></i><span>9.8 GB</span></div>
                  <div class="cut"><span>.gradle</span><i style="--v:.48"></i><span>6.1 GB</span></div>
                  <div><span>~/Documents</span><i style="--v:.33"></i><span>keep</span></div>
                  <div><span>~/Photos</span><i style="--v:.58"></i><span>keep</span></div>
                </div>
              )}
              {w.visual === 'link' && (
                <svg class="gen-link" viewBox="0 0 400 400" fill="none" stroke="currentColor">
                  <rect x="40" y="130" width="150" height="100" rx="6" stroke-width="1.5" />
                  <rect x="290" y="110" width="70" height="140" rx="12" stroke-width="1.5" />
                  <path d="M190 180 C 240 180, 240 180, 290 180" stroke-width="1.5" stroke-dasharray="6 6"><animate attributeName="stroke-dashoffset" from="24" to="0" dur=".8s" repeatCount="indefinite" /></path>
                  <circle r="4" fill="currentColor"><animateMotion dur="1.6s" repeatCount="indefinite" path="M190 180 C 240 180, 240 180, 290 180" /></circle>
                  <text x="40" y="270" font-family="IBM Plex Mono" font-size="11" fill="currentColor" stroke="none">_linqora._tcp.local</text>
                </svg>
              )}
            </div>
          </article>
        ))}
      </div>
      <div class="work__bar shell mono up"><span data-work-n>01</span><div class="rail"><i data-rail></i></div><span>06</span></div>
    </div>
  </section>

  <section class="kernel sec" id="kernel">
    <div class="kernel__grid">
      <div>
        <span class="mono up amber">Open source · Linux kernel</span>
        <h2 class="kernel__title">WireGuard on a single&#8209;core, 400&nbsp;MHz router chip.</h2>
      </div>
      <div class="kernel__x narrow" aria-label="two times faster">2.0×</div>
    </div>
    <div class="scope reveal">
      <svg viewBox="0 0 1000 280" preserveAspectRatio="none" aria-hidden="true"><polyline data-trace="a" fill="none" stroke="#8c887f" stroke-width="2" /><polyline data-trace="b" fill="none" stroke="#ffb547" stroke-width="2.5" /></svg>
      <div class="scope__legend mono up"><span><i style="background:#8c887f"></i>Before · 9.4 Mbit/s · 108 ms</span><span class="amber"><i style="background:#ffb547"></i>After · 18.8 Mbit/s · 31 ms</span></div>
    </div>
    <div class="kernel__notes">
      <div class="reveal"><b>Finding</b>The cipher wasn't the bottleneck. Profiling showed a context switch on almost every packet.</div>
      <div class="reveal"><b>Patch</b>Skip WireGuard's multi-core worker queues when the machine has one CPU.</div>
      <div class="reveal"><b>Bonus</b>A memory leak living in the kernel since 2019, fix sent to the netdev list.</div>
    </div>
    <a class="btn btn-outline kernel__repo" href="https://github.com/pasichDev/rtl8196e-wireguard" target="_blank" rel="noopener noreferrer">rtl8196e-wireguard ↗</a>
  </section>

  <section class="sec" id="path">
    <div class="sec-head"><h2 class="wide">Path</h2><a class="mono up dim" href="/cv">Full CV →</a></div>
    {path.map((p) => (
      <div class="log reveal mono"><span class="amber">{p.when}</span><span class="log__who">{p.who}</span><p>{p.what}</p></div>
    ))}
    <div class="activity reveal"><GitHubHeatmap /></div>
  </section>

  <section class="sec" id="stack">
    <div class="sec-head"><h2 class="wide">Stack</h2><span class="mono up dim">Hover for context</span></div>
    <div class="stack">
      {skillGroups.map((g) => (
        <div class="stack__group reveal">
          <h3 class="mono up dim">{g.label}</h3>
          <ul>
            {g.skills.map((s) => <li class:list={[{ 'is-expert': s.level === 'expert' }]} title={s.tooltip}>{s.name}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section class="tools-rows" aria-label="Free tools">
    <div class="sec-head shell"><h2 class="wide">Free tools</h2><a class="mono up dim" href="/tools">All tools →</a></div>
    {tools.map((t) => (
      <a class="tool-row" href={t.href}><h3>{t.name}</h3><p>{t.text}</p><span class="mono up">Open →</span></a>
    ))}
  </section>

  <section class="sec play" id="play">
    <div class="play__copy">
      <span class="mono up amber">Intermission</span>
      <h2 class="wide">Beat the minimax.</h2>
      <p>It never loses. A draw counts as a win.</p>
    </div>
    <div class="ttt">
      <div class="ttt-status mono up" id="ttt-status">Your move — you're X</div>
      <div class="ttt-board-wrap">
        <div class="ttt-board" id="ttt-board">
          {Array.from({ length: 9 }, (_, i) => <button class="ttt-cell" data-i={i} aria-label={`cell ${i + 1}`}></button>)}
        </div>
        <svg class="ttt-line" id="ttt-line" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true"><line x1="0" y1="0" x2="0" y2="0"></line></svg>
      </div>
      <button class="ttt-reset btn btn-outline" id="ttt-reset">↺ New game</button>
    </div>
  </section>
</BaseLayout>

<script>
  // @ts-nocheck — the game below is plain JS carried over from the old page
  const reduceMotion = () => matchMedia('(prefers-reduced-motion: reduce)').matches;
  let stop = [];

  function initFlow() {
    // Packets stream through a tunnel; once past the throat they turn amber — encrypted.
    // Drawn as six batched paths (3 speed buckets × 2 colours) instead of one
    // stroke() per particle: that was ~1000 draw calls a frame.
    const cv = document.querySelector('[data-flow]');
    if (!cv) return;
    const cx = cv.getContext('2d', { alpha: false });
    const BUCKETS = 3;
    const PLAIN = ['rgba(235,231,222,.16)', 'rgba(235,231,222,.25)', 'rgba(235,231,222,.36)'];
    const ENC = ['rgba(255,181,71,.45)', 'rgba(255,181,71,.65)', 'rgba(255,181,71,.85)'];
    let W = 0, H = 0, parts = [], raf = 0, visible = true;
    const mouse = { x: -999, y: -999 };
    const resize = () => {
      const dpr = Math.min(devicePixelRatio || 1, 1.5);
      W = cv.clientWidth; H = cv.clientHeight;
      cv.width = Math.round(W * dpr); cv.height = Math.round(H * dpr); cx.setTransform(dpr, 0, 0, dpr, 0, 0);
      cx.fillStyle = '#09090a'; cx.fillRect(0, 0, W, H);
      const n = Math.round(Math.min(720, (W * H) / 2000));
      parts = Array.from({ length: n }, () => {
        const sp = 0.6 + Math.random() * 1.8;
        return { x: Math.random() * W, lane: Math.random() * 2 - 1, sp, b: Math.min(BUCKETS - 1, Math.floor(((sp - 0.6) / 1.8) * BUCKETS)), len: 4 + Math.random() * 14, ox: 0, oy: 0 };
      });
      kick();
    };
    const laneY = (x, lane, t) => {
      const c = W * 0.52, d = Math.min(1, Math.abs(x - c) / c);
      return H * 0.5 + lane * H * (0.035 + 0.5 * Math.pow(d, 1.7)) + Math.sin(x * 0.004 + t * 0.0006 + lane * 3) * 10 * d;
    };
    const draw = (now) => {
      cx.fillStyle = 'rgba(9,9,10,.34)';
      cx.fillRect(0, 0, W, H);
      const c = W * 0.52, still = reduceMotion(), hasMouse = mouse.x > -500;
      const t = still ? 0 : now;
      let easing = false;
      const paths = Array.from({ length: BUCKETS * 2 }, () => new Path2D());
      for (const p of parts) {
        if (!still) p.x += p.sp;
        if (p.x > W + 20) { p.x = -20; p.lane = Math.random() * 2 - 1; }
        let y = laneY(p.x, p.lane, t);
        if (hasMouse || p.ox || p.oy) {
          const dx = p.x - mouse.x, dy = y - mouse.y, dist = Math.hypot(dx, dy) || 1;
          const push = hasMouse && dist < 140 ? (140 - dist) / 140 : 0;
          const sx = ((dx / dist) * push * 40 - p.ox) * 0.08, sy = ((dy / dist) * push * 40 - p.oy) * 0.08;
          p.ox += sx; p.oy += sy;
          if (Math.abs(sx) > 0.02 || Math.abs(sy) > 0.02) easing = true;
          if (Math.abs(p.ox) < 0.05 && Math.abs(p.oy) < 0.05 && !push) p.ox = p.oy = 0;
        }
        const x = p.x + p.ox; y += p.oy;
        const path = paths[(p.x > c ? BUCKETS : 0) + p.b];
        path.moveTo(x - p.len, laneY(p.x - p.len, p.lane, t) + p.oy);
        path.lineTo(x, y);
      }
      cx.lineWidth = 1;
      for (let i = 0; i < BUCKETS; i++) { cx.strokeStyle = PLAIN[i]; cx.stroke(paths[i]); }
      cx.lineWidth = 1.4;
      for (let i = 0; i < BUCKETS; i++) { cx.strokeStyle = ENC[i]; cx.stroke(paths[BUCKETS + i]); }
      // Reduced motion: nothing drifts, so only keep drawing while particles
      // are still easing around (or back from) the pointer.
      raf = visible && (!still || easing) ? requestAnimationFrame(draw) : 0;
    };
    const kick = () => { if (visible && !raf) raf = requestAnimationFrame(draw); };
    const move = (e) => { const r = cv.getBoundingClientRect(); mouse.x = e.clientX - r.left; mouse.y = e.clientY - r.top; kick(); };
    const leave = () => { mouse.x = mouse.y = -999; kick(); };
    // Don't burn the GPU while the hero is scrolled away
    const io = new IntersectionObserver(([e]) => { visible = e.isIntersecting; cancelAnimationFrame(raf); if (visible) raf = requestAnimationFrame(draw); });
    let resizeTimer = 0;
    const onResize = () => { clearTimeout(resizeTimer); resizeTimer = setTimeout(resize, 150); };
    resize(); io.observe(cv);
    addEventListener('resize', onResize);
    cv.parentElement.addEventListener('pointermove', move);
    cv.parentElement.addEventListener('pointerleave', leave);
    stop.push(() => { cancelAnimationFrame(raf); io.disconnect(); clearTimeout(resizeTimer); removeEventListener('resize', onResize); });
  }

  function initTyping() {
    const el = document.querySelector('[data-type]');
    if (!el) return;
    const full = el.textContent; let i = 0, timer = 0;
    if (reduceMotion()) return;
    el.textContent = '';
    const type = () => { el.textContent = full.slice(0, ++i); if (i < full.length) timer = setTimeout(type, 28 + Math.random() * 40); };
    timer = setTimeout(type, 1600);
    stop.push(() => clearTimeout(timer));
  }

  function initWork() {
    // Vertical scroll drives the horizontal track. Geometry is measured on
    // resize only; the loop runs while the track is catching up and stops
    // when it settles. Only transforms and (rarely) one counter are written.
    const hs = document.querySelector('[data-hscroll]'), track = document.querySelector('[data-track]');
    const rail = document.querySelector('[data-rail]'), num = document.querySelector('[data-work-n]');
    if (!hs || !track) return;
    const panels = track.children.length;
    let top = 0, span = 1, max = 0, target = 0, cur = 0, raf = 0, shown = '', enabled = false;
    const measure = () => {
      enabled = innerWidth > 860;
      if (!enabled) { track.style.transform = ''; rail.style.transform = ''; return; }
      top = hs.getBoundingClientRect().top + scrollY;
      span = Math.max(1, hs.offsetHeight - innerHeight);
      max = Math.max(0, track.scrollWidth - innerWidth);
    };
    const step = () => {
      cur += (target - cur) * 0.12;
      if (Math.abs(target - cur) < 0.0004 || reduceMotion()) cur = target;
      track.style.transform = `translate3d(${(-cur * max).toFixed(1)}px,0,0)`;
      rail.style.transform = `scaleX(${cur.toFixed(4)})`;
      const n = String(Math.min(panels, 1 + Math.floor(cur * panels * 0.999))).padStart(2, '0');
      if (n !== shown) { shown = n; num.textContent = n; }
      raf = cur === target ? 0 : requestAnimationFrame(step);
    };
    const onScroll = () => {
      if (!enabled) return;
      target = Math.min(1, Math.max(0, (scrollY - top) / span));
      if (!raf) raf = requestAnimationFrame(step);
    };
    let resizeTimer = 0;
    const onResize = () => { clearTimeout(resizeTimer); resizeTimer = setTimeout(() => { measure(); onScroll(); }, 150); };
    measure();
    target = cur = enabled ? Math.min(1, Math.max(0, (scrollY - top) / span)) : 0;
    if (enabled) step();
    // Tabbing to a link on an off-screen panel: the browser would scroll the
    // clipped pin sideways on top of our transform. Undo that and scroll the
    // page to where the panel is in view instead.
    const pin = track.parentElement;
    const onPinScroll = () => { if (pin.scrollLeft) pin.scrollLeft = 0; };
    const onFocus = (e) => {
      if (!enabled) return;
      const panel = e.target.closest('.panel');
      if (!panel) return;
      pin.scrollLeft = 0;
      const x = panel.offsetLeft - (innerWidth - panel.offsetWidth) / 2;
      const p = max ? Math.min(1, Math.max(0, x / max)) : 0;
      scrollTo({ top: top + p * span, behavior: 'instant' });
      target = cur = p;
      step();
    };
    pin.addEventListener('scroll', onPinScroll);
    track.addEventListener('focusin', onFocus);
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onResize);
    // Images and fonts change the track width after first paint
    addEventListener('load', onResize, { once: true });
    document.fonts?.ready.then(onResize);
    stop.push(() => { cancelAnimationFrame(raf); clearTimeout(resizeTimer); removeEventListener('scroll', onScroll); removeEventListener('resize', onResize); pin.removeEventListener('scroll', onPinScroll); track.removeEventListener('focusin', onFocus); });

    const hash = document.querySelector('[data-hash]');
    if (hash) {
      const hex = () => [...crypto.getRandomValues(new Uint8Array(32))].map((b) => b.toString(16).padStart(2, '0')).join('');
      const fill = () => { hash.innerHTML = Array.from({ length: 18 }, (_, i) => (i === 7 ? `<em>${hex()}</em>` : hex())).join('<br>'); };
      fill();
      let timer = 0;
      // Only rains while the panel is on screen
      const io = new IntersectionObserver(([e]) => { clearInterval(timer); if (e.isIntersecting) timer = setInterval(fill, 900); });
      io.observe(hash);
      stop.push(() => { clearInterval(timer); io.disconnect(); });
    }
  }

  function initScope() {
    const a = document.querySelector('[data-trace="a"]'), b = document.querySelector('[data-trace="b"]');
    if (!a || !b) return;
    let phase = 0, raf = 0, visible = false;
    const pts = (base, noise, spikes) => Array.from({ length: 101 }, (_, i) => {
      const s = i + phase * 0.5;
      const n = Math.sin(s * 0.9) * noise + Math.sin(s * 2.3) * noise * 0.5 + (Math.sin(s * 7.1) > 0.93 ? spikes : 0);
      return `${i * 10},${(280 - base * 12 + n).toFixed(1)}`;
    }).join(' ');
    const draw = () => {
      if (!reduceMotion()) phase += 1;
      a.setAttribute('points', pts(9.4, 9, 40));
      b.setAttribute('points', pts(18.8, 4, 8));
      raf = visible && !reduceMotion() ? requestAnimationFrame(draw) : 0;
    };
    draw();
    const io = new IntersectionObserver(([e]) => { visible = e.isIntersecting; cancelAnimationFrame(raf); if (visible) raf = requestAnimationFrame(draw); });
    io.observe(a.ownerSVGElement);
    stop.push(() => { cancelAnimationFrame(raf); io.disconnect(); });
  }

  function initTTT() {
    const boardEl  = document.getElementById('ttt-board');
    const statusEl = document.getElementById('ttt-status');
    const resetEl  = document.getElementById('ttt-reset');
    if (!boardEl || !statusEl || !resetEl) return;

    const HU = 'X', AI = 'O';
    const LINES = [[0,1,2],[3,4,5],[6,7,8],[0,3,6],[1,4,7],[2,5,8],[0,4,8],[2,4,6]];
    const cells = Array.from(boardEl.querySelectorAll('.ttt-cell'));
    const lineSvg = document.getElementById('ttt-line');
    const lineEl = lineSvg ? lineSvg.querySelector('line') : null;
    let board, over, aiTimer = 0;
    stop.push(() => clearTimeout(aiTimer));

    const COORDS = {
      '0,1,2': [8,16.7,92,16.7], '3,4,5': [8,50,92,50], '6,7,8': [8,83.3,92,83.3],
      '0,3,6': [16.7,8,16.7,92], '1,4,7': [50,8,50,92], '2,5,8': [83.3,8,83.3,92],
      '0,4,8': [12,12,88,88], '2,4,6': [88,12,12,88],
    };

    const winInfo = (b) => {
      for (const L of LINES) { const [a,c,d] = L; if (b[a] && b[a] === b[c] && b[a] === b[d]) return { mark: b[a], line: L }; }
      return null;
    };
    const winner = (b) => { const w = winInfo(b); return w ? w.mark : null; };
    const full = (b) => b.every(Boolean);

    function drawLine(combo, mark) {
      if (!lineEl) return;
      const [x1,y1,x2,y2] = COORDS[combo.join(',')];
      lineEl.setAttribute('x1', x1); lineEl.setAttribute('y1', y1);
      lineEl.setAttribute('x2', x2); lineEl.setAttribute('y2', y2);
      const len = Math.hypot(x2 - x1, y2 - y1);
      lineEl.style.stroke = mark === HU ? 'var(--color-txt-main)' : 'var(--color-accent)';
      lineEl.style.transition = 'none';
      lineEl.style.strokeDasharray = len;
      lineEl.style.strokeDashoffset = len;
      lineSvg.classList.add('show');
      void lineEl.getBoundingClientRect();
      lineEl.style.transition = 'stroke-dashoffset 0.5s cubic-bezier(0.4,0,0.2,1)';
      lineEl.style.strokeDashoffset = '0';
    }
    function clearLine() {
      if (!lineSvg) return;
      lineSvg.classList.remove('show');
      if (lineEl) { lineEl.style.transition = 'none'; lineEl.style.strokeDashoffset = ''; lineEl.style.strokeDasharray = ''; }
    }

    // minimax with depth so it prefers faster wins / slower losses
    function minimax(b, player, depth) {
      const w = winner(b);
      if (w === AI) return { score: 10 - depth };
      if (w === HU) return { score: depth - 10 };
      if (full(b))  return { score: 0 };
      let best = null;
      for (let i = 0; i < 9; i++) {
        if (!b[i]) {
          b[i] = player;
          const score = minimax(b, player === AI ? HU : AI, depth + 1).score;
          b[i] = '';
          if (best === null ||
             (player === AI && score > best.score) ||
             (player === HU && score < best.score)) best = { i, score };
        }
      }
      return best;
    }

    const render = () => cells.forEach((c, i) => {
      c.textContent = board[i] || '';
      c.classList.toggle('x', board[i] === HU);
      c.classList.toggle('o', board[i] === AI);
      c.disabled = over || !!board[i];
    });

    function finish() {
      const info = winInfo(board);
      if (info) {
        over = true;
        drawLine(info.line, info.mark);
        statusEl.textContent = info.mark === HU ? 'You win — how?!' : 'AI wins';
      } else if (full(board)) {
        over = true;
        statusEl.textContent = 'Draw — well played';
      }
      if (over) render();
      return over;
    }

    function aiMove() {
      statusEl.textContent = 'AI thinking…';
      cells.forEach((c) => c.disabled = true);
      clearTimeout(aiTimer);
      aiTimer = setTimeout(() => {
        const { i } = minimax(board.slice(), AI, 0);
        board[i] = AI;
        if (!finish()) { statusEl.textContent = "Your move — you're X"; render(); }
      }, 260);
    }

    function reset() {
      clearTimeout(aiTimer);
      board = Array(9).fill('');
      over = false;
      clearLine();
      statusEl.textContent = "Your move — you're X";
      render();
    }

    boardEl.onclick = (e) => {
      const cell = e.target.closest('.ttt-cell');
      if (!cell || over) return;
      const i = Number(cell.dataset.i);
      if (board[i]) return;
      board[i] = HU;
      render();
      if (!finish()) aiMove();
    };
    resetEl.onclick = reset;
    reset();
  }

  document.addEventListener('astro:page-load', () => {
    if (!document.querySelector('[data-flow]')) return;
    initFlow(); initTyping(); initWork(); initScope(); initTTT();
  });
  document.addEventListener('astro:before-swap', () => { stop.forEach((fn) => fn()); stop = []; });
</script>

<style>
  /* ── Hero ─────────────────────────────────────── */
  .hero { position: relative; height: 100svh; min-height: 620px; overflow: hidden; }
  .hero__flow { position: absolute; inset: 0; width: 100%; height: 100%; }
  .hero__tl { position: absolute; left: var(--pad); top: calc(var(--nav-height) + 6px); }
  .hero__name { position: absolute; inset: 0; display: grid; grid-template-rows: 1fr auto auto 1fr; padding: 0 var(--pad); margin: 0; pointer-events: none; font-size: clamp(54px, 11.4vw, 210px); font-weight: 800; line-height: .82; letter-spacing: -.02em; }
  .hero__l1 { grid-row: 2; }
  .hero__l2 { grid-row: 3; justify-self: end; }
  .hero__term { position: absolute; left: var(--pad); bottom: 28px; max-width: calc(100% - 2 * var(--pad)); }
  .hero__br { position: absolute; right: var(--pad); bottom: 28px; max-width: 420px; text-align: right; }
