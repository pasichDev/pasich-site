  .panel--linq { --pbg: #171c2c; color: #c8d1f2; }

  .gen-notes { position: absolute; inset: 9% 8% 9% 10%; display: grid; gap: 12px; align-content: start; }
  .gen-notes div { padding: 18px; border-radius: 12px; background: #f6f2e9; box-shadow: 0 10px 30px rgba(40,30,10,.08); }
  .gen-notes b { display: block; font-size: 22px; font-weight: 700; }
  .gen-notes span { display: block; height: 8px; margin-top: 10px; border-radius: 4px; background: #dcd5c5; }
  .gen-hash { position: absolute; inset: 8% 6%; overflow: hidden; font: 400 13px/1.7 var(--font-mono); color: rgba(232,220,174,.45); word-break: break-all; mask-image: linear-gradient(transparent, #000 20%, #000 80%, transparent); }
