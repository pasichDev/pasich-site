  .gen-disk i { height: 22px; background: #120f0a; transform-origin: left; transform: scaleX(var(--v)); }
  .gen-disk .cut i { background: repeating-linear-gradient(45deg, #120f0a 0 6px, transparent 6px 12px); }
  .gen-link { position: absolute; inset: 0; width: 100%; height: 100%; }

  /* ── Kernel ───────────────────────────────────── */
  .kernel__grid { display: grid; grid-template-columns: 5fr 7fr; gap: clamp(30px, 5vw, 80px); align-items: end; }
  .kernel__title { margin-top: 18px; font-size: clamp(40px, 5vw, 84px); font-weight: 700; line-height: .95; font-stretch: 110%; font-variation-settings: 'wdth' 110; }
  .kernel__x { color: var(--color-accent); font-size: clamp(140px, 22vw, 380px); font-weight: 900; line-height: .78; letter-spacing: -.03em; }
  .scope { position: relative; margin-top: 40px; border: 1px solid var(--color-border); background: linear-gradient(var(--color-border) 1px, transparent 1px) 0 0 / 100% 25%, linear-gradient(90deg, var(--color-border) 1px, transparent 1px) 0 0 / 10% 100%; }
  .scope svg { display: block; width: 100%; height: 280px; }
  .scope__legend { display: flex; flex-wrap: wrap; gap: 10px 24px; padding: 12px 16px; border-top: 1px solid var(--color-border); color: var(--color-txt-dim); }
  .scope__legend i { display: inline-block; width: 18px; height: 2px; margin-right: 8px; vertical-align: 3px; }
  .kernel__notes { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 60px; }
  .kernel__notes div { padding-top: 14px; border-top: 1px solid var(--color-border); color: var(--color-txt-dim); font-size: 15px; }
  .kernel__notes b { display: block; margin-bottom: 8px; color: var(--color-txt-main); font: 500 12px var(--font-mono); text-transform: uppercase; letter-spacing: .1em; }
  .kernel__repo { margin-top: 40px; }

  /* ── Path / activity ──────────────────────────── */
  .log { display: grid; grid-template-columns: 170px 220px 1fr; gap: 20px; padding: 18px 0; border-bottom: 1px dashed var(--color-border); font-size: 13px; }
  .log__who { color: var(--color-txt-main); font-weight: 500; }
  .log p { color: var(--color-txt-dim); }
  .activity { margin-top: 60px; }

  /* ── Stack ────────────────────────────────────── */
  .stack { display: grid; grid-template-columns: repeat(3, 1fr); gap: 44px 30px; }
  .stack__group h3 { padding-bottom: 12px; margin-bottom: 14px; border-bottom: 1px solid var(--color-border); font-size: 12px; font-weight: 500; }
  .stack__group ul { list-style: none; display: grid; gap: 6px; }
  .stack__group li { width: fit-content; color: var(--color-txt-dim); font-size: 19px; font-weight: 500; cursor: help; transition: color .2s; }
  .stack__group li.is-expert { color: var(--color-txt-main); }
  .stack__group li.is-expert::after { content: ' ●'; color: var(--color-accent); font-size: 9px; vertical-align: 4px; }
  .stack__group li:hover { color: var(--color-accent); }

  /* ── Tools ────────────────────────────────────── */
  .tools-rows { padding-top: clamp(80px, 11vw, 170px); border-top: 1px solid var(--color-border); }
  .tool-row { position: relative; display: grid; grid-template-columns: 1fr 1.2fr auto; align-items: center; gap: 20px; padding: 28px var(--pad); border-top: 1px solid var(--color-border); overflow: hidden; isolation: isolate; }
  .tool-row:last-child { border-bottom: 1px solid var(--color-border); }
  .tool-row::before { content: ''; position: absolute; inset: 0; z-index: -1; background: var(--color-accent); transform: scaleX(0); transform-origin: right; transition: transform .6s var(--ease); }
