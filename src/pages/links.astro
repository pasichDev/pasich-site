---
import BaseLayout from '../layouts/BaseLayout.astro';
import data from '../data/links.json';

const { profile, primary, groups, seo } = data;

const allLinks = [...primary, ...groups.flatMap((g) => g.items)];

const isExternal = (url: string) => url.startsWith('http');

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  alternateName: 'pasichDev',
  jobTitle: profile.role,
  image: 'https://pasichdev.xyz' + profile.avatarFallback,
  url: 'https://pasichdev.xyz/links',
  sameAs: allLinks.filter((l) => isExternal(l.url)).map((l) => l.url),
};
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  structuredData={structuredData}
  hideNav={true}
  hideFooter={true}
  bleed
>
  <div class="lk">
    <header class="lk-head">
      <div class="lk-head__top mono up">
        <a href="/" class="lk-home">pasichdev<span class="amber">.</span>xyz</a>
        {profile.available && <span class="badge badge-pulse">Available</span>}
      </div>

      <div class="lk-id">
        <picture class="lk-avatar">
          <source srcset={profile.avatar} type="image/webp" />
          <img decoding="async" fetchpriority="high" src={profile.avatarFallback} alt={profile.name} width="400" height="400" fetchpriority="high" />
        </picture>
        <div>
          <h1 class="lk-name wide" aria-label={profile.name}>
            {profile.name.split(' ').map((part, i) => (
              <span class:list={[{ outline: i > 0 }]} data-scramble aria-hidden="true">{part}</span>
            ))}
          </h1>
          <p class="lk-role mono up"><span class="amber">{profile.role}</span><span>{profile.location}</span></p>
        </div>
      </div>
      <p class="lk-bio">{profile.bio}</p>
    </header>

    <nav class="lk-primary" aria-label="Main links">
      {primary.map((link, i) => (
        <a
          href={link.url}
          target={isExternal(link.url) ? '_blank' : '_self'}
          rel={isExternal(link.url) ? 'noopener noreferrer' : undefined}
          class="lk-big reveal"
        >
          <span class="mono up lk-big__n">{String(i + 1).padStart(2, '0')}</span>
          <span class="lk-big__title wide">{link.title}</span>
          <span class="lk-big__sub mono">{link.subtitle}</span>
          <span class="lk-arrow" aria-hidden="true">{isExternal(link.url) ? '↗' : '→'}</span>
        </a>
      ))}
    </nav>

    {groups.map((group) => (
      <section class="lk-group" aria-labelledby={`lk-${group.num}`}>
        <h2 class="lk-group__label mono up" id={`lk-${group.num}`}><span class="amber">{group.num}</span> — {group.label}</h2>
        <nav class="lk-rows" aria-label={group.label}>
          {group.items.map((link) => (
            <a
              href={link.url}
              target={isExternal(link.url) ? '_blank' : '_self'}
              rel={isExternal(link.url) ? 'noopener noreferrer' : undefined}
              class="lk-row reveal"
            >
              <span class="lk-row__title">{link.title}</span>
              <span class="lk-row__sub">{link.subtitle}</span>
              <span class="lk-row__tags">
                {link.tags && link.tags.map((t) => <span class="tag">{t}</span>)}
              </span>
              <span class="lk-arrow" aria-hidden="true">{isExternal(link.url) ? '↗' : '→'}</span>
            </a>
          ))}
        </nav>
      </section>
    ))}

    <footer class="lk-foot mono up dim">
      <a href="/">← pasichDev.xyz</a>
      <span>Rivne · UTC+2</span>
    </footer>
  </div>
</BaseLayout>

<style>
  .lk { min-height: 100vh; }
  .lk-head { padding: 22px var(--pad) clamp(50px, 7vw, 100px); border-bottom: 1px solid var(--color-border); }
  .lk-head__top { display: flex; justify-content: space-between; align-items: center; margin-bottom: clamp(60px, 10vw, 140px); }
  .lk-home { color: var(--color-txt-main); }
  .lk-id { display: flex; align-items: center; gap: clamp(18px, 3vw, 44px); }
  .lk-avatar { flex: none; width: clamp(84px, 11vw, 170px); aspect-ratio: 1; overflow: hidden; border-radius: 50%; outline: 1px solid var(--color-accent); outline-offset: 6px; }
  .lk-avatar img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(.25) contrast(1.05); }
  .lk-name { display: grid; font-size: clamp(38px, 8.2vw, 138px); font-weight: 800; line-height: .84; letter-spacing: -.02em; }
  .lk-role { display: flex; flex-wrap: wrap; gap: 6px 22px; margin-top: 18px; color: var(--color-txt-dim); }
  .lk-bio { max-width: 40ch; margin-top: clamp(28px, 4vw, 50px); color: var(--color-txt-main); font-size: clamp(20px, 2.1vw, 30px); line-height: 1.25; font-weight: 500; }

  /* Rows: an amber sheet sweeps in from the left on hover */
  .lk-big, .lk-row { position: relative; isolation: isolate; overflow: hidden; display: grid; align-items: center; gap: 20px; padding-inline: var(--pad); border-bottom: 1px solid var(--color-border); transition: color .3s; }
  .lk-big::before, .lk-row::before { content: ''; position: absolute; inset: 0; z-index: -1; background: var(--color-accent); transform: scaleX(0); transform-origin: right; transition: transform .6s var(--ease); }
  .lk-big:hover, .lk-row:hover, .lk-big:focus-visible, .lk-row:focus-visible { color: var(--color-accent-ink); }
  .lk-big:hover::before, .lk-row:hover::before, .lk-big:focus-visible::before, .lk-row:focus-visible::before { transform: none; transform-origin: left; }
  .lk-arrow { justify-self: end; font: 400 clamp(22px, 2.4vw, 34px)/1 var(--font-mono); transition: transform .5s var(--ease); }
  .lk-big:hover .lk-arrow, .lk-row:hover .lk-arrow { transform: translate(4px, -4px); }

  .lk-big { grid-template-columns: 60px 1fr auto 60px; padding-block: clamp(26px, 3.4vw, 46px); }
  .lk-big__n { color: var(--color-accent); transition: color .3s; }
  .lk-big:hover .lk-big__n { color: var(--color-accent-ink); }
  .lk-big__title { font-size: clamp(30px, 5vw, 84px); font-weight: 800; line-height: .9; }
  .lk-big__sub { color: var(--color-txt-dim); transition: color .3s; }
  .lk-big:hover .lk-big__sub { color: rgba(18,15,10,.7); }

  .lk-group { padding-top: clamp(60px, 8vw, 110px); }
  .lk-group__label { padding: 0 var(--pad) 16px; color: var(--color-txt-dim); font-size: 12px; font-weight: 500; border-bottom: 1px solid var(--color-border); }
  .lk-row { grid-template-columns: minmax(150px, 1fr) 1.4fr auto 40px; padding-block: 22px; }
  .lk-row__title { font-size: clamp(22px, 2.6vw, 38px); font-weight: 700; line-height: 1; font-stretch: 115%; font-variation-settings: 'wdth' 115; }
  .lk-row__sub { color: var(--color-txt-dim); transition: color .3s; }
  .lk-row:hover .lk-row__sub { color: rgba(18,15,10,.72); }
  .lk-row__tags { display: flex; flex-wrap: wrap; justify-content: end; gap: 6px; }
  .lk-row:hover .tag { color: var(--color-accent-ink); border-color: rgba(18,15,10,.4); }

  .lk-foot { display: flex; justify-content: space-between; gap: 20px; padding: clamp(60px, 8vw, 110px) var(--pad) 30px; }
  .lk-foot a:hover { color: var(--color-accent); }

  @media (max-width: 860px) {
    .lk-big { grid-template-columns: 40px 1fr 30px; }
    .lk-big__sub { grid-column: 2; grid-row: 2; }
    .lk-big .lk-arrow { grid-column: 3; grid-row: 1; }
    .lk-row { grid-template-columns: 1fr 30px; gap: 6px 16px; }
    .lk-row__title { grid-column: 1; }
    .lk-row .lk-arrow { grid-column: 2; grid-row: 1; }
    .lk-row__sub, .lk-row__tags { grid-column: 1 / -1; }
    .lk-row__tags { justify-content: start; }
  }
  @media (max-width: 520px) {
    .lk-id { flex-direction: column; align-items: flex-start; }
    .lk-name { font-size: 10.2vw; }
  }
</style>
