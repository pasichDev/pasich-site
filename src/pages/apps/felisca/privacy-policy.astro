---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Privacy Policy - Felisca"
  description="Privacy Policy for Felisca app. Learn how we protect your wellbeing data with complete offline storage."
  canonical="https://pasichdev.xyz/apps/felisca/privacy-policy"
>
  <div class="container container-sm animate-fade-in">
    
    <!-- Header -->
    <header class="privacy-hero">
      <div class="icon-shield">
        <iconify-icon icon="solar:shield-check-bold" width="48"></iconify-icon>
      </div>
      <h1 class="text-accent" style="font-size: 2.5rem; font-weight: 700; margin-bottom: 1rem;">Privacy Policy</h1>
      <p class="text-lg text-dim">
        Your privacy is our priority. Learn how we protect your data and ensure complete confidentiality in Felisca.
      </p>
      <div class="flex gap-2 mt-6 flex-wrap justify-center">
        <span class="badge badge-purple">
          <iconify-icon icon="solar:check-circle-bold"></iconify-icon> Local storage
        </span>
        <span class="badge badge-purple">
          <iconify-icon icon="solar:lock-bold"></iconify-icon> Offline first
        </span>
        <span class="badge badge-purple">
          <iconify-icon icon="solar:eye-closed-bold"></iconify-icon> No tracking
        </span>
      </div>
      <p class="text-sm text-dim" style="margin-top: 2rem;">
        <strong>Last updated:</strong> February 4, 2026
      </p>
    </header>
    
    <!-- Key Points -->
    <section class="key-points">
      <div class="point-card">
        <div class="point-icon">
          <iconify-icon icon="solar:smartphone-linear" width="28"></iconify-icon>
        </div>
        <h4 class="font-medium text-accent mb-2">Local Storage</h4>
        <p class="text-sm text-dim">All your mood data and notes are stored exclusively on your device in a protected SQLite database. We have no access to your content.</p>
      </div>
      
      <div class="point-card">
        <div class="point-icon">
          <iconify-icon icon="solar:forbidden-linear" width="28"></iconify-icon>
        </div>
        <h4 class="font-medium text-accent mb-2">No Cloud Sync</h4>
        <p class="text-sm text-dim">We do not use cloud servers to store your history. We do not transmit your data to third parties.</p>
      </div>
      
      <div class="point-card">
        <div class="point-icon">
          <iconify-icon icon="solar:user-check-linear" width="28"></iconify-icon>
        </div>
        <h4 class="font-medium text-accent mb-2">Complete Anonymity</h4>
        <p class="text-sm text-dim">The app works offline and does not require creating an account, registration, or personal identification.</p>
      </div>
    </section>
    
    <!-- Policy Content -->
    <div class="policy-content">
      
      <section class="policy-section">
        <div class="section-icon">
          <iconify-icon icon="solar:database-linear" width="24"></iconify-icon>
        </div>
        <h3 class="font-medium text-accent mb-4">1. Data Collection & Storage</h3>
        <p class="text-dim leading-relaxed">
          All data you enter into the app (focus metrics, energy levels, anxiety levels, notes, sleep data, and caffeine intake) are stored <strong class="text-accent">exclusively locally</strong> on your device in a protected SQLite database.
        </p>
        <ul class="data-list">
          <li><iconify-icon icon="solar:check-circle-bold" class="text-accent"></iconify-icon> We have no access to your data</li>
          <li><iconify-icon icon="solar:check-circle-bold" class="text-accent"></iconify-icon> We do not use cloud servers for storing your history</li>
          <li><iconify-icon icon="solar:check-circle-bold" class="text-accent"></iconify-icon> We do not transmit your data to third parties</li>
        </ul>
      </section>
      
      <section class="policy-section">
        <div class="section-icon">
          <iconify-icon icon="solar:save-linear" width="24"></iconify-icon>
        </div>
        <h3 class="font-medium text-accent mb-4">2. Data Backup & Portability</h3>
        <p class="text-dim leading-relaxed">
          Since data is stored locally, you are fully responsible for it. The app provides an export feature in CSV format, allowing you to:
        </p>
        <ul class="data-list">
          <li><iconify-icon icon="solar:check-circle-bold" class="text-accent"></iconify-icon> Create manual backups</li>
          <li><iconify-icon icon="solar:check-circle-bold" class="text-accent"></iconify-icon> Transfer data to another device</li>
          <li><iconify-icon icon="solar:check-circle-bold" class="text-accent"></iconify-icon> Analyze your data with external tools</li>
        </ul>
      </section>

      <section class="policy-section">
        <div class="section-icon">
          <iconify-icon icon="solar:bug-linear" width="24"></iconify-icon>
        </div>
        <h3 class="font-medium text-accent mb-4">3. Analytics & Error Reporting</h3>
        <p class="text-dim leading-relaxed">
          To improve app stability, we use <strong class="text-accent">Sentry</strong> for collecting anonymous crash reports. These reports:
        </p>
        <ul class="data-list">
          <li><iconify-icon icon="solar:check-circle-bold" class="text-accent"></iconify-icon> Do not contain your personal data or journal entries</li>
          <li><iconify-icon icon="solar:check-circle-bold" class="text-accent"></iconify-icon> Help us identify and fix technical issues only</li>
          <li><iconify-icon icon="solar:check-circle-bold" class="text-accent"></iconify-icon> Are completely anonymous</li>
        </ul>
      </section>

      <section class="policy-section">
        <div class="section-icon">
          <iconify-icon icon="solar:key-linear" width="24"></iconify-icon>
        </div>
        <h3 class="font-medium text-accent mb-4">4. App Permissions</h3>
        <p class="text-dim leading-relaxed mb-3">
          Felisca may request the following permissions:
        </p>
        
        <div class="permission-item">
          <h5 class="font-medium text-accent" style="display: flex; align-items: center; gap: 0.5rem;">
            <iconify-icon icon="solar:bell-linear" width="20"></iconify-icon>
            Notifications
          </h5>
          <p class="text-sm text-dim">For sending daily check-in reminders.</p>
        </div>

        <div class="permission-item">
          <h5 class="font-medium text-accent" style="display: flex; align-items: center; gap: 0.5rem;">
            <iconify-icon icon="solar:fingerprint-linear" width="20"></iconify-icon>
            Biometrics
          </h5>
          <p class="text-sm text-dim">For protecting app access via FaceID or fingerprint authentication.</p>
        </div>

        <div class="permission-item">
          <h5 class="font-medium text-accent" style="display: flex; align-items: center; gap: 0.5rem;">
            <iconify-icon icon="solar:folder-linear" width="20"></iconify-icon>
            File System
          </h5>
          <p class="text-sm text-dim">Exclusively for saving (export) or reading (import) CSV files at your request.</p>
        </div>
      </section>

      <section class="policy-section">
        <div class="section-icon">
          <iconify-icon icon="solar:chat-linear" width="24"></iconify-icon>
        </div>
        <h3 class="font-medium text-accent mb-4">5. Contact Us</h3>
        <p class="text-dim leading-relaxed">
          If you have questions or suggestions for improving Felisca, you can send us feedback through the app or contact the developer directly via email.
        </p>
      </section>

      <!-- Summary Card -->
      <section class="summary-card">
        <div class="summary-content">
          <h3 class="text-accent" style="margin-bottom: 1rem;">
            <iconify-icon icon="solar:heart-bold" width="24"></iconify-icon>
            Your Wellbeing, Your Data
          </h3>
          <p class="text-dim">
            Felisca is built on the principle that your feelings, focus levels, and energy data are your personal business. They should never leave your device, never be sold, and never be tracked. We respect your privacy completely.
          </p>
          <p class="text-sm text-dim" style="margin-top: 1rem;">
            © 2026 Felisca Team. All data belongs to you.
          </p>
        </div>
      </section>

    </div>

    <!-- Navigation Links -->
    <div class="nav-links" style="margin-top: 3rem; padding-top: 2rem; border-top: 1px solid rgba(255, 255, 255, 0.1);">
      <a href="/apps/felisca" class="back-link">
        <iconify-icon icon="solar:arrow-left-linear" width="16"></iconify-icon>
        Back to Felisca
      </a>
    </div>
  </div>
</BaseLayout>

<style>
  .privacy-hero {
    text-align: center;
    padding: 3rem 0;
  }

  .icon-shield {
    display: flex;
    justify-content: center;
    margin-bottom: 1.5rem;
    opacity: 0.8;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 500;
  }

  .key-points {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.5rem;
    margin: 3rem 0;
  }

  .point-card {
    padding: 1.5rem;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 12px;
    transition: all 0.3s ease;
  }

  .point-card:hover {
    background: rgba(255, 255, 255, 0.04);
    border-color: rgba(255, 255, 255, 0.1);
  }

  .point-icon {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 40px;
    height: 40px;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 8px;
    margin-bottom: 1rem;
    color: var(--color-accent);
  }

  .policy-content {
    padding: 2rem 0;
  }

  .policy-section {
    margin-bottom: 2.5rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .policy-section:last-of-type {
    border-bottom: none;
  }

  .section-icon {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    width: 36px;
    height: 36px;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 8px;
    margin-bottom: 1rem;
    color: var(--color-accent);
  }

  .data-list {
    list-style: none;
    padding: 0;
    margin-top: 1rem;
  }

  .data-list li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
    color: var(--color-txt-dim);
  }

  .data-list iconify-icon {
    flex-shrink: 0;
  }

  .permission-item {
    padding: 1rem;
    background: rgba(255, 255, 255, 0.02);
    border-left: 2px solid rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    margin-bottom: 1rem;
  }

  .summary-card {
    margin-top: 2rem;
    padding: 2rem;
    background: rgba(255, 255, 255, 0.03);
    border-left: 3px solid var(--color-accent);
    border-radius: 8px;
  }

  .summary-content h3 {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .nav-links {
    display: flex;
    gap: 1rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    font-size: 0.875rem;
    font-weight: 500;
    transition: all 0.3s ease;
    color: var(--color-accent);
  }

  .back-link:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.2);
    gap: 0.75rem;
  }

  .flex {
    display: flex;
  }

  .justify-center {
    justify-content: center;
  }

  .mb-2 {
    margin-bottom: 0.5rem;
  }

  .mb-4 {
    margin-bottom: 1rem;
  }

  .mt-6 {
    margin-top: 1.5rem;
  }

  .gap-2 {
    gap: 0.5rem;
  }

  .leading-relaxed {
    line-height: 1.75;
  }

  @media (max-width: 768px) {
    .privacy-hero {
      padding: 2rem 0;
    }

    .key-points {
      grid-template-columns: 1fr;
    }

    .summary-card {
      padding: 1.5rem;
    }
  }
</style>
