---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Felisca - Coming Soon"
  description="Felisca - Your personal mood and wellbeing tracker. Coming soon with complete offline privacy."
  canonical="https://pasichdev.xyz/apps/felisca"
>
  <div class="container container-sm animate-fade-in">
    <div class="coming-soon-section">
      <!-- Header -->
      <div class="coming-soon-header">
        <div class="coming-soon-icon">
          <iconify-icon icon="mdi:rocket" width="64"></iconify-icon>
        </div>
        <h1 class="text-accent" style="font-size: 2.5rem; font-weight: 700; margin-bottom: 1rem;">
          Felisca
        </h1>
        <p class="text-lg text-dim" style="margin-bottom: 2rem;">
          Your personal wellbeing tracker. Complete privacy. All data stays on your device.
        </p>
        
        <!-- Coming Soon Badge -->
        <div class="coming-soon-badge">
          <iconify-icon icon="solar:hourglass-linear"></iconify-icon>
          <span>Coming Soon</span>
        </div>
      </div>

      <!-- Features Preview -->
      <section class="features-preview" style="margin-top: 4rem;">
        <h2 class="text-accent" style="font-size: 1.5rem; margin-bottom: 2rem; text-align: center;">
          What's Coming
        </h2>
        
        <div class="features-grid">
          <div class="feature-preview">
            <div class="feature-icon">
              <iconify-icon icon="mdi:chart-line" width="32"></iconify-icon>
            </div>
            <h3 class="text-accent">Mood Tracking</h3>
            <p class="text-sm text-dim">Monitor your focus, energy, and anxiety levels throughout the day.</p>
          </div>

          <div class="feature-preview">
            <div class="feature-icon">
              <iconify-icon icon="mdi:lock" width="32"></iconify-icon>
            </div>
            <h3 class="text-accent">Complete Privacy</h3>
            <p class="text-sm text-dim">All data stored locally on your device. No cloud, no tracking, no sync.</p>
          </div>

          <div class="feature-preview">
            <div class="feature-icon">
              <iconify-icon icon="mdi:download" width="32"></iconify-icon>
            </div>
            <h3 class="text-accent">Data Export</h3>
            <p class="text-sm text-dim">Export your data as CSV for backup or analysis whenever you need.</p>
          </div>

          <div class="feature-preview">
            <div class="feature-icon">
              <iconify-icon icon="mdi:bell" width="32"></iconify-icon>
            </div>
            <h3 class="text-accent">Smart Reminders</h3>
            <p class="text-sm text-dim">Get daily check-in notifications to maintain consistent tracking habits.</p>
          </div>

          <div class="feature-preview">
            <div class="feature-icon">
              <iconify-icon icon="mdi:fingerprint" width="32"></iconify-icon>
            </div>
            <h3 class="text-accent">Biometric Security</h3>
            <p class="text-sm text-dim">Protect your sensitive wellbeing data with FaceID or fingerprint.</p>
          </div>

          <div class="feature-preview">
            <div class="feature-icon">
              <iconify-icon icon="mdi:chart-box" width="32"></iconify-icon>
            </div>
            <h3 class="text-accent">Insights & Analytics</h3>
            <p class="text-sm text-dim">Understand patterns in your wellbeing and make informed decisions.</p>
          </div>
        </div>
      </section>

      <!-- Privacy Notice -->
      <section class="privacy-notice" style="margin-top: 4rem;">
        <div class="notice-card">
          <div class="notice-icon">
            <iconify-icon icon="mdi:shield-check" width="24"></iconify-icon>
          </div>
          <div>
            <h3 class="text-accent" style="margin-bottom: 0.5rem;">Your Privacy is Our Priority</h3>
            <p class="text-sm text-dim">
              Felisca is designed as a completely offline app. Your feelings, focus levels, and energy data are your personal business and should never leave your device.
            </p>
            <a href="/apps/felisca/privacy-policy" class="read-policy-link">
              Read full Privacy Policy
              <iconify-icon icon="mdi:arrow-right" width="16"></iconify-icon>
            </a>
          </div>
        </div>
      </section>

      <!-- Call to Action -->
      <section class="cta-section" style="margin-top: 3rem; text-align: center;">
        <p class="text-dim" style="margin-bottom: 1.5rem;">
          Join us in reimagining personal data privacy
        </p>
        <div class="flex gap-4 justify-center flex-wrap">
          <a href="/" class="btn btn-primary">
            Back to Home
          </a>
          <a href="/apps/felisca/privacy-policy" class="btn btn-secondary">
            Privacy Policy
          </a>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .coming-soon-section {
    padding: 4rem 0;
  }

  .coming-soon-header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .coming-soon-icon {
    display: flex;
    justify-content: center;
    margin-bottom: 2rem;
    opacity: 0.8;
    transition: transform 0.3s ease;
  }

  .coming-soon-icon:hover {
    transform: translateY(-4px);
  }

  .coming-soon-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1.5rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 24px;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-accent);
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .feature-preview {
    padding: 1.5rem;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 12px;
    transition: all 0.3s ease;
  }

  .feature-preview:hover {
    background: rgba(255, 255, 255, 0.04);
    border-color: rgba(255, 255, 255, 0.1);
    transform: translateY(-4px);
  }

  .feature-icon {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 48px;
    height: 48px;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 8px;
    margin-bottom: 1rem;
    color: var(--color-accent);
  }

  .feature-preview h3 {
    margin-bottom: 0.5rem;
  }

  .notice-card {
    display: flex;
    gap: 1.5rem;
    padding: 2rem;
    background: rgba(255, 255, 255, 0.03);
    border-left: 3px solid var(--color-accent);
    border-radius: 8px;
  }

  .notice-icon {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 40px;
    height: 40px;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 8px;
    flex-shrink: 0;
    color: var(--color-accent);
  }

  .read-policy-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1rem;
    color: var(--color-accent);
    font-size: 0.875rem;
    font-weight: 500;
    transition: gap 0.3s ease;
  }

  .read-policy-link:hover {
    gap: 0.75rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1.5rem;
    border-radius: 8px;
    font-size: 0.875rem;
    font-weight: 500;
    transition: all 0.3s ease;
    border: none;
    cursor: pointer;
    text-decoration: none;
  }

  .btn-primary {
    background: var(--color-accent);
    color: var(--color-bg);
  }

  .btn-primary:hover {
    opacity: 0.9;
    transform: translateY(-2px);
  }

  .btn-secondary {
    background: transparent;
    color: var(--color-accent);
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.3);
  }

  @media (max-width: 768px) {
    .coming-soon-section {
      padding: 2rem 0;
    }

    .notice-card {
      flex-direction: column;
      gap: 1rem;
    }

    .features-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
