---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AppMotion from '../../../components/ui/AppMotion.astro';
import { Icon } from 'astro-icon/components';
import '../../../styles/app-page.css';

const playUrl = 'https://play.google.com/store/apps/details?id=com.pasichdev.felisca';

const screens = [
  { src: '/assets/apps/felisca/screen-1.webp', alt: 'Check-in Screen', title: 'Quick Check-in', text: 'Log your mood in 30 seconds - focus, energy, and anxiety levels' },
  { src: '/assets/apps/felisca/screen-2.webp', alt: 'Dashboard Screen', title: 'Pulse Dashboard', text: 'Powerful analytics with trends and intelligent insights' },
  { src: '/assets/apps/felisca/screen-4.webp', alt: 'Achievements Screen', title: 'Achievements', text: 'Gamification system: unlock 14 achievements and build habits' },
];
---

<BaseLayout
  title="Felisca - Your Personal Mental Companion"
  description="Felisca - An innovative app for monitoring your mental state, focus, and energy with complete privacy. Offline-first, Privacy-first."
  canonical="https://pasichdev.xyz/apps/felisca"
  bleed
>
  <div class="app app--felisca">

    <header class="app-hero" data-parallax>
      <div class="app-hero__copy">
        <div>
          <nav class="app-hero__crumbs mono up" aria-label="Breadcrumbs"><a href="/">pasichdev</a><a href="/#work">Work</a><span>Felisca</span></nav>
          <img class="app-hero__icon" src="/assets/apps/felisca/felisca-icon.webp" alt="Felisca Logo" width="96" height="96" />
          <h1>
            <span class="app-hero__name wide" data-scramble>Felisca</span>
            <span class="app-hero__tagline">Your Personal Mental Companion</span>
          </h1>
          <p class="app-hero__lede">
            An innovative mobile app for deep monitoring of your mental state, focus, and energy with complete privacy.
          </p>
        </div>
        <div class="app-hero__foot">
          <div class="app-chips">
            <span class="app-chip">Offline-first</span>
            <span class="app-chip">Privacy-first</span>
            <span class="app-chip">Flutter</span>
          </div>
          <div class="app-cta-row">
            <a class="app-btn" href={playUrl} target="_blank" rel="noopener noreferrer"><Icon name="mdi:google-play" />Download on Google Play</a>
          </div>
        </div>
      </div>
      <div class="app-hero__visual" aria-hidden="true">
        <img decoding="async" class="app-shot" data-speed="-0.06" src="/assets/apps/felisca/screen-2.webp" alt="" width="540" height="1131" style="left:4%;top:16%" />
        <img fetchpriority="high" decoding="async" class="app-shot" data-speed="0.08" src="/assets/apps/felisca/screen-1.webp" alt="" width="540" height="1131" style="left:32%;top:4%;z-index:2" />
        <img decoding="async" class="app-shot" data-speed="-0.12" src="/assets/apps/felisca/screen-5.webp" alt="" width="540" height="1131" style="left:60%;top:24%" />
      </div>
    </header>

    <section class="app-sec" id="screens">
      <div class="sec-head"><h2 class="wide">App Screens</h2><span class="app-count mono up">01 — 03</span></div>
      <div class="screens" style="--screens: 3">
        {screens.map((s, i) => (
          <figure class="screen reveal">
            <img src={s.src} alt={s.alt} width="540" height="1131" loading="lazy" decoding="async" />
            <figcaption>
              <span class="mono up">{String(i + 1).padStart(2, '0')}</span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section class="app-sec" id="features">
      <div class="sec-head"><h2 class="wide">Key Features</h2><span class="app-count mono up">01 — 03</span></div>

      <article class="feat reveal">
        <span class="feat__n mono up">01</span>
        <h3 class="feat__title">Quick Check-in</h3>
        <div class="feat__body">
          <p>The core of Felisca - log your mental state in just 30 seconds with three intuitive sliders.</p>
          <ul>
            <li><strong>3 Core Metrics:</strong> <span class="metric metric--focus">Focus Level</span>, <span class="metric metric--energy">Energy Level</span>, <span class="metric metric--anxiety">Anxiety Level</span></li>
            <li><strong>Context Tags:</strong> Sleep hours and caffeine intake for better correlations</li>
            <li><strong>Notes:</strong> Add thoughts and observations with multi-line text support</li>
            <li><strong>Instant Feedback:</strong> Loading states and custom SnackBar confirmation</li>
          </ul>
        </div>
      </article>

      <article class="feat reveal">
        <span class="feat__n mono up">02</span>
        <h3 class="feat__title">Pulse Dashboard</h3>
        <div class="feat__body">
          <p>Comprehensive analytics dashboard to understand your wellbeing patterns and trends.</p>
          <ul>
            <li><strong>Time Filters:</strong> Switch between Today, Week, and Month views</li>
            <li><strong>Radial Stats:</strong> Beautiful circular cards showing average metrics</li>
            <li><strong>Dynamic Charts:</strong> Line graphs visualizing your emotional journey</li>
            <li><strong>Smart Insights:</strong> AI-powered correlations (e.g., "When you sleep 7+ hours, focus is 20% higher")</li>
            <li><strong>History Feed:</strong> Collapsible cards showing past entries grouped by date</li>
            <li><strong>Social Sharing:</strong> Generate beautiful report images for social media</li>
          </ul>
        </div>
      </article>

      <article class="feat reveal">
        <span class="feat__n mono up">03</span>
        <h3 class="feat__title">Achievements System</h3>
        <div class="feat__body">
          <p>Gamification to motivate consistent tracking and habit formation with 14 unique rewards.</p>
          <ul>
            <li><strong>Achievement Grid:</strong> 14 unlockable badges with beautiful animations</li>
            <li><strong>Visual Feedback:</strong> Locked achievements appear grayed out, unlocked ones glow with gold accents</li>
            <li><strong>Confetti Celebrations:</strong> Explosive confetti animation when you unlock a new achievement</li>
            <li><strong>Detail View:</strong> Bottom sheet with descriptions, large icons, and share capabilities</li>
          </ul>
        </div>
      </article>
    </section>

    <section class="app-sec privacy" id="privacy">
      <div class="privacy__grid">
        <div class="reveal">
          <h2 class="privacy__title wide">Privacy is Our Priority</h2>
          <p class="privacy__lede">
            Felisca is built as a completely offline-first app. Your emotions, focus levels, and energy data are personal and should never leave your device.
          </p>
          <a href="/apps/felisca/privacy-policy" class="privacy__link mono up">Read our full Privacy Policy →</a>
        </div>
        <ul class="privacy__list">
          <li class="reveal"><span class="mono up">01</span><div><h3>Local Storage</h3><p>Everything stays on your device</p></div></li>
          <li class="reveal"><span class="mono up">02</span><div><h3>No Sync Required</h3><p>No cloud, no tracking, no servers</p></div></li>
          <li class="reveal"><span class="mono up">03</span><div><h3>Biometric Security</h3><p>FaceID or Fingerprint protection</p></div></li>
        </ul>
      </div>
    </section>

    <section class="app-cta">
      <h2 class="wide">Start Tracking Your Wellbeing</h2>
      <p>Download Felisca today and take control of your mental health with complete privacy.</p>
      <div class="app-cta-row">
        <a href={playUrl} target="_blank" rel="noopener noreferrer" class="app-btn">
          <Icon name="mdi:google-play" />
          Download on Google Play
        </a>
        <a href="/apps/felisca/privacy-policy" class="app-btn app-btn--ghost">
          Privacy Policy
        </a>
      </div>
    </section>

    <nav class="app-links mono up" aria-label="Felisca links">
      <a href="/apps/felisca/privacy-policy">Privacy Policy →</a>
    </nav>
  </div>
  <AppMotion />
</BaseLayout>

<style>
  .app--felisca {
    --brand: #11131b;
    --brand-ink: #e6e8f1;
    --brand-accent: #36d39b;
    --name-fit: 6.8;
    --name-fit-sm: 13;
  }
  /* Dark brand on a dark page: give the panels an edge, and the name its mint */
  .app--felisca :global(.app-hero), .app--felisca :global(.app-cta) { box-shadow: inset 0 0 0 1px rgba(255, 255, 255, .07); }
  .app--felisca :global(.app-hero__name), .app--felisca :global(.app-cta h2) { color: #36d39b; }
  .app--felisca :global(.app-btn) { --brand-ink: #36d39b; }
  .app--felisca :global(.app-shot) { box-shadow: 0 0 0 1px rgba(255, 255, 255, .09), 0 40px 80px rgba(0, 0, 0, .55); }

  .metric { white-space: nowrap; }
  .metric::before { content: ''; display: inline-block; width: 8px; height: 8px; margin-right: 6px; border-radius: 50%; vertical-align: 1px; }
  .metric--focus::before { background: #36d39b; }
  .metric--energy::before { background: #fbbf24; }
  .metric--anxiety::before { background: #f87171; }

  .privacy__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(30px, 6vw, 100px); padding-top: 40px; border-top: 1px solid var(--color-border); }
  .privacy__title { font-size: clamp(34px, 4.4vw, 72px); font-weight: 800; line-height: .92; }
  .privacy__lede { max-width: 44ch; margin-top: 22px; font-size: 18px; }
  .privacy__link { display: inline-block; margin-top: 28px; color: var(--brand-accent); }
  .privacy__link:hover { color: var(--color-txt-main); }
  .privacy__list { list-style: none; border-top: 1px solid var(--color-border); }
  .privacy__list li { display: grid; grid-template-columns: 50px 1fr; gap: 16px; padding: 24px 0; border-bottom: 1px solid var(--color-border); }
  .privacy__list .mono { color: var(--brand-accent); padding-top: 6px; }
  .privacy__list h3 { font-size: 24px; font-weight: 700; }
  .privacy__list p { margin-top: 4px; }
  @media (max-width: 900px) { .privacy__grid { grid-template-columns: 1fr; } }
</style>
