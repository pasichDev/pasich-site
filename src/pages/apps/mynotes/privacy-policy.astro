---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import DocToc from '../../../components/ui/DocToc.astro';
import '../../../styles/policy-page.css';

const toc = [
  { id: 'general', label: 'General Information' },
  { id: 'collect', label: 'What Data We Collect' },
  { id: 'storage', label: 'Data Storage' },
  { id: 'permissions', label: 'App Permissions' },
  { id: 'sharing', label: 'We DO NOT share your data' },
  { id: 'security', label: 'Data Security' },
  { id: 'children', label: 'Child Protection' },
  { id: 'updates', label: 'Policy Updates' },
  { id: 'contact', label: 'Contact Us' },
];
---

<BaseLayout
  title="Privacy Policy - My Notes"
  description="Privacy Policy for My Notes app. Learn how we protect your data and ensure privacy."
  canonical="https://pasichdev.xyz/apps/mynotes/privacy-policy"
  bleed
>
  <header class="page-hero pp-hero">
    <nav class="page-hero__crumbs mono up" aria-label="Breadcrumbs"><a href="/">pasichdev</a><span><a href="/apps/mynotes/">My Notes</a></span><span>Privacy Policy</span></nav>
    <p class="pp-hero__app mono up">My Notes</p>
    <h1 class="wide" data-scramble>Privacy Policy</h1>
    <p class="page-hero__lede">
      Your privacy is our priority. Learn how we protect your data and ensure complete confidentiality in My Notes app.
    </p>
    <div class="page-hero__meta mono up">
      <span class="pp-badge">Local storage</span>
      <span class="pp-badge">Data encryption</span>
      <span class="pp-badge">No tracking</span>
      <span class="pp-date">Last updated: August 30, 2025</span>
    </div>
  </header>

  <div class="doc">
    <DocToc items={toc} />

    <article class="doc__body">

      <div class="pp-keys">
        <div class="pp-key">
          <h3>Local Storage</h3>
          <p>All your notes are stored exclusively on your device. We have no access to your content.</p>
        </div>
        <div class="pp-key">
          <h3>No Data Collection</h3>
          <p>We do not collect, store or transfer your personal data to third parties.</p>
        </div>
        <div class="pp-key">
          <h3>Complete Anonymity</h3>
          <p>The app works offline and does not require creating an account or registration.</p>
        </div>
      </div>

      <h2 id="general">General Information</h2>
      <p>
        This Privacy Policy describes how the <strong>"My Notes"</strong> app (developed by pasichDev) processes user information. We strive to ensure the highest level of privacy and security for your data.
      </p>
      <p class="pp-small"><strong>Last updated:</strong> August 30, 2025</p>

      <h2 id="collect">What Data We Collect</h2>
      <div class="pp-items">
        <div class="pp-item">
          <h3>Personal Data</h3>
          <p><strong>We DO NOT collect</strong> your personal data such as name, email, phone number or address.</p>
        </div>
        <div class="pp-item">
          <h3>Note Content</h3>
          <p><strong>We DO NOT have access</strong> to the content of your notes. All data is stored locally on your device.</p>
        </div>
        <div class="pp-item">
          <h3>Usage Data</h3>
          <p><strong>We DO NOT track</strong> how you use the app or which features you use.</p>
        </div>
      </div>

      <h2 id="storage">Data Storage</h2>
      <div class="pp-items">
        <div class="pp-item">
          <h3>Local Database</h3>
          <p>All your notes are stored in local SQLite database on your Android device.</p>
        </div>
        <div class="pp-item">
          <h3>Backup</h3>
          <p>Backup functionality creates a file on your device that you can save yourself.</p>
        </div>
      </div>

      <h2 id="permissions">App Permissions</h2>
      <div class="pp-items">
        <div class="pp-item">
          <h3>Storage Access</h3>
          <p>Used for creating and restoring backups of your notes.</p>
          <p class="pp-small">This permission is used exclusively for backup functionality</p>
        </div>
      </div>

      <h2 id="sharing">We DO NOT share your data</h2>
      <p class="doc__callout">
        My Notes does not transfer, sell or provide access to your data to third parties, including advertising networks, analytics services or other companies.
      </p>

      <h2 id="security">Data Security</h2>
      <div class="pp-items">
        <div class="pp-item">
          <h3>Encryption</h3>
          <p>Data is stored using built-in Android security mechanisms.</p>
        </div>
        <div class="pp-item">
          <h3>App Isolation</h3>
          <p>App data is not accessible to other programs on your device.</p>
        </div>
        <div class="pp-item">
          <h3>Offline Operation</h3>
          <p>The app works without internet connection.</p>
        </div>
        <div class="pp-item">
          <h3>Data Deletion</h3>
          <p>When deleting the app, all data is automatically removed from the device.</p>
        </div>
      </div>

      <h2 id="children">Child Protection</h2>
      <p>
        My Notes app is safe for children to use. We do not collect personal data from users of any age, including children under 13.
      </p>

      <h2 id="updates">Policy Updates</h2>
      <p>
        We may update this Privacy Policy from time to time. When making changes, we will update the "last updated" date at the top of this document. We recommend periodically reviewing this page.
      </p>

      <h2 id="contact">Contact Us</h2>
      <p>
        If you have questions about this Privacy Policy or app functionality, you can contact us:
      </p>
      <ul class="pp-contact-list">
        <li>Email: pasichdev@outlook.com</li>
        <li>GitHub: github.com/pasichDev/MyNotes</li>
      </ul>
    </article>
  </div>
</BaseLayout>
