---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import FeatureCard from '../../../components/ui/FeatureCard.astro';

const features = [
  {
    icon: 'solar:pen-new-square-linear',
    title: 'Easy to Use',
    description: 'Intuitive interface allows you to quickly create and edit notes without unnecessary steps.'
  },
  {
    icon: 'solar:tag-linear',
    title: 'Tags',
    description: 'Organize notes by categories for quick access to needed information.'
  },
  {
    icon: 'solar:magnifer-linear',
    title: 'Quick Search',
    description: 'Instantly find needed notes using powerful search functionality.'
  },
  {
    icon: 'solar:cloud-upload-linear',
    title: 'Backup',
    description: 'Your data is always safe thanks to backup and restore functionality.'
  },
  {
    icon: 'solar:palette-linear',
    title: 'Modern Design',
    description: 'Beautiful Material Design interface that\'s pleasant to use every day.'
  },
  {
    icon: 'solar:lock-linear',
    title: 'Privacy',
    description: 'Your notes are stored locally on your device. Complete confidentiality guaranteed.'
  }
];

const structuredData = {
  "@context": "https://schema.org",
  "@type": "MobileApplication",
  "name": "My Notes",
  "alternateName": "My Notes",
  "description": "Simple and convenient app for storing notes, ideas and important details with categories, search and backup.",
  "applicationCategory": "NoteTakingApplication",
  "operatingSystem": "Android",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.6",
    "ratingCount": "250"
  },
  "author": {
    "@type": "Person",
    "name": "pasichDev"
  },
  "publisher": {
    "@type": "Person",
    "name": "pasichDev"
  },
  "datePublished": "2025-08-01",
  "inLanguage": "en",
  "url": "https://pasichdev.xyz/apps/mynotes/",
  "downloadUrl": "https://play.google.com/store/apps/details?id=com.pasich.mynotes",
  "featureList": [
    "Easy to use",
    "Categories for organization",
    "Quick search",
    "Backup",
    "Modern design",
    "Complete privacy"
  ]
};
---

<BaseLayout 
  title="My Notes – Free, Secure, Android | Download from Google Play"
  description="Simple and convenient app for storing your notes and important details. Available on Google Play Store."
  canonical="https://pasichdev.xyz/apps/mynotes/"
  structuredData={structuredData}
>
  <div class="container animate-fade-in">
    
    <!-- Hero Section -->
    <header class="hero-section">
      <div class="hero-content">
        <div class="app-icon-wrapper">
          <div class="app-icon">
            <iconify-icon icon="solar:notebook-bold" width="48"></iconify-icon>
          </div>
        </div>
        
        <h1 class="hero-title">
          <span class="gradient-text">My Notes</span><br>
          <span class="hero-subtitle">Your ideas are always with you</span>
        </h1>
        
        <p class="text-lg text-dim leading-relaxed mx-auto" style="max-width: 32rem;">
          Simple and convenient app for storing notes, ideas and important details. 
          Organize your thoughts with categories, quick search and reliable backup.
        </p>
        
     
        
        <div class="flex gap-2 mt-8 flex-wrap justify-center">
          <span class="badge badge-accent">
            <iconify-icon icon="solar:star-bold"></iconify-icon> Free
          </span>
          <span class="badge badge-accent">
            <iconify-icon icon="solar:shield-check-bold"></iconify-icon> Private
          </span>
          <span class="badge badge-accent">
            <iconify-icon icon="solar:smartphone-bold"></iconify-icon> Android
          </span>
        </div>
      </div>
    </header>
    
    <!-- Features Section -->
    <section id="features" class="section">
      <div class="section-header">
        <h2 class="font-medium tracking-tight">Main Features</h2>
        <span class="section-counter">01 — 06</span>
      </div>
      
      <div class="features-grid">
        {features.map((feature) => (
          <FeatureCard {...feature} />
        ))}
      </div>
    </section>
    
    <!-- Download CTA -->
    <section class="cta-section glass">
      <h2 class="text-xl font-medium text-accent mb-4">Start taking notes today</h2>
      <p class="text-dim mb-8">Download My Notes now and organize your ideas with complete privacy.</p>
      <a href="https://play.google.com/store/apps/details?id=com.pasich.mynotes" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg">
        <iconify-icon icon="logos:google-play-icon" width="20"></iconify-icon>
        Get it on Google Play
      </a>
    </section>
    
    <!-- Links -->
    <footer class="page-links">
      <a href="/apps/mynotes/privacy-policy" class="link-hover">Privacy Policy</a>
      <span class="divider">/</span>
      <a href="https://github.com/pasichDev/MyNotes" target="_blank" rel="noopener noreferrer" class="link-hover flex items-center gap-1">
        <iconify-icon icon="mdi:github"></iconify-icon> GitHub
      </a>
    </footer>
    
  </div>
</BaseLayout>

<style>
  .hero-section {
    text-align: center;
    padding: 4rem 0 6rem;
  }
  
  .hero-content {
    max-width: 42rem;
    margin: 0 auto;
  }
  
  .app-icon-wrapper {
    margin-bottom: 2.5rem;
    display: flex;
    justify-content: center;
  }
  
  .app-icon {
    width: 96px;
    height: 96px;
    background: linear-gradient(135deg, var(--color-border), var(--color-accent));
    padding: 2px;
    border-radius: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-bg);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
    transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  .app-icon iconify-icon {
    background: var(--color-bg);
    color: var(--color-accent);
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 22px;
  }
  
  .app-icon:hover {
    transform: scale(1.05) rotate(5deg);
  }
  
  .hero-title {
    font-size: clamp(2rem, 6vw, 3.5rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.03em;
    margin-bottom: 2rem;
  }

  .hero-subtitle {
    font-size: 0.5em;
    opacity: 0.7;
    font-weight: 400;
    letter-spacing: 0;
  }
  
  .gradient-text {
    background: linear-gradient(to bottom, #fff, rgba(255,255,255,0.7));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .mx-auto {
    margin-left: auto;
    margin-right: auto;
  }
  
  .badge-accent {
    background: rgba(255, 255, 255, 0.05);
    border-color: var(--color-border);
    color: var(--color-txt-main);
  }
  
  .features-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  
  @media (min-width: 640px) {
    .features-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  
  @media (min-width: 1024px) {
    .features-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }
  }
  
  .cta-section {
    text-align: center;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    padding: 4rem 2rem;
    margin-top: 6rem;
  }
  
  .page-links {
    display: flex;
    gap: 1rem;
    justify-content: center;
    align-items: center;
    margin-top: 4rem;
    margin-bottom: 2rem;
    font-size: 0.75rem;
    font-family: var(--font-mono);
    color: var(--color-txt-dim);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .divider {
    opacity: 0.2;
  }
  
  .link-hover:hover {
    color: var(--color-accent);
  }

  @media (max-width: 640px) {
    .hero-section {
      padding: 2rem 0 4rem;
    }
    
    .cta-section {
      padding: 3rem 1.5rem;
      margin-top: 4rem;
    }
  }
</style>
