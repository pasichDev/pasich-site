---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AppMotion from '../../../components/ui/AppMotion.astro';
import { Icon } from 'astro-icon/components';
import '../../../styles/app-page.css';

// Store and source links. A store whose URL is empty is not shown.
const links = {
  googlePlay: 'https://play.google.com/store/apps/details?id=com.pasich.encly',
  fdroid: 'https://f-droid.org/packages/com.pasich.encly/',
  source: 'https://github.com/pasichDev/Encly',
};
const hasStore = Boolean(links.googlePlay || links.fdroid);

const features = [
  {
    title: 'Encrypted at Rest',
    description: 'Notes live in a SQLCipher (AES-256) database under a random 256-bit key. After you leave the app (15 s by default, adjustable from immediately to 2 minutes) or turn the screen off, the database is closed and the key is wiped from memory.'
  },
  {
    title: 'PIN & Biometrics',
    description: 'A mandatory 6-digit PIN bound to the Android Keystore of your phone, so it can only be guessed on the device, plus optional fingerprint or face unlock (strong biometrics only).'
  },
  {
    title: 'Recovery Phrase',
    description: 'An optional 12-word recovery phrase unlocks your vault if you forget your PIN. Nobody else can recover your notes, not even the developer.'
  },
  {
    title: 'Encrypted Backups',
    description: 'Export notes, tasks and tags to one AES-256-GCM file sealed with your 12 words. Save it wherever you choose and restore it on a new phone.'
  },
  {
    title: 'Tags & Tasks',
    description: 'A block editor with headings, quotes and checklists, tags and search, tasks with priorities next to your notes, and a trash with restore.'
  },
  {
    title: 'Themes & Languages',
    description: 'Five themes (Paper, Forest, Ocean, Graphite, Midnight) in light, dark or system mode, and 9 languages you can pick for Encly alone.'
  }
];

const screens = [
  { src: '/assets/apps/encly/screen-1.webp', alt: 'Encly notes list: private notes, encrypted on your phone' },
  { src: '/assets/apps/encly/screen-2.webp', alt: 'Encly lock screen: locked with a PIN or your fingerprint' },
  { src: '/assets/apps/encly/screen-5.webp', alt: 'Encly recovery phrase: a 12-word phrase only you hold' },
  { src: '/assets/apps/encly/screen-6.webp', alt: 'Encly restore screen: encrypted backups you keep yourself' }
];

const structuredData = {
  "@context": "https://schema.org",
  "@type": "MobileApplication",
  "name": "Encly",
  "alternateName": "Encly: Encrypted Offline Notes",
  "description": "Offline, encrypted notes and tasks for Android with a PIN lock. No account, no internet permission, no ads, no tracking.",
  "applicationCategory": "NoteTakingApplication",
  "operatingSystem": "Android 8.0+",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "isAccessibleForFree": true,
  "license": "https://www.apache.org/licenses/LICENSE-2.0",
  "author": {
    "@type": "Person",
    "name": "pasichDev"
  },
  "publisher": {
    "@type": "Person",
    "name": "pasichDev"
  },
  "inLanguage": "en",
  "image": "https://pasichdev.xyz/assets/apps/encly/encly-og.png",
  "url": "https://pasichdev.xyz/apps/encly/",
  "downloadUrl": "https://f-droid.org/packages/com.pasich.encly/",
  "featureList": [
    "Encrypted SQLCipher database",
    "PIN lock with optional biometrics",
    "12-word recovery phrase",
    "Encrypted backup export and import",
    "Tags and tasks with priorities",
    "5 themes, 9 languages",
    "No internet permission"
  ]
};
---

<BaseLayout
  title="Encly – Encrypted Offline Notes & Tasks for Android"
  description="Encly keeps your notes and tasks encrypted on your phone. PIN lock, optional biometrics, 12-word recovery phrase, encrypted backups. No account, no ads, no internet permission."
  canonical="https://pasichdev.xyz/apps/encly/"
  ogImage="/assets/apps/encly/encly-og.png"
  structuredData={structuredData}
  bleed
>
  <div class="app app--encly">

    <header class="app-hero" data-parallax>
      <div class="app-hero__copy">
        <div>
          <nav class="app-hero__crumbs mono up" aria-label="Breadcrumbs"><a href="/">pasichdev</a><a href="/#work">Work</a><span>Encly</span></nav>
          <img class="app-hero__icon" src="/assets/apps/encly/encly-icon.webp" alt="Encly logo" width="96" height="96" />
          <h1>
            <span class="app-hero__name wide" data-scramble>Encly</span>
            <span class="app-hero__tagline">Encrypted notes that never leave your phone</span>
          </h1>
          <p class="app-hero__lede">
            Offline, encrypted notes and tasks for Android, locked with a PIN.
            No account, no cloud, no ads, no tracking, and no internet permission at all.
          </p>
        </div>
        <div class="app-hero__foot">
          <div class="app-chips">
            <span class="app-chip">Encrypted</span>
            <span class="app-chip">Offline</span>
            <span class="app-chip">Open Source</span>
            <span class="app-chip">Android</span>
          </div>
          {hasStore && (
            <div class="app-cta-row">
              {links.googlePlay && <a class="app-btn" href={links.googlePlay} target="_blank" rel="noopener noreferrer"><Icon name="mdi:google-play" />Google Play</a>}
              {links.fdroid && <a class="app-btn app-btn--ghost" href={links.fdroid} target="_blank" rel="noopener noreferrer"><Icon name="mdi:android" />F-Droid</a>}
            </div>
          )}
        </div>
      </div>
      <div class="app-hero__visual" aria-hidden="true">
        <img decoding="async" class="app-shot" data-speed="-0.06" src="/assets/apps/encly/screen-2.webp" alt="" width="540" height="960" style="left:4%;top:16%" />
        <img fetchpriority="high" decoding="async" class="app-shot" data-speed="0.08" src="/assets/apps/encly/screen-1.webp" alt="" width="540" height="960" style="left:32%;top:4%;z-index:2" />
        <img decoding="async" class="app-shot" data-speed="-0.12" src="/assets/apps/encly/screen-5.webp" alt="" width="540" height="960" style="left:60%;top:24%" />
      </div>
    </header>

    <section id="features" class="app-sec">
      <div class="sec-head"><h2 class="wide">Main Features</h2><span class="app-count mono up">01 — 06</span></div>
      {features.map((f, i) => (
        <article class="feat reveal">
          <span class="feat__n mono up">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="feat__title">{f.title}</h3>
          <div class="feat__body"><p>{f.description}</p></div>
        </article>
      ))}
    </section>

    <section id="screens" class="app-sec">
      <div class="sec-head"><h2 class="wide">App Screens</h2><span class="app-count mono up">01 — 04</span></div>
      <div class="screens">
        {screens.map((screen) => (
          <figure class="screen reveal">
            <img src={screen.src} alt={screen.alt} width="540" height="960" loading="lazy" decoding="async" />
          </figure>
        ))}
      </div>
    </section>

    <section class="app-cta">
      <h2 class="wide">Notes that stay yours</h2>
      <p>Free and open source (Apache-2.0). Works without Google Play Services on Android 8.0 or newer.</p>
      {hasStore ? (
        <div class="app-cta-row">
          {links.googlePlay && (
            <a href={links.googlePlay} target="_blank" rel="noopener noreferrer" class="app-btn">
              <Icon name="mdi:google-play" />
              Get it on Google Play
            </a>
          )}
          {links.fdroid && (
            <a href={links.fdroid} target="_blank" rel="noopener noreferrer" class="app-btn app-btn--ghost">
              <Icon name="mdi:android" />
              Get it on F-Droid
            </a>
          )}
        </div>
      ) : (
        <span class="app-chip">Coming soon to Google Play and F-Droid</span>
      )}
    </section>

    <nav class="app-links mono up" aria-label="Encly links">
      <a href="/apps/encly/privacy-policy/">Privacy Policy →</a>
      {links.source && <a href={links.source} target="_blank" rel="noopener noreferrer">GitHub ↗</a>}
    </nav>
  </div>
  <AppMotion />
</BaseLayout>

<style>
  .app--encly {
    --brand: #9a4524;
    --brand-ink: #f4e8da;
    --brand-accent: #f0a27a;
  }
</style>
