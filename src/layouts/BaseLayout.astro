---
export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogType?: string;
  ogImage?: string;
  noIndex?: boolean;
  hideNav?: boolean;
  hideFooter?: boolean;
  structuredData?: object;
}

const {
  title,
  description,
  canonical = Astro.url.href,
  ogType = 'website',
  ogImage = '/assets/web-app-manifest-512x512.png',
  noIndex = false,
  hideNav = false,
  hideFooter = false,
  structuredData
} = Astro.props;

const siteName = 'pasichDev';
const fullTitle = title.includes('pasichDev') ? title : `${title} | ${siteName}`;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  
  <!-- Primary Meta Tags -->
  <title>{fullTitle}</title>
  <meta name="title" content={fullTitle}>
  <meta name="description" content={description}>
  <meta name="author" content="Andrii Pasichnyk">
  <meta name="robots" content={noIndex ? 'noindex, nofollow' : 'index, follow'}>
  <link rel="canonical" href={canonical}>
  
  <!-- Open Graph / Facebook -->
  <meta property="og:type" content={ogType}>
  <meta property="og:url" content={canonical}>
  <meta property="og:title" content={fullTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:site_name" content={siteName}>
  <meta property="og:locale" content="en_US">
  
  <!-- Twitter -->
  <meta property="twitter:card" content="summary_large_image">
  <meta property="twitter:url" content={canonical}>
  <meta property="twitter:title" content={fullTitle}>
  <meta property="twitter:description" content={description}>
  <meta property="twitter:image" content={ogImage}>
  
  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">
  <link rel="icon" type="image/png" sizes="96x96" href="/assets/favicon-96x96.png">
  <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png">
  <link rel="manifest" href="/assets/site.webmanifest">
  
  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  
  <!-- Iconify -->
  <script src="https://code.iconify.design/iconify-icon/1.0.7/iconify-icon.min.js" is:inline></script>
  
  <!-- Structured Data -->
  {structuredData && (
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  )}
  
  <!-- Global Styles -->
  <style is:global>
    @import '../styles/global.css';
  </style>
</head>
<body class="antialiased">
  <!-- Background Grid -->
  <div class="bg-grid"></div>
  
  <!-- Navigation -->
  {!hideNav && (
    <nav class="glass no-print" style="position: fixed; top: 0; width: 100%; z-index: 50; border-bottom: 1px solid var(--color-border);">
      <div class="container flex items-center justify-between" style="height: var(--nav-height);">
        <a href="/" class="flex items-center gap-2" style="text-decoration: none;">
          <div style="width: 24px; height: 24px; background: white; color: black; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 12px; border-radius: 2px; transition: transform 0.3s;">P</div>
          <span class="font-medium text-sm tracking-tight">pasichDev</span>
        </a>
        
        <div class="flex items-center gap-6 text-xs font-medium tracking-wide">
          <a href="/" class="text-dim" style="transition: color 0.15s;">INDEX</a>
          <a href="/cv" class="text-dim" style="transition: color 0.15s;">CV</a>
          <a href="https://github.com/pasichDev" target="_blank" rel="noopener noreferrer" class="flex items-center gap-1 text-dim" style="transition: color 0.15s;">
            GITHUB <iconify-icon icon="solar:arrow-right-up-linear"></iconify-icon>
          </a>
        </div>
      </div>
    </nav>
  )}
  
  <!-- Main Content -->
  <main style={`padding-top: ${hideNav ? '2rem' : 'calc(var(--nav-height) + 2rem)'}; padding-bottom: 5rem; min-height: 100vh;`}>
    <slot />
  </main>
  
  <!-- Footer -->
  {!hideFooter && (
    <footer id="contact" class="no-print" style="border-top: 1px solid var(--color-border); padding: 3rem 0;">
      <div class="container">
        <div class="flex flex-col gap-6" style="flex-direction: column;">
          <div class="flex flex-col gap-4" style="flex-direction: column;">
            <div style="display: flex; flex-direction: column; gap: 1.5rem;">
              <div>
                <h2 class="text-xl font-medium text-accent mb-2">Let's build something.</h2>
                <p class="text-sm text-dim">Available for freelance and full-time opportunities.</p>
              </div>
              <div class="flex gap-4">
                <a href="mailto:apasichnik9@gmail.com" class="btn btn-primary">Email Me</a>
                <a href="https://t.me/pasichdev" target="_blank" rel="noopener noreferrer" class="btn btn-outline">Telegram</a>
              </div>
            </div>
          </div>
          <div class="text-xs text-dim font-mono" style="margin-top: 2rem;">
            © 2026 pasichDev. Ukraine.
          </div>
        </div>
      </div>
    </footer>
  )}
  
  <style>
    nav a.text-dim:hover {
      color: var(--color-accent);
    }
    
    nav a:has(div):hover div {
      transform: rotate(12deg);
    }
    
    @media (min-width: 768px) {
      footer .flex.flex-col {
        flex-direction: row;
        justify-content: space-between;
        align-items: flex-start;
      }
    }
  </style>
</body>
</html>
