---
import { ViewTransitions } from 'astro:transitions';
import { Icon } from 'astro-icon/components';
import '../styles/global.css';
export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogType?: string;
  ogImage?: string;
  noIndex?: boolean;
  hideNav?: boolean;
  hideFooter?: boolean;
  structuredData?: object;
}

const {
  title,
  description,
  canonical = Astro.url.href,
  ogType = 'website',
  ogImage = '/assets/og-default.png',
  noIndex = false,
  hideNav = false,
  hideFooter = false,
  structuredData
} = Astro.props;

const siteName = 'pasichDev';
const fullTitle = title.includes('pasichDev') ? title : `${title} | ${siteName}`;
const ogImageAbs = new URL(ogImage, Astro.site ?? Astro.url).href;

// Site-wide identity for search + AI answer engines (GEO). Page-level
// structuredData overrides this when provided.
const defaultStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Andrii Pasichnyk',
  alternateName: 'pasichDev',
  url: 'https://pasichdev.xyz/',
  jobTitle: 'Software Architect',
  description:
    'Systems and security engineer — Windows services in C++, WireGuard tunneling, Go backends, Android.',
  knowsAbout: [
    'C++', 'Windows Services', 'WireGuard', 'Systems Programming',
    'Application Security', 'Go', 'Android', 'Kotlin', 'Cryptography'
  ],
  sameAs: [
    'https://github.com/pasichDev',
    'https://www.linkedin.com/in/pasichdev/',
    'https://t.me/pasichdev'
  ]
};
const jsonLd = structuredData ?? defaultStructuredData;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  
  <!-- Primary Meta Tags -->
  <title>{fullTitle}</title>
  <meta name="title" content={fullTitle}>
  <meta name="description" content={description}>
  <meta name="author" content="Andrii Pasichnyk">
  <meta name="robots" content={noIndex ? 'noindex, nofollow' : 'index, follow'}>
  <link rel="canonical" href={canonical}>
  
  <!-- Open Graph / Facebook -->
  <meta property="og:type" content={ogType}>
  <meta property="og:url" content={canonical}>
  <meta property="og:title" content={fullTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={ogImageAbs}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content={fullTitle}>
  <meta property="og:site_name" content={siteName}>
  <meta property="og:locale" content="en_US">

  <!-- Twitter -->
  <meta property="twitter:card" content="summary_large_image">
  <meta property="twitter:url" content={canonical}>
  <meta property="twitter:title" content={fullTitle}>
  <meta property="twitter:description" content={description}>
  <meta property="twitter:image" content={ogImageAbs}>
  
  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">
  <link rel="icon" type="image/png" sizes="96x96" href="/assets/favicon-96x96.png">
  <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png">
  <link rel="manifest" href="/assets/site.webmanifest">
  
  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

  <!-- Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  
  <ViewTransitions />
</head>
<body class="antialiased">
  <!-- Background Grid -->
  <div class="bg-grid"></div>
  
  <!-- Navigation -->
  {!hideNav && (
    <nav class="glass no-print" style="position: fixed; top: 0; width: 100%; z-index: 50; border-bottom: 1px solid var(--color-border);">
      <div class="container flex items-center justify-between" style="height: var(--nav-height);">
        <a href="/" class="flex items-center gap-2" style="text-decoration: none;">
          <div style="width: 24px; height: 24px; background: white; color: black; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 12px; border-radius: 2px; transition: transform 0.3s;">P</div>
          <span class="font-medium text-sm tracking-tight">pasichDev</span>
        </a>

        <div class="nav-links flex items-center gap-6 text-xs font-medium tracking-wide">
          <a href="/" class="text-dim nav-link">INDEX</a>
          <a href="/tools" class="text-dim nav-link">TOOLS</a>
          <a href="/#play" class="text-dim nav-link">PLAY</a>
          <a href="/cv" class="text-dim nav-link">CV</a>
          <a href="https://github.com/pasichDev" target="_blank" rel="noopener noreferrer" class="flex items-center gap-1 text-dim nav-link">
            GITHUB <Icon name="solar:arrow-right-up-linear" />
          </a>
        </div>

        <button class="nav-hamburger" id="nav-hamburger" aria-label="Open menu">
          <span></span><span></span><span></span>
        </button>
      </div>
    </nav>
  )}

  <div class="nav-overlay" id="nav-overlay"></div>
  <div class="nav-drawer" id="nav-drawer">
    <div class="nav-drawer-header">
      <span class="nav-drawer-logo">pasichDev</span>
      <button class="nav-drawer-close" id="nav-drawer-close" aria-label="Close menu">
        <Icon name="mdi:close" width="18" height="18" />
      </button>
    </div>
    <div class="nav-drawer-links">
      <a href="/" class="nav-drawer-link">Index</a>
      <a href="/tools" class="nav-drawer-link">Tools</a>
      <a href="/#play" class="nav-drawer-link">Play</a>
      <a href="/cv" class="nav-drawer-link">CV</a>
      <a href="https://github.com/pasichDev" target="_blank" rel="noopener noreferrer" class="nav-drawer-link nav-drawer-ext">
        GitHub <Icon name="solar:arrow-right-up-linear" width="14" height="14" />
      </a>
    </div>
  </div>
  
  <!-- Main Content -->
  <main style={`padding-top: ${hideNav ? '2rem' : 'calc(var(--nav-height) + 2rem)'}; padding-bottom: 5rem; min-height: 100vh;`}>
    <slot />
  </main>
  
  <!-- Footer / Contact -->
  {!hideFooter && (
    <footer id="contact" class="no-print site-footer">
      <div class="container">
        <div class="contact-grid">
        <div class="contact-intro">
          <span class="contact-status"><span class="status-dot"></span>Open to select collaborations &amp; OSS</span>
          <h2 class="contact-title">Have a problem that fights back?</h2>
          <p class="contact-lead">Systems, security, or mobile — if it's low-level and it matters, I want to hear about it. Fastest to reach on Telegram.</p>
        </div>
        <div class="contact-actions">
          <a href="https://t.me/pasichdev" target="_blank" rel="noopener noreferrer" class="contact-cta">
            <Icon name="solar:plain-linear" width="16" height="16" />
            <span>Message me on Telegram</span>
            <Icon name="solar:arrow-right-up-linear" width="14" height="14" class="cta-arrow" />
          </a>
          <div class="contact-links">
            <a href="https://github.com/pasichDev" target="_blank" rel="noopener noreferrer" class="contact-link">
              <Icon name="solar:code-square-linear" width="15" height="15" /> GitHub
            </a>
            <a href="https://www.linkedin.com/in/pasichdev/" target="_blank" rel="noopener noreferrer" class="contact-link">
              <Icon name="mdi:linkedin" width="15" height="15" /> LinkedIn
            </a>
            <a href="mailto:apasichnik9@gmail.com" class="contact-link">
              <Icon name="solar:letter-linear" width="15" height="15" /> Email
            </a>
          </div>
        </div>
        </div>
        <div class="footer-bottom">
          <span class="footer-meta">Ukraine · UTC+2</span>
          <span class="footer-copy">© 2026 pasichDev</span>
        </div>
      </div>
    </footer>
  )}
  
  <style>
    .nav-link:hover { color: var(--color-accent); }
    nav a:has(div):hover div { transform: rotate(12deg); }

    /* ── hamburger ───────────────────────────────── */
    .nav-hamburger {
      display: none;
      flex-direction: column;
      justify-content: center;
      gap: 5px;
      width: 32px;
      height: 32px;
      background: none;
      border: none;
      cursor: pointer;
      padding: 4px;
    }
    .nav-hamburger span {
      display: block;
      width: 100%;
      height: 1px;
      background: var(--color-txt-main);
      transition: opacity 0.2s;
    }
    .nav-hamburger:hover span { background: var(--color-accent); }

    /* ── overlay ─────────────────────────────────── */
    .nav-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.55);
      z-index: 60;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.25s;
    }
    .nav-overlay.is-open { opacity: 1; pointer-events: auto; }

    /* ── drawer ──────────────────────────────────── */
    .nav-drawer {
      display: flex;
      flex-direction: column;
      position: fixed;
      top: 0;
      right: 0;
      bottom: 0;
      width: 260px;
      background: #0d0d0d;
      border-left: 1px solid var(--color-border);
      z-index: 70;
      transform: translateX(100%);
      transition: transform 0.28s cubic-bezier(0.4,0,0.2,1);
    }
    .nav-drawer.is-open { transform: translateX(0); }

    .nav-drawer-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 1.25rem;
      height: var(--nav-height);
      border-bottom: 1px solid var(--color-border);
      flex-shrink: 0;
    }
    .nav-drawer-logo {
      font-family: var(--font-mono);
      font-size: 0.7rem;
      letter-spacing: 0.06em;
      color: var(--color-txt-dim);
      text-transform: uppercase;
    }
    .nav-drawer-close {
      background: none;
      border: none;
      color: var(--color-txt-dim);
      cursor: pointer;
      display: flex;
      align-items: center;
      padding: 4px;
      transition: color 0.15s;
    }
    .nav-drawer-close:hover { color: var(--color-accent); }

    .nav-drawer-links {
      display: flex;
      flex-direction: column;
      padding: 1rem 0;
      flex: 1;
    }
    .nav-drawer-link {
      display: flex;
      align-items: center;
      gap: 0.375rem;
      padding: 0.875rem 1.25rem;
      font-family: var(--font-mono);
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--color-txt-dim);
      text-decoration: none;
      border-bottom: 1px solid var(--color-border);
      transition: color 0.15s, background 0.15s;
    }
    .nav-drawer-link:last-child { border-bottom: none; }
    .nav-drawer-link:hover { color: var(--color-accent); background: rgba(255,255,255,0.02); }
    .nav-drawer-ext { margin-top: auto; }

    @media (max-width: 640px) {
      .nav-links     { display: none; }
      .nav-hamburger { display: flex; }
    }

    .site-footer {
      border-top: 1px solid var(--color-border);
      padding: clamp(2rem, 5vw, 3.5rem) 0 clamp(1.5rem, 4vw, 2.5rem);
    }
    .contact-grid {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 2rem 3rem;
      flex-wrap: wrap;
      margin-bottom: 2rem;
    }
    .contact-intro { max-width: 36rem; }
    .contact-status {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      font-family: var(--font-mono);
      font-size: 0.6rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--color-txt-dim);
      border: 1px solid var(--color-border);
      border-radius: 999px;
      padding: 0.28rem 0.7rem;
      margin-bottom: 1.15rem;
    }
    .status-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #3ecf6b;
      box-shadow: 0 0 0 0 rgba(62,207,107,0.5);
      animation: status-pulse 2.4s infinite;
    }
    @keyframes status-pulse {
      0%   { box-shadow: 0 0 0 0 rgba(62,207,107,0.45); }
      70%  { box-shadow: 0 0 0 6px rgba(62,207,107,0); }
      100% { box-shadow: 0 0 0 0 rgba(62,207,107,0); }
    }
    @media (prefers-reduced-motion: reduce) { .status-dot { animation: none; } }

    .contact-title {
      font-size: clamp(1.35rem, 3.5vw, 2rem);
      font-weight: 600;
      letter-spacing: -0.02em;
      line-height: 1.1;
      margin-bottom: 0.7rem;
    }
    .contact-lead {
      font-size: 0.9rem;
      line-height: 1.6;
      color: var(--color-txt-dim);
      max-width: 34rem;
    }

    .contact-actions {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 1.15rem;
      padding-top: 0.35rem;
    }
    .contact-cta {
      display: inline-flex;
      align-items: center;
      gap: 0.55rem;
      background: #fff;
      color: #000;
      font-size: 0.82rem;
      font-weight: 500;
      padding: 0.7rem 1.1rem;
      border-radius: 2px;
      text-decoration: none;
      transition: transform 0.15s, opacity 0.15s;
    }
    .contact-cta:hover { transform: translateY(-1px); opacity: 0.88; }
    .cta-arrow { opacity: 0.6; }

    .contact-links {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 1.4rem;
    }
    .contact-link {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      font-size: 0.8rem;
      color: var(--color-txt-dim);
      text-decoration: none;
      transition: color 0.15s;
    }
    .contact-link:hover { color: var(--color-txt-main); }
    @media (max-width: 480px) {
      .contact-actions { align-items: flex-start; flex-direction: column; gap: 1.1rem; }
      .contact-cta { width: 100%; justify-content: center; }
    }

    .footer-bottom {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      padding-top: 1.25rem;
      border-top: 1px solid var(--color-border);
    }
    .footer-meta {
      font-family: var(--font-mono);
      font-size: 0.6rem;
      color: var(--color-txt-dim);
      letter-spacing: 0.04em;
    }
    .footer-copy {
      font-family: var(--font-mono);
      font-size: 0.6rem;
      color: #2a2a2a;
      letter-spacing: 0.04em;
    }
  </style>

  <script>
    function initDrawer() {
      const hamburger = document.getElementById('nav-hamburger');
      const drawer    = document.getElementById('nav-drawer');
      const overlay   = document.getElementById('nav-overlay');
      const closeBtn  = document.getElementById('nav-drawer-close');
      if (!hamburger || !drawer) return;

      function open() {
        drawer.classList.add('is-open');
        overlay?.classList.add('is-open');
        document.body.style.overflow = 'hidden';
      }
      function close() {
        drawer.classList.remove('is-open');
        overlay?.classList.remove('is-open');
        document.body.style.overflow = '';
      }

      hamburger.addEventListener('click', open);
      closeBtn?.addEventListener('click', close);
      overlay?.addEventListener('click', close);
      drawer.querySelectorAll('a').forEach(a => a.addEventListener('click', close));
    }

    document.addEventListener('astro:page-load', initDrawer);
  </script>
</body>
</html>
