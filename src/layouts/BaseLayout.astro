---
import { ViewTransitions } from 'astro:transitions';
import '../styles/global.css';
export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogType?: string;
  ogImage?: string;
  noIndex?: boolean;
  hideNav?: boolean;
  hideFooter?: boolean;
  /** Page draws its own top spacing (full-bleed hero); otherwise content clears the nav. */
  bleed?: boolean;
  structuredData?: object;
}

const {
  title,
  description,
  canonical = Astro.url.href,
  ogType = 'website',
  ogImage = '/assets/og-default.png',
  noIndex = false,
  hideNav = false,
  hideFooter = false,
  bleed = false,
  structuredData
} = Astro.props;

const path = Astro.url.pathname;
const isActive = (href: string) => href === '/' ? path === '/' : path.startsWith(href);
const navLinks = [
  { href: '/#work', label: 'Work', match: '/apps' },
  { href: '/cv', label: 'CV', match: '/cv' },
  { href: '/tools', label: 'Tools', match: '/tools' },
  { href: '/links', label: 'Links', match: '/links' },
];

const siteName = 'pasichDev';
const fullTitle = title.includes('pasichDev') ? title : `${title} | ${siteName}`;
const ogImageAbs = new URL(ogImage, Astro.site ?? Astro.url).href;

// Site-wide identity for search + AI answer engines (GEO). Page-level
// structuredData overrides this when provided.
const defaultStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Andrii Pasichnyk',
  alternateName: 'pasichDev',
  url: 'https://pasichdev.xyz/',
  jobTitle: 'Software Engineer',
  description:
    'Systems and security engineer — Windows services in C++, WireGuard tunneling, Go backends, Android.',
  knowsAbout: [
    'C++', 'Windows Services', 'WireGuard', 'Systems Programming',
    'Application Security', 'Go', 'Android', 'Kotlin', 'Cryptography'
  ],
  sameAs: [
    'https://github.com/pasichDev',
    'https://www.linkedin.com/in/pasichdev/',
    'https://t.me/pasichdev'
  ]
};
const jsonLd = structuredData ?? defaultStructuredData;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  
  <!-- Primary Meta Tags -->
  <title>{fullTitle}</title>
  <meta name="title" content={fullTitle}>
  <meta name="description" content={description}>
  <meta name="author" content="Andrii Pasichnyk">
  <meta name="robots" content={noIndex ? 'noindex, nofollow' : 'index, follow'}>
  <link rel="canonical" href={canonical}>
  
  <!-- Open Graph / Facebook -->
  <meta property="og:type" content={ogType}>
  <meta property="og:url" content={canonical}>
  <meta property="og:title" content={fullTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={ogImageAbs}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content={fullTitle}>
  <meta property="og:site_name" content={siteName}>
  <meta property="og:locale" content="en_US">

  <!-- Twitter -->
  <meta property="twitter:card" content="summary_large_image">
  <meta property="twitter:url" content={canonical}>
  <meta property="twitter:title" content={fullTitle}>
  <meta property="twitter:description" content={description}>
  <meta property="twitter:image" content={ogImageAbs}>
  
  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">
  <link rel="icon" type="image/png" sizes="96x96" href="/assets/favicon-96x96.png">
  <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png">
  <link rel="manifest" href="/assets/site.webmanifest">
  
  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">

  <!-- Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  
  <ViewTransitions />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <div class="cursor no-print" aria-hidden="true" data-cursor transition:persist></div>

  {!hideNav && (
    <header class="nav no-print" data-nav>
      <a href="/" class="nav__home mono up" aria-label="pasichDev — home">pasichdev<span class="amber">.</span>xyz</a>
      <nav class="nav__links mono up" aria-label="Main">
        {navLinks.map((l) => (
          <a href={l.href} class:list={[{ 'is-active': isActive(l.match) }]} aria-current={isActive(l.match) ? 'page' : undefined}>{l.label}</a>
        ))}
        <a href="https://github.com/pasichDev" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
      </nav>
      <button class="nav__menu mono up" type="button" aria-expanded="false" aria-controls="menu" data-menu-open>Menu</button>
    </header>
  )}

  <div class="menu no-print" id="menu" role="dialog" aria-modal="true" aria-label="Menu" data-menu hidden>
    <div class="menu__top">
      <span class="mono up dim">pasichdev<span class="amber">.</span>xyz</span>
      <button class="mono up" type="button" data-menu-close>Close ✕</button>
    </div>
    <nav class="menu__links" aria-label="Main">
      <a class="wide" href="/">Index</a>
      {navLinks.map((l) => <a class="wide" href={l.href}>{l.label}</a>)}
      <a class="wide" href="#contact">Contact</a>
    </nav>
    <div class="menu__foot mono up dim"><span>Rivne · UTC+2</span><a href="https://github.com/pasichDev" target="_blank" rel="noopener noreferrer">GitHub ↗</a></div>
  </div>

  <main id="main" class:list={['site-main', { 'site-main--pad': !bleed && !hideNav }]}>
    <slot />
  </main>

  {!hideFooter && (
    <footer id="contact" class="foot no-print">
      <span class="mono up amber">Low-level and it matters?</span>
      <a class="foot__big" href="https://t.me/pasichdev" target="_blank" rel="noopener noreferrer" data-stretch>Open a tunnel</a>
      <p class="foot__lede">Systems, security or mobile. Fastest on Telegram — I usually answer the same day.</p>
      <div class="foot__links mono up">
        <a href="https://t.me/pasichdev" target="_blank" rel="noopener noreferrer">Fastest<b>Telegram</b></a>
        <a href="https://github.com/pasichDev" target="_blank" rel="noopener noreferrer">Code<b>GitHub</b></a>
        <a href="https://www.linkedin.com/in/pasichdev/" target="_blank" rel="noopener noreferrer">Work<b>LinkedIn</b></a>
        <a href="mailto:apasichnik9@gmail.com">Long form<b>Email</b></a>
      </div>
      <div class="foot__bottom mono up dim"><span>© 2026 pasichDev</span><span>Rivne, Ukraine · UTC+2</span><span>Encrypted by default</span></div>
    </footer>
  )}

  <style is:global>
    .skip { position: fixed; left: 12px; top: -60px; z-index: 200; padding: 10px 14px; background: var(--color-accent); color: var(--color-accent-ink); font: 500 12px var(--font-mono); }
    .skip:focus { top: 12px; }
    .scr-live { position: absolute; left: 0; top: 0; white-space: nowrap; pointer-events: none; }
    .cursor { will-change: transform; }

    /* ── Navigation ─────────────────────────────── */
    .nav { position: fixed; inset: 0 0 auto; z-index: 60; display: flex; align-items: center; justify-content: space-between; height: var(--nav-height); padding: 0 var(--pad); transition: background .4s, backdrop-filter .4s, border-color .4s; border-bottom: 1px solid transparent; }
    .nav.is-scrolled { background: rgba(9, 9, 10, .72); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); border-bottom-color: var(--color-border); }
    .nav__home { color: var(--color-txt-main); }
    .nav__links { display: flex; gap: 28px; }
    .nav__links a { position: relative; color: var(--color-txt-dim); transition: color .25s; }
    .nav__links a::before, .nav__links a::after { position: absolute; top: 0; color: var(--color-accent); opacity: 0; transition: opacity .25s, transform .35s var(--ease); }
    .nav__links a::before { content: '['; left: -10px; transform: translateX(4px); }
    .nav__links a::after { content: ']'; right: -10px; transform: translateX(-4px); }
    .nav__links a:hover, .nav__links a.is-active { color: var(--color-txt-main); }
    .nav__links a:hover::before, .nav__links a:hover::after, .nav__links a.is-active::before, .nav__links a.is-active::after { opacity: 1; transform: none; }
    .nav__menu { display: none; height: 38px; padding: 0 16px; border: 1px solid var(--color-border-strong); border-radius: 99px; background: none; color: var(--color-txt-main); cursor: pointer; }

    .menu { position: fixed; inset: 0; z-index: 90; display: grid; grid-template-rows: auto 1fr auto; padding: 18px var(--pad) 28px; background: var(--color-bg); }
    .menu[hidden] { display: none; }
    .menu__top { display: flex; justify-content: space-between; align-items: center; height: 40px; }
    .menu__top button { height: 38px; padding: 0 16px; border: 1px solid var(--color-border-strong); border-radius: 99px; background: none; color: var(--color-txt-main); cursor: pointer; }
    .menu__links { display: grid; align-content: center; gap: 6px; }
    .menu__links a { font-size: clamp(34px, 11vw, 64px); font-weight: 800; line-height: 1; opacity: 0; transform: translateY(20px); animation: menuIn .6s var(--ease) forwards; }
    .menu__links a:nth-child(2) { animation-delay: .05s; } .menu__links a:nth-child(3) { animation-delay: .1s; } .menu__links a:nth-child(4) { animation-delay: .15s; } .menu__links a:nth-child(5) { animation-delay: .2s; } .menu__links a:nth-child(6) { animation-delay: .25s; }
    @keyframes menuIn { to { opacity: 1; transform: none; } }
    .menu__foot { display: flex; justify-content: space-between; }

    .site-main { display: block; min-height: 60vh; }
    .site-main--pad { padding-top: calc(var(--nav-height) + 2rem); padding-bottom: 5rem; }

    /* ── Footer ─────────────────────────────────── */
    .foot { padding: clamp(110px, 14vw, 200px) var(--pad) 28px; border-top: 1px solid var(--color-border); }
    .foot__big { display: block; margin-top: 18px; font-size: clamp(46px, 10vw, 190px); font-weight: 900; line-height: .86; letter-spacing: -.01em; text-transform: uppercase; }
    .foot__big span { display: inline-block; font-variation-settings: 'wdth' var(--w, 80); font-stretch: calc(var(--w, 80) * 1%); transition: color .3s; }
    .foot__big:hover span { color: var(--color-accent); }
    .foot__lede { max-width: 44ch; margin-top: 26px; font-size: 17px; }
    .foot__links { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-top: clamp(50px, 6vw, 80px); border-top: 1px solid var(--color-border); }
    .foot__links a { padding-top: 14px; color: var(--color-txt-dim); }
    .foot__links b { display: block; margin-top: 6px; font: 600 24px/1 var(--font-sans); letter-spacing: 0; text-transform: none; color: var(--color-txt-main); transition: color .25s; }
    .foot__links a:hover b { color: var(--color-accent); }
    .foot__bottom { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 10px 24px; margin-top: 70px; }

    /* ── Cursor ─────────────────────────────────── */
    .cursor { position: fixed; z-index: 300; left: 0; top: 0; width: 8px; height: 8px; margin: -4px 0 0 -4px; background: var(--color-accent); pointer-events: none; opacity: 0; transition: width .3s var(--ease), height .3s var(--ease), margin .3s var(--ease), background .3s, opacity .3s; }
    .cursor.is-on { opacity: 1; }
    .cursor.is-big { width: 40px; height: 40px; margin: -20px 0 0 -20px; background: transparent; outline: 1px solid var(--color-accent); }
    @media (hover: none), (pointer: coarse) { .cursor { display: none; } }

    @media (max-width: 860px) {
      .nav__links { display: none; }
      .nav__menu { display: inline-flex; align-items: center; }
      .foot__links { grid-template-columns: 1fr 1fr; }
    }
  </style>

  <script>
    // One script for the whole site. Astro's client router keeps this module
    // alive between pages, so everything page-bound is (re)attached on
    // astro:page-load and torn down on astro:before-swap.
    const reduce = () => matchMedia('(prefers-reduced-motion: reduce)').matches;
    const GLYPHS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789#%&*+=<>/\\';
    let cleanups: Array<() => void> = [];
    const onCleanup = (fn: () => void) => cleanups.push(fn);

    /** Random glyphs settle into the real text, left to right.
        The text only changes on ~11 Hz ticks and is written only when it
        differs, so a decode costs ~11 layouts a second instead of 60.
        Block-level elements (the big names) keep their real text in the
        layout and draw the noise in an overlay: wide glyphs vary in width,
        and a right-aligned word would otherwise slide around while decoding. */
    function scramble(el: HTMLElement, dur = 1800, delay = 0) {
      const final = el.dataset.final ?? (el.dataset.final = el.textContent ?? '');
      if (reduce()) { el.textContent = final; return; }
      const n = final.length;
      const settleAt = Array.from({ length: n }, (_, i) => (i / Math.max(1, n)) * 0.75 + Math.random() * 0.25);
      const glyphs = Array.from({ length: n }, () => GLYPHS[(Math.random() * GLYPHS.length) | 0]);
      const TICK_MS = 90;

      let target: HTMLElement = el, done = () => { el.textContent = final; };
      if (getComputedStyle(el).display !== 'inline') {
        const ghost = document.createElement('span');
        const live = document.createElement('span');
        ghost.textContent = final;
        ghost.style.visibility = 'hidden';
        live.setAttribute('aria-hidden', 'true');
        live.className = 'scr-live';
        if (getComputedStyle(el).position === 'static') el.style.position = 'relative';
        el.replaceChildren(ghost, live);
        target = live;
        done = () => { el.textContent = final; };
      }

      const t0 = performance.now() + delay;
      let lastTick = -Infinity, prev = '', raf = 0;
      const frame = (t: number) => {
        if (t - lastTick >= TICK_MS) {
          lastTick = t;
          const k = Math.max(0, Math.min(1, (t - t0) / dur));
          for (let i = 0; i < n; i++) if (Math.random() < 0.6) glyphs[i] = GLYPHS[(Math.random() * GLYPHS.length) | 0];
          let out = '';
          for (let i = 0; i < n; i++) out += k >= settleAt[i] || final[i] === ' ' ? final[i] : glyphs[i];
          if (out !== prev) { target.textContent = out; prev = out; }
          if (k >= 1) { done(); return; }
        }
        raf = requestAnimationFrame(frame);
      };
      raf = requestAnimationFrame(frame);
      onCleanup(() => { cancelAnimationFrame(raf); done(); });
    }
    (window as any).__scramble = scramble;

    function whenVisible(el: Element, fn: () => void, threshold = 0.3) {
      const io = new IntersectionObserver((entries) => entries.forEach((e) => { if (e.isIntersecting) { io.disconnect(); fn(); } }), { threshold });
      io.observe(el);
      onCleanup(() => io.disconnect());
    }

    function initPage() {
      // Nav background after the first screenful
      const nav = document.querySelector<HTMLElement>('[data-nav]');
      const onScroll = () => nav?.classList.toggle('is-scrolled', scrollY > 40);
      onScroll();
      addEventListener('scroll', onScroll, { passive: true });
      onCleanup(() => removeEventListener('scroll', onScroll));

      // Reveal on scroll
      document.querySelectorAll('.reveal').forEach((el, i) => {
        (el as HTMLElement).style.transitionDelay = `${(i % 4) * 0.07}s`;
        whenVisible(el, () => el.classList.add('in'), 0.15);
      });

      // Scramble: on load, or when scrolled into view
      document.querySelectorAll<HTMLElement>('[data-scramble]').forEach((el, i) => {
        if (el.dataset.scramble === 'view') whenVisible(el, () => scramble(el, 1500));
        else scramble(el, 2000, 200 + i * 300);
      });

      // Count up
      document.querySelectorAll<HTMLElement>('[data-num]').forEach((b) => whenVisible(b, () => {
        const to = Number(b.dataset.num), suf = b.dataset.suffix ?? '', t0 = performance.now();
        if (reduce()) { b.textContent = to + suf; return; }
        const f = (t: number) => { const k = Math.min(1, (t - t0) / 1200); b.textContent = Math.round(to * (1 - Math.pow(1 - k, 3))) + suf; if (k < 1) requestAnimationFrame(f); };
        requestAnimationFrame(f);
      }, 0.5));

      // Letters widen near the pointer (Archivo's width axis). Letter centres
      // are measured once when the pointer enters, so the loop only writes.
      document.querySelectorAll<HTMLElement>('[data-stretch]').forEach((big) => {
        if (!big.dataset.split) {
          big.dataset.split = '1';
          big.innerHTML = [...(big.textContent ?? '')].map((c) => (c === ' ' ? ' ' : `<span>${c}</span>`)).join('');
        }
        const letters = [...big.querySelectorAll<HTMLElement>('span')];
        let centers: number[] = [], applied: number[] = [], lx = -9999, raf = 0;
        const paint = () => {
          raf = 0;
          letters.forEach((s, i) => {
            const w = Math.round(62 + 63 * Math.max(0, 1 - Math.abs(centers[i] - lx) / 260));
            if (w !== applied[i]) { applied[i] = w; s.style.setProperty('--w', String(w)); }
          });
        };
        const enter = () => { centers = letters.map((s) => { const b = s.getBoundingClientRect(); return b.left + b.width / 2; }); };
        const move = (e: PointerEvent) => { lx = e.clientX; if (!centers.length) enter(); if (!raf) raf = requestAnimationFrame(paint); };
        const leave = () => { lx = -9999; centers = centers.length ? centers : []; if (!raf) raf = requestAnimationFrame(paint); };
        big.addEventListener('pointerenter', enter);
        big.addEventListener('pointermove', move);
        big.addEventListener('pointerleave', leave);
        onCleanup(() => { cancelAnimationFrame(raf); big.removeEventListener('pointerenter', enter); big.removeEventListener('pointermove', move); big.removeEventListener('pointerleave', leave); });
      });

      // Mobile menu
      const menu = document.querySelector<HTMLElement>('[data-menu]');
      const openBtn = document.querySelector<HTMLElement>('[data-menu-open]');
      const closeBtn = document.querySelector<HTMLElement>('[data-menu-close]');
      if (menu && openBtn && closeBtn) {
        const set = (open: boolean) => {
          menu.hidden = !open;
          openBtn.setAttribute('aria-expanded', String(open));
          document.documentElement.style.overflow = open ? 'hidden' : '';
          (open ? closeBtn : openBtn).focus();
        };
        const open = () => set(true), close = () => set(false);
        const esc = (e: KeyboardEvent) => { if (e.key === 'Escape' && !menu.hidden) close(); };
        openBtn.addEventListener('click', open);
        closeBtn.addEventListener('click', close);
        menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => { menu.hidden = true; document.documentElement.style.overflow = ''; }));
        addEventListener('keydown', esc);
        onCleanup(() => { removeEventListener('keydown', esc); document.documentElement.style.overflow = ''; });
      }

      // Cursor grows over anything clickable
      const cur = document.querySelector<HTMLElement>('[data-cursor]');
      if (cur) {
        const over = (e: Event) => { if ((e.target as Element).closest?.('a, button, [role="button"], input, select, textarea, label')) cur.classList.add('is-big'); };
        const out = (e: Event) => { if ((e.target as Element).closest?.('a, button, [role="button"], input, select, textarea, label')) cur.classList.remove('is-big'); };
        document.addEventListener('pointerover', over);
        document.addEventListener('pointerout', out);
        onCleanup(() => { document.removeEventListener('pointerover', over); document.removeEventListener('pointerout', out); cur.classList.remove('is-big'); });
      }
    }

    // The cursor follows the pointer for the whole session, not per page.
    const cursor = document.querySelector<HTMLElement>('[data-cursor]');
    if (cursor && matchMedia('(hover: hover) and (pointer: fine)').matches) {
      let mx = 0, my = 0, cx = 0, cy = 0, raf = 0;
      // Runs only while the cursor is catching up with the pointer.
      const follow = () => {
        cx += (mx - cx) * 0.3; cy += (my - cy) * 0.3;
        if (Math.abs(mx - cx) < 0.1 && Math.abs(my - cy) < 0.1) { cx = mx; cy = my; raf = 0; }
        else raf = requestAnimationFrame(follow);
        cursor.style.transform = `translate3d(${cx}px, ${cy}px, 0)`;
      };
      addEventListener('pointermove', (e) => { mx = e.clientX; my = e.clientY; cursor.classList.add('is-on'); if (!raf) raf = requestAnimationFrame(follow); }, { passive: true });
      document.addEventListener('pointerleave', () => cursor.classList.remove('is-on'));
    }

    document.addEventListener('astro:page-load', initPage);
    document.addEventListener('astro:before-swap', () => { cleanups.forEach((fn) => fn()); cleanups = []; });
  </script>
</body>
</html>
